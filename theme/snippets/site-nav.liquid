{% doc %}
  Desktop navigation (behavior: @ui/nav-menu). Two kinds of dropdown:
  - regular dropdown: a top-level link with children only
  - mega menu: a top-level link whose children have their own links (3rd level), or one that a
    "Menu promo" / "Menu products" block targets by title. Children become columns.

  @param {object} menu - link_list
  @param {object[]} blocks - header section blocks (menu_promo, menu_products)
{% enddoc %}
<nav-menu class="site-nav">
  <nav aria-label="{{ menu.title | escape }}">
    <ul class="site-nav__list" role="list">
      {%- for link in menu.links -%}
        {%- liquid
          assign link_handle = link.title | handleize
          assign has_grandchildren = false
          for child in link.links
            if child.links.size > 0
              assign has_grandchildren = true
              break
            endif
          endfor
          assign has_blocks = false
          for block in blocks
            assign target = block.settings.menu_item | handleize
            if target == link_handle
              assign has_blocks = true
              break
            endif
          endfor
          assign is_mega = false
          if has_grandchildren or has_blocks
            assign is_mega = true
          endif
        -%}
        <li class="site-nav__item{% if is_mega %} site-nav__item--mega{% endif %}">
          {%- if link.links.size > 0 or has_blocks -%}
            <details class="site-nav__details" data-menu-item>
              <summary class="site-nav__link{% if link.active or link.child_active %} is-active{% endif %}">
                {{- link.title | escape -}}
                {%- render 'icon', name: 'chevron-down' -%}
              </summary>

              {%- if is_mega -%}
                <div class="mega-menu">
                  <div class="mega-menu__inner page-width">
                    <ul class="mega-menu__columns" role="list">
                      {%- for child in link.links -%}
                        <li class="mega-menu__column">
                          <a href="{{ child.url }}" class="eyebrow mega-menu__heading{% if child.active %} is-active{% endif %}">
                            {{- child.title | escape -}}
                          </a>
                          {%- if child.links.size > 0 -%}
                            <ul class="link-list" role="list">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a
                                    href="{{ grandchild.url }}"
                                    class="link-list__link"
                                    {% if grandchild.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{- grandchild.title | escape -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>

                    {%- if has_blocks -%}
                      <div class="mega-menu__extras">
                        {%- for block in blocks -%}
                          {%- assign target = block.settings.menu_item | handleize -%}
                          {%- if target == link_handle -%}
                            {%- render 'mega-menu-block', block: block -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- else -%}
                <ul class="site-nav__dropdown" role="list">
                  {%- for child in link.links -%}
                    <li>
                      <a
                        href="{{ child.url }}"
                        class="site-nav__sublink"
                        {% if child.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- child.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </details>
          {%- else -%}
            <a
              href="{{ link.url }}"
              class="site-nav__link{% if link.active %} is-active{% endif %}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</nav-menu>
