{% doc %}
  Collection card: cover (the collection image or its first product's), title with an arrow that
  stays with the last word, product count; the whole card is one link. Used by the Collection list
  section and the collections page. Styles: .collection-card in packages/ui/css/sections.css.

  @param {object} collection - Collection
  @param {string} [ratio] - Image shape, e.g. '1' or '4 / 5' (default 1)
  @param {string} [sizes] - Image sizes attribute
{% enddoc %}
{%- liquid
  assign cover = collection.image | default: collection.products.first.featured_image
  assign title_words = collection.title | escape | split: ' '
  assign last_word = title_words | last
  assign first_words = title_words | join: ' ' | remove_last: last_word
-%}
<a href="{{ collection.url }}" class="collection-card">
  <span class="frame collection-card__media" style="--frame-ratio: {{ ratio | default: '1' }};">
    {%- if cover -%}
      {{ cover | image_url: width: 800 | image_tag: loading: 'lazy', sizes: sizes, widths: '400, 600, 800', alt: '' }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag }}
    {%- endif -%}
  </span>
  <span class="collection-card__title">
    {{- first_words -}}
    <span class="collection-card__title-end">
      {{- last_word -}}
      {%- render 'icon', name: 'arrow-right' -%}
    </span>
  </span>
  <span class="collection-card__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
</a>
