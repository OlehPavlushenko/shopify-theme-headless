# Copy to .env.local and fill in. .env.local is git-ignored.

# Store and Admin API token of a custom app (Settings > Apps > Develop apps) with
# read_customers and write_customers scopes
SHOPIFY_STORE_NAME=your-store.myshopify.com
SHOPIFY_ADMIN_API_PASSWORD=shpat_...
SHOPIFY_API_VERSION=2026-10

# Storefront origins allowed to call the API, comma-separated
ALLOWED_ORIGINS=http://127.0.0.1:9292,https://bioharmony.com.ua

# reCAPTCHA v3 secret; leave empty to switch the check off (local development).
# The site key goes into the theme settings.
RECAPTCHA_SECRET=

PORT=5000
