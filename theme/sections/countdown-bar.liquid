{% comment %}
  Countdown bar: one line — heading, offer, "ends in 6d 19h 11m 39s" (<ui-countdown>) and a link,
  optionally over a soft background image. Hidden once the end date has passed: by Liquid on render and
  by the timer itself when it reaches zero. Header group (above or below the header) or any template.
  Styles: packages/ui/css/announcements.css.
{% endcomment %}
{%- capture active -%}
  {%- render 'schedule-active', from: section.settings.show_from, until: section.settings.end -%}
{%- endcapture -%}
{%- if active contains 'true' and section.settings.end != blank -%}
  <div class="countdown-bar color-{{ section.settings.color_scheme }}" data-countdown-section>
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: class: 'countdown-bar__image', loading: 'eager', sizes: '100vw', widths: '750, 1200, 1800, 2400', alt: ''
      }}
    {%- endif -%}
    <div class="countdown-bar__inner page-width">
      {%- if section.settings.heading != blank -%}
        <span class="countdown-bar__heading">{{ section.settings.heading }}</span>
      {%- endif -%}
      {%- if section.settings.offer != blank -%}
        <span class="countdown-bar__offer">{{ section.settings.offer }}</span>
      {%- endif -%}
      {%- render 'countdown', end: section.settings.end -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="countdown-bar__link">
          {{- section.settings.button_label | escape -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.countdown.name",
  "class": "countdown-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "end",
      "label": "t:sections.countdown.end",
      "info": "t:sections.countdown.end_info",
      "default": "2026-12-31 23:59"
    },
    { "type": "text", "id": "show_from", "label": "t:labels.show_from", "info": "t:labels.schedule_info" },
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Seasonal sale" },
    { "type": "inline_richtext", "id": "offer", "label": "t:sections.countdown.offer", "default": "Up to 30% off" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.countdown.image",
      "info": "t:sections.countdown.image_info"
    }
  ],
  "presets": [{ "name": "t:sections.countdown.name" }]
}
{% endschema %}
