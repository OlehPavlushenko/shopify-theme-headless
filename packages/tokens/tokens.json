{
  "$description": "Design tokens (style direction: Studio). Single source of default values. build.mjs turns every leaf into a CSS custom property named after its path (\"DEFAULT\" adds no suffix): color.accent -> --color-accent, ease.DEFAULT -> --ease. The Shopify theme overrides colors, fonts, page width and radii from Theme settings; a headless storefront uses these defaults or its own overrides.",
  "color": {
    "background": "#fbfaf7",
    "background-gradient": "none",
    "foreground": "#3d4440",
    "text-muted": "color-mix(in srgb, var(--color-foreground) 80%, transparent)",
    "text-disabled": "color-mix(in srgb, var(--color-foreground) 45%, transparent)",
    "heading": "#1b2a23",
    "link-hover": "#2f6b4f",
    "accent": "#2f6b4f",
    "accent-2": "#c9772b",
    "surface": "#efeee8",
    "border": "#e1dfd6",
    "button": "#1b2a23",
    "button-label": "#fbfaf7",
    "button-hover": "#2f6b4f",
    "button-label-hover": "#fbfaf7",
    "button-secondary": "#dfe8df",
    "button-secondary-label": "#1b2a23",
    "input-background": "#ffffff",
    "input-text": "#1b2a23",
    "success": "#2f7d4f",
    "info": "#2c5e9e",
    "warning": "#b8742a",
    "danger": "#b3261e",
    "focus": "#2f6b4f"
  },
  "font": {
    "body-family": "'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "body-style": "normal",
    "body-weight": "400",
    "body-weight-bold": "600",
    "heading-family": "'Bricolage Grotesque', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "heading-style": "normal",
    "heading-weight": "700",
    "body-scale": "1",
    "heading-scale": "1",
    "body-weight-medium": "500",
    "body-weight-semibold": "600"
  },
  "text": {
    "xs": "1.2rem",
    "sm": "1.4rem",
    "md": "1.6rem",
    "lg": "1.8rem",
    "xl": "2rem",
    "2xl": "2.4rem",
    "3xl": "3rem",
    "4xl": "3.6rem",
    "5xl": "4.8rem",
    "6xl": "6rem"
  },
  "leading": {
    "xs": "1.6rem",
    "sm": "2rem",
    "md": "2.4rem",
    "lg": "2.8rem",
    "xl": "2.8rem",
    "2xl": "3.2rem",
    "3xl": "3.6rem",
    "4xl": "4rem",
    "tight": "1.1",
    "snug": "1.25",
    "normal": "1.5"
  },
  "tracking": {
    "tight": "-0.025em",
    "normal": "0",
    "wide": "0.06em"
  },
  "page-width": {
    "DEFAULT": "144rem",
    "narrow": "86rem"
  },
  "gutter": {
    "DEFAULT": "clamp(1.6rem, 4vw, 4.8rem)"
  },
  "space": {
    "2xs": "0.4rem",
    "xs": "0.8rem",
    "s": "1.2rem",
    "m": "1.6rem",
    "l": "2.4rem",
    "xl": "3.2rem",
    "2xl": "4.8rem",
    "3xl": "6.4rem",
    "4xl": "9.6rem"
  },
  "control": {
    "height-sm": "3.6rem",
    "height": "4.4rem",
    "height-lg": "4.8rem",
    "toggle": "3.4rem"
  },
  "radius": {
    "button": "40px",
    "input": "12px",
    "card": "20px",
    "media": "20px",
    "badge": "40px",
    "full": "99rem"
  },
  "shadow": {
    "sm": "0 1px 2px rgb(27 42 35 / 0.06), 0 1px 1px rgb(27 42 35 / 0.04)",
    "md": "0 8px 24px rgb(27 42 35 / 0.08)",
    "overlay": "0 24px 64px rgb(27 42 35 / 0.18)"
  },
  "duration": {
    "short": "120ms",
    "default": "220ms",
    "long": "420ms"
  },
  "ease": {
    "DEFAULT": "cubic-bezier(0.2, 0, 0, 1)",
    "out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "weight": {
    "regular": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700"
  },
  "drawer": {
    "width": "min(42rem, 100vw)"
  },
  "backdrop": {
    "color": "rgb(15 23 19 / 0.4)"
  },
  "icon": {
    "$description": "Icon sizes (.svg-icon --icon-size)",
    "sm": "1.4rem"
  },
  "underline-offset": "0.3rem"
}
