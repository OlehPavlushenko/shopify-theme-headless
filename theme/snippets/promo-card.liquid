{% doc %}
  Promo card used across the theme: mega menu, banner grids, popups. The whole card is one link.
  Layouts:
  - stacked: image on top, text under it
  - overlay: text over the image, on a soft shade at the bottom
  Styles: packages/ui/css/promo.css.

  @param {string} url - Link of the card
  @param {object} [image] - Image (placeholder when blank)
  @param {string} [eyebrow] - Small label above the heading
  @param {string} [heading] - Heading
  @param {string} [text] - Short text
  @param {string} [link_label] - Call to action at the bottom, with an arrow
  @param {string} [layout] - 'stacked' (default) | 'overlay'
  @param {string} [ratio] - Image aspect ratio, e.g. '4 / 3' (default), '4 / 5', '16 / 9'
  @param {string} [sizes] - sizes attribute for the image
  @param {string} [attributes] - Extra attributes on the card, e.g. block.shopify_attributes
{% enddoc %}
{%- liquid
  assign card_layout = layout | default: 'stacked'
  assign card_ratio = ratio | default: '4 / 3'
  assign card_sizes = sizes | default: '(min-width: 990px) 33vw, 100vw'
-%}
<a href="{{ url | default: routes.root_url }}" class="promo-card promo-card--{{ card_layout }}" {{ attributes }}>
  <span class="promo-card__media frame" style="--frame-ratio: {{ card_ratio }};">
    {%- if image -%}
      {{
        image
        | image_url: width: 1200
        | image_tag: loading: 'lazy', sizes: card_sizes, widths: '400, 600, 800, 1200', alt: ''
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </span>
  <span class="promo-card__body">
    {%- if eyebrow != blank -%}
      <span class="eyebrow promo-card__eyebrow">{{ eyebrow | escape }}</span>
    {%- endif -%}
    {%- if heading != blank -%}
      <span class="promo-card__heading">{{ heading | escape }}</span>
    {%- endif -%}
    {%- if text != blank -%}
      <span class="promo-card__text">{{ text | escape }}</span>
    {%- endif -%}
    {%- if link_label != blank -%}
      <span class="promo-card__cta">
        {{- link_label | escape -}}
        {%- render 'icon', name: 'arrow-right' -%}
      </span>
    {%- endif -%}
  </span>
</a>
