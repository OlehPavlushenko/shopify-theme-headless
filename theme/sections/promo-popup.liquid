{% comment %}
  Promo popup, in the "Overlays" section group (rendered on every page). Content from blocks:
  text, countdown, newsletter, products, button — in the editor's order. Optional image beside the
  content (hidden on phones). Phones get a sheet from the bottom instead of a centered window.
  When it opens and how often: <promo-popup> (@ui/promo-popup). Styles: packages/ui/css/promo.css.
{% endcomment %}
{%- liquid
  capture active
    render 'schedule-active', from: section.settings.show_from, until: section.settings.show_until
  endcapture
  assign on_page = true
  case section.settings.pages
    when 'home'
      if template.name != 'index'
        assign on_page = false
      endif
    when 'not_cart'
      if template.name == 'cart'
        assign on_page = false
      endif
  endcase
  if request.design_mode
    assign on_page = true
  endif
-%}
{%- if active contains 'true' and on_page and section.blocks.size > 0 -%}
  {%- assign title_id = 'PromoPopup-title-' | append: section.id -%}
  <promo-popup
    data-id="{{ section.id }}"
    {% if section.settings.delay > 0 or section.settings.scroll == 0 and section.settings.exit_intent == false %}
      data-delay="{{ section.settings.delay }}"
    {% endif %}
    data-scroll="{{ section.settings.scroll }}"
    data-days="{{ section.settings.days }}"
    {% if section.settings.exit_intent %}
      data-exit
    {% endif %}
  >
    <dialog
      class="popup promo-popup color-{{ section.settings.color_scheme }}{% if section.settings.image %} promo-popup--media{% endif %}"
      aria-labelledby="{{ title_id }}"
    >
      <div class="promo-popup__inner">
        {%- if section.settings.image -%}
          <div class="promo-popup__media">
            {{
              section.settings.image
              | image_url: width: 900
              | image_tag: loading: 'lazy', sizes: '360px', widths: '360, 540, 720, 900', alt: ''
            }}
          </div>
        {%- endif -%}

        {%- comment -%} Focus lands here on open (not on the close button, which would show its focus ring) {%- endcomment -%}
        <div class="promo-popup__content" tabindex="-1" autofocus>
          <button type="button" class="btn btn--icon promo-popup__close" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
            {%- render 'icon', name: 'close' -%}
          </button>

          {%- assign has_title = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="promo-popup__text" {{ block.shopify_attributes }}>
                  {%- if block.settings.eyebrow != blank -%}
                    <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="h3 promo-popup__heading"{% unless has_title %} id="{{ title_id }}"{% endunless %}>
                      {{- block.settings.heading -}}
                    </h2>
                    {%- assign has_title = true -%}
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="promo-popup__body">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>

              {%- when 'countdown' -%}
                {%- if block.settings.end != blank -%}
                  <p class="promo-popup__countdown" data-countdown-section {{ block.shopify_attributes }}>
                    {%- render 'countdown', end: block.settings.end -%}
                  </p>
                {%- endif -%}

              {%- when 'newsletter' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'newsletter-form',
                    id: block.id,
                    button_label: block.settings.button_label,
                    success_text: block.settings.success_text,
                    already_text: block.settings.already_text,
                    note: block.settings.note,
                    discount_code: block.settings.discount_code
                  -%}
                </div>

              {%- when 'products' -%}
                {%- if block.settings.products.count > 0 -%}
                  <ui-slider class="slider promo-popup__products" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="eyebrow">{{ block.settings.heading | escape }}</p>
                    {%- endif -%}
                    <ul class="slider__track" data-slider-track role="list">
                      {%- for product in block.settings.products -%}
                        <li>
                          {%- render 'product-card',
                            product: product,
                            quick_add: true,
                            show_secondary_image: false,
                            heading_tag: 'p',
                            sizes: '160px'
                          -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </ui-slider>
                {%- endif -%}

              {%- when 'button' -%}
                {%- if block.settings.label != blank -%}
                  <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="btn btn--full" {{ block.shopify_attributes }}>
                    {{- block.settings.label | escape -}}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </dialog>
  </promo-popup>
  <script type="module">import '@ui/promo-popup';</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.promo_popup.name",
  "class": "promo-popup-section",
  "enabled_on": { "groups": ["custom.overlay"] },
  "settings": [
    { "type": "header", "content": "t:sections.promo_popup.when" },
    {
      "type": "range",
      "id": "delay",
      "label": "t:sections.promo_popup.delay",
      "info": "t:sections.promo_popup.delay_info",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "range",
      "id": "scroll",
      "label": "t:sections.promo_popup.scroll",
      "info": "t:sections.promo_popup.scroll_info",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "default": 40
    },
    { "type": "checkbox", "id": "exit_intent", "label": "t:sections.promo_popup.exit_intent", "info": "t:sections.promo_popup.exit_intent_info", "default": true },
    {
      "type": "range",
      "id": "days",
      "label": "t:sections.promo_popup.days",
      "info": "t:sections.promo_popup.days_info",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 3
    },
    {
      "type": "select",
      "id": "pages",
      "label": "t:sections.promo_popup.pages",
      "options": [
        { "value": "all", "label": "t:sections.promo_popup.pages_all" },
        { "value": "home", "label": "t:sections.promo_popup.pages_home" },
        { "value": "not_cart", "label": "t:sections.promo_popup.pages_not_cart" }
      ],
      "default": "not_cart"
    },
    { "type": "text", "id": "show_from", "label": "t:labels.show_from", "info": "t:labels.schedule_info" },
    { "type": "text", "id": "show_until", "label": "t:labels.show_until", "info": "t:labels.schedule_info" },
    { "type": "header", "content": "t:sections.promo_popup.look" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "t:sections.promo_popup.image", "info": "t:sections.promo_popup.image_info" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:labels.text",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "t:sections.promo_popup.eyebrow" },
        { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Get 10% off your first order" },
        { "type": "richtext", "id": "text", "label": "t:labels.text" }
      ]
    },
    {
      "type": "countdown",
      "name": "t:sections.countdown.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "end", "label": "t:sections.countdown.end", "info": "t:sections.countdown.end_info", "default": "2026-12-31 23:59" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.promo_popup.newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "t:labels.button_label" },
        { "type": "richtext", "id": "success_text", "label": "t:sections.promo_popup.success_text", "info": "t:sections.promo_popup.success_text_info" },
        { "type": "richtext", "id": "already_text", "label": "t:sections.promo_popup.already_text" },
        { "type": "inline_richtext", "id": "note", "label": "t:sections.promo_popup.note" },
        { "type": "text", "id": "discount_code", "label": "t:sections.promo_popup.discount_code", "info": "t:sections.promo_popup.discount_code_info" }
      ]
    },
    {
      "type": "products",
      "name": "t:sections.promo_popup.products",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading" },
        { "type": "product_list", "id": "products", "label": "t:sections.promo_popup.products", "limit": 6 }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.promo_popup.button",
      "settings": [
        { "type": "text", "id": "label", "label": "t:labels.button_label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "t:labels.button_link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_popup.name",
      "blocks": [{ "type": "text" }, { "type": "newsletter" }]
    }
  ]
}
{% endschema %}
