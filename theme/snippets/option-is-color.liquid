{% doc %}
  Outputs "true" when a product option is shown as color swatches: its name means "color" (English,
  Ukrainian, Russian) or its values have Shopify swatches. The one place this rule lives — capture it:
    {%- capture is_color -%}{% render 'option-is-color', option: option %}{%- endcapture -%}
    {%- if is_color contains 'true' -%} … swatches … {%- endif -%}

  @param {object} option - Product option (product.options_with_values item)
{% enddoc %}
{%- liquid
  assign color_names = 'color,colour,колір,цвет' | split: ','
  assign option_name = option.name | downcase
  if color_names contains option_name or option.values.first.swatch
    echo 'true'
  endif
-%}
