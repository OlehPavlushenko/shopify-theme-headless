{% if card_product and card_product != empty %}
    <div class='mega-menu-product-post__wrapper'>
        <picture class='mega-menu-product-post__media  media media__size--{{ settings.prod_img_size }}'>
            <a href='{{ card_product.url | within: collection }}'>
                {% render 'image',
                    image_box: card_product.featured_media,
                    image_box_class: 'mega-menu-product-post__image'
                %}
            </a>
        </picture>
    </div>
    <div class='mega-menu-product-post__content'>
        <span class='visually-hidden'>{{ 'accessibility.vendor' | t }}</span>
        <span class='mega-menu-product-post__vendor utility'>{{ card_product.vendor }}</span>
        <h5 class='mega-menu-product-post__title'>
            <a href='{{ card_product.url | within: collection }}'>
                {{ card_product.title | truncate: 30 | escape }}
            </a>
        </h5>
        {% render 'price', product: card_product, price_class: 'mega-menu-product-post__price card-product__price', use_variant: true %}
    </div>
{% endif %}
