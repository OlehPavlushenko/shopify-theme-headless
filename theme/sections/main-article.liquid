{% comment %}
  Article page: breadcrumbs, tags, the title (h1), author · date · reading time, the cover image, the
  text in a reading column, share links, then comments (when the blog allows them) with Shopify's
  comment form. Article structured data comes from Shopify (snippets/structured-data). "More
  articles" is the Blog posts section placed after it in templates/article.json.
  Styles: .main-article in sections.css.
{% endcomment %}
{%- liquid
  assign image_alt = article.image.alt | default: ''
  assign share_url = request.origin | append: article.url
  assign shop_products = article.metafields.theme.products.value
-%}
<article class="main-article color-{{ section.settings.color_scheme }} section-spacing">
  {%- if section.settings.show_toc -%}
    <span class="reading-progress" data-reading-progress aria-hidden="true"></span>
  {%- endif -%}
  <header class="page-width page-width--narrow main-article__header">
    {%- render 'breadcrumbs' -%}
    {%- if article.tags.size > 0 -%}
      <ul class="main-article__tags" role="list">
        {%- for tag in article.tags -%}
          {%- capture topic_url -%}{% render 'blog-topic-url', blog_url: blog.url, tag: tag %}{%- endcapture -%}
          <li><a href="{{ topic_url | strip }}" class="tag">{{ tag | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <h1 class="h1 main-article__title">{{ article.title | escape }}</h1>
    <p class="main-article__meta">
      {%- if section.settings.show_author and article.author != blank -%}
        <span>{{ 'blog.by' | t: author: article.author }}</span>
      {%- endif -%}
      <span>{{ article.published_at | time_tag: format: 'date' }}</span>
      {%- if section.settings.show_reading_time -%}
        {%- capture minutes -%}{% render 'reading-time', article: article %}{%- endcapture -%}
        {%- assign minutes = minutes | strip | plus: 0 -%}
        <span>{{ 'blog.reading_time' | t: count: minutes }}</span>
      {%- endif -%}
    </p>
  </header>

  {%- if article.image and section.settings.image_layout != 'none' -%}
    <div class="page-width main-article__media">
      <div class="frame" style="--frame-ratio: 16 / 9;">
        {{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1440px) 1344px, 100vw', widths: '750, 1100, 1500, 2000', alt: image_alt }}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width main-article__layout">
    {%- if section.settings.show_toc -%}
      <aside class="main-article__toc">
        {%- comment -%} From 1200px a sticky list; below it a bar at the bottom of the screen that opens the list {%- endcomment -%}
        <article-toc class="article-toc" data-content="#ArticleContent-{{ section.id }}" hidden>
          <button type="button" class="article-toc__toggle" aria-expanded="false" aria-controls="ArticleTocPanel-{{ section.id }}" data-toc-toggle>
            <span class="article-toc__toggle-text">
              <span class="article-toc__toggle-label">{{ 'blog.on_this_page' | t }}</span>
              <span class="article-toc__toggle-current" data-toc-current></span>
            </span>
            {%- render 'icon', name: 'chevron-down' -%}
          </button>
          <div class="article-toc__panel" id="ArticleTocPanel-{{ section.id }}" data-toc-panel>
            <p class="article-toc__title">{{ 'blog.on_this_page' | t }}</p>
            <ol class="article-toc__list" role="list" data-toc-list></ol>
          </div>
        </article-toc>
      </aside>
    {%- endif -%}

    {%- if section.settings.show_products and shop_products.size > 0 -%}
      <aside class="main-article__shop" aria-labelledby="ShopArticle-{{ section.id }}">
        <h2 id="ShopArticle-{{ section.id }}" class="h5">{{ 'blog.shop_article' | t }}</h2>
        <ul class="product-rows" role="list">
          {%- for product in shop_products limit: 6 -%}
            <li>{%- render 'product-row', product: product -%}</li>
          {%- endfor -%}
        </ul>
      </aside>
    {%- endif -%}

  <div class="main-article__body">
    <div class="rte main-article__content" id="ArticleContent-{{ section.id }}">{{ article.content }}</div>

    {%- if section.settings.show_share -%}
      <div class="main-article__share">
        <span class="main-article__share-label">{{ 'blog.share' | t }}</span>
        <a class="btn btn--icon btn--outline" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">
          {%- render 'icon', name: 'facebook' -%}
        </a>
        <a class="btn btn--icon btn--outline" href="https://t.me/share/url?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" aria-label="Telegram">
          {%- render 'icon', name: 'telegram' -%}
        </a>
        <a class="btn btn--icon btn--outline" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&description={{ article.title | url_encode }}" target="_blank" rel="noopener" aria-label="Pinterest">
          {%- render 'icon', name: 'pinterest' -%}
        </a>
      </div>
    {%- endif -%}

    <a href="{{ blog.url }}" class="section-head__link main-article__back">
      {%- render 'icon', name: 'arrow-left' -%}
      {{- 'blog.back' | t: blog: blog.title -}}
    </a>

    {%- if blog.comments_enabled? -%}
      <section class="main-article__comments" id="Comments" aria-labelledby="CommentsTitle">
        <h2 class="h4" id="CommentsTitle">{{ 'blog.comments_count' | t: count: article.comments_count }}</h2>
        {%- paginate article.comments by 10 -%}
          {%- if article.comments.size > 0 -%}
            <ol class="main-article__comment-list" role="list">
              {%- for comment in article.comments -%}
                <li class="main-article__comment">
                  <p class="main-article__comment-meta">
                    <strong>{{ comment.author | escape }}</strong> · {{ comment.created_at | time_tag: format: 'date' }}
                  </p>
                  <div class="rte">{{ comment.content }}</div>
                </li>
              {%- endfor -%}
            </ol>
            {%- render 'pagination', paginate: paginate, anchor: '#Comments' -%}
          {%- endif -%}
        {%- endpaginate -%}

        {%- form 'new_comment', article, class: 'main-article__comment-form' -%}
          <h3 class="h5">{{ 'blog.comment_form_title' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="notice notice--success" role="status">
              {%- render 'icon', name: 'check' -%}
              {%- if blog.moderated? -%}{{ 'blog.comment_moderated' | t }}{%- else -%}{{ 'blog.comment_posted' | t }}{%- endif -%}
            </p>
          {%- elsif form.errors -%}
            <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="main-contact__row">
            <div class="field">
              <label class="field__label" for="CommentAuthor">{{ 'blog.comment_form_name' | t }} *</label>
              <input class="input" type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" autocomplete="name" required>
            </div>
            <div class="field">
              <label class="field__label" for="CommentEmail">{{ 'blog.comment_form_email' | t }} *</label>
              <input class="input" type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" autocomplete="email" spellcheck="false" required>
            </div>
          </div>
          <div class="field">
            <label class="field__label" for="CommentBody">{{ 'blog.comment_form_body' | t }} *</label>
            <textarea class="input" name="comment[body]" id="CommentBody" rows="5" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="btn">{{ 'blog.comment_form_submit' | t }}</button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
  </div>

  {%- if section.settings.show_related -%}
    {%- liquid
      # Read next in one pass: each article gets a key "<9 − shared tags><order>|<handle>", so a plain
      # sort puts the most shared tags first and, on a tie, the newest; the first three are shown
      assign ranked = ''
      for candidate in blog.articles limit: 50
        if candidate.id == article.id
          continue
        endif
        assign shared = 0
        for t in candidate.tags
          if article.tags contains t
            assign shared = shared | plus: 1
          endif
        endfor
        assign rank = 9 | minus: shared | at_least: 0
        assign order = forloop.index | plus: 100
        assign ranked = ranked | append: rank | append: order | append: '|' | append: candidate.handle | append: ','
      endfor
      assign ranked = ranked | split: ',' | sort
    -%}
    {%- capture related_cards -%}
      {%- for entry in ranked limit: 3 -%}
        {%- assign handle = entry | split: '|' | last -%}
        {%- assign candidate = blog.articles | where: 'handle', handle | first -%}
        {%- if candidate -%}
          <li>{%- render 'article-card', article: candidate, show_excerpt: false, blog_url: blog.url, sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' -%}</li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if related_cards != blank -%}
      <section class="page-width main-article__related" aria-labelledby="ReadNext-{{ section.id }}">
        {%- assign related_heading = 'blog.read_next' | t -%}
        <div class="section-head">
          <h2 id="ReadNext-{{ section.id }}" class="h3 section-head__title">{{ related_heading }}</h2>
          <a href="{{ blog.url }}" class="section-head__link">{{ 'blog.all_articles' | t }}{%- render 'icon', name: 'arrow-right' -%}</a>
        </div>
        <ul class="grid main-article__related-grid" role="list" style="--grid-columns: 3; --grid-columns-mobile: 1;">{{ related_cards }}</ul>
      </section>
    {%- endif -%}
  {%- endif -%}
</article>
{%- if section.settings.show_toc -%}
  <script type="module">import '@ui/article-toc';</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_article.name",
  "class": "main-article-section",
  "settings": [
    {
      "type": "select",
      "id": "image_layout",
      "label": "t:sections.main_article.image_layout",
      "options": [
        { "value": "wide", "label": "t:sections.main_article.image_wide" },
        { "value": "none", "label": "t:sections.main_article.image_none" }
      ],
      "default": "wide"
    },
    { "type": "checkbox", "id": "show_author", "label": "t:sections.main_article.show_author", "default": true },
    { "type": "checkbox", "id": "show_reading_time", "label": "t:sections.main_article.show_reading_time", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "t:sections.main_article.show_share", "default": true },
    { "type": "checkbox", "id": "show_toc", "label": "t:sections.main_article.show_toc", "info": "t:sections.main_article.show_toc_info", "default": true },
    { "type": "checkbox", "id": "show_products", "label": "t:sections.main_article.show_products", "info": "t:sections.main_article.show_products_info", "default": true },
    { "type": "checkbox", "id": "show_related", "label": "t:sections.main_article.show_related", "info": "t:sections.main_article.show_related_info", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
