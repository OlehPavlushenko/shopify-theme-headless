{% comment %}
  Image with text: an image on one side, eyebrow, heading, text and a button on the other.
  Styles: packages/ui/css/sections.css.
{% endcomment %}
<div class="image-text image-text--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }} section-spacing">
  <div class="image-text__inner page-width">
    <div class="frame image-text__media" style="--frame-ratio: {{ section.settings.ratio }};">
      {%- if section.settings.image -%}
        {%- assign image_alt = section.settings.image.alt | default: '' -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600', alt: image_alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- assign button_link = section.settings.button_link | default: routes.root_url -%}
      {%- render 'section-intro',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        heading_class: 'h2',
        text: section.settings.text,
        text_class: 'rte image-text__text',
        button_label: section.settings.button_label,
        button_link: button_link
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_text.name",
  "class": "image-text-section",
  "disabled_on": { "groups": ["*"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_text.image_position",
      "options": [
        { "value": "left", "label": "t:sections.hero.position_left" },
        { "value": "right", "label": "t:sections.image_text.right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:labels.ratio",
      "options": [
        { "value": "4 / 5", "label": "t:labels.ratio_portrait" },
        { "value": "1", "label": "t:labels.ratio_square" },
        { "value": "4 / 3", "label": "t:labels.ratio_landscape" }
      ],
      "default": "1"
    },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Our story" },
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Made with care for you" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>We choose every product for a reason and check it before it reaches you.</p>" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:sections.image_text.name" }]
}
{% endschema %}
