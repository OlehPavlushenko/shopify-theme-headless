        "default": true
      },
      {
        "type": "checkbox",
        "id": "prefetch_links",
        "label": "Prefetch links on hover",
        "info": "Starts loading the next page when a shopper hovers a link, so it opens faster (Speculation Rules API).",
        "default": true
      }
    ]
