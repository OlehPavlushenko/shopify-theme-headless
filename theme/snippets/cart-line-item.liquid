{% doc %}
  One cart line, shared by the cart drawer and the cart page.
  Layout: image (optional SKU under it) | title + remove icon, options as "Name: value",
  then quantity and the line price in one row.
  Quantity and remove controls are Liquid Ajax Cart v2 (<ajax-cart-quantity>, data-ajax-cart-request-button),
  so they work without JS as plain links to /cart/change.

  @param {object} item - Cart line item
  @param {number} line - 1-based line index (forloop.index)
  @param {boolean} [eager] - Load the image eagerly (cart page, above the fold)
{% enddoc %}
{%- liquid
  assign image_width = 160
  if eager
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
-%}
<li class="cart-line" data-cart-line="{{ item.key }}">
  <div class="cart-line__media-col">
    <a href="{{ item.url }}" class="cart-line__media frame" tabindex="-1" aria-hidden="true" style="--frame-ratio: 1;">
      {%- if item.image -%}
        {{
          item.image
          | image_url: width: image_width
          | image_tag: loading: loading, width: image_width, height: image_width, alt: item.product.title, sizes: '80px'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
    {%- if settings.show_cart_sku and item.sku != blank -%}
      <p class="cart-line__sku">{{ item.sku | escape }}</p>
    {%- endif -%}
  </div>

  <div class="cart-line__info">
    <div class="cart-line__head">
      <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title | escape }}</a>
      <a
        href="{{ item.url_to_remove }}"
        class="cart-line__remove"
        data-ajax-cart-request-button
        aria-label="{{ 'cart.remove_item' | t: product: item.product.title | escape }}"
      >
        {%- render 'icon', name: 'trash' -%}
      </a>
    </div>

    {%- unless item.product.has_only_default_variant -%}
      <dl class="cart-line__options">
        {%- for option in item.options_with_values -%}
          <div class="cart-line__option">
            <dt>{{ option.name | escape }}:</dt>
            <dd>{{ option.value | escape }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endunless -%}

    {%- for property in item.properties -%}
      {%- liquid
        assign first_char = property.first | slice: 0
        if property.last == blank or first_char == '_'
          continue
        endif
      -%}
      <p class="cart-line__meta">
        {{ property.first | escape }}:
        {% if property.last contains '/uploads/' -%}
          <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
        {%- else -%}
          {{ property.last | escape }}
        {%- endif %}
      </p>
    {%- endfor -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-line__discount">
        {%- render 'icon', name: 'tag' -%}
        {{- discount.discount_application.title }} (−{{ discount.amount | money -}})
      </p>
    {%- endfor -%}

    <div class="cart-line__actions">
      <ajax-cart-quantity class="qty">
        <a
          href="{{ routes.cart_change_url }}?line={{ line }}&quantity={{ item.quantity | minus: 1 }}"
          class="qty__btn"
          data-ajax-cart-quantity-minus
          aria-label="{{ 'cart.decrease' | t: product: item.product.title | escape }}"
        >
          {%- render 'icon', name: 'minus' -%}
        </a>
        <input
          class="qty__input"
          type="number"
          inputmode="numeric"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          {% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %}
            max="{{ item.variant.inventory_quantity }}"
          {% endif %}
          data-ajax-cart-quantity-input="{{ line }}"
          aria-label="{{ 'cart.quantity' | t }}"
        >
        <a
          href="{{ routes.cart_change_url }}?line={{ line }}&quantity={{ item.quantity | plus: 1 }}"
          class="qty__btn"
          data-ajax-cart-quantity-plus
          aria-label="{{ 'cart.increase' | t: product: item.product.title | escape }}"
        >
          {%- render 'icon', name: 'plus' -%}
        </a>
      </ajax-cart-quantity>

      <div class="cart-line__price">
        {%- if item.original_line_price > item.final_line_price -%}
          <span class="price-tag price-tag--sale">
            <span class="price-tag__current">{{ item.final_line_price | money }}</span>
            <s class="price-tag__compare">{{ item.original_line_price | money }}</s>
          </span>
        {%- else -%}
          <span class="price-tag"><span class="price-tag__current">{{ item.final_line_price | money }}</span></span>
        {%- endif -%}
        {%- if item.unit_price_measurement -%}
          <p class="cart-line__unit">
            {{ item.unit_price | money }}/
            {%- if item.unit_price_measurement.reference_value != 1 -%}
              {{- item.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{ item.unit_price_measurement.reference_unit }}
          </p>
        {%- endif -%}
      </div>
    </div>
    <p class="form-error" data-ajax-cart-errors="{{ item.key }}"></p>
  </div>
</li>
