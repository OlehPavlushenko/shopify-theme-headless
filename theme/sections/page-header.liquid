{% comment %}
  Page header: a band on its color scheme with breadcrumbs, the page heading (h1) and an intro line,
  for any template — pages, collections, blogs, search, wishlist, compare. The heading and text
  default to the page / collection / blog title and description and can be set here instead.
  - Image (optional): the collection's image or a picked one beside the text ("split"), or behind
    it under a tint ("cover"). On collections without an image the band stays plain.
  - Subcollections: on a collection, the collections in its metafield theme.subcollections as
    chips under the text (with a thumbnail and the product count).
  - On the wishlist / compare pages (template suffix) the list's counter ("4 products",
    @ui/saved-list) by itself.
  - Blog search (setting): on the blog page and on its search results (templates/search.blog.json,
    with the blog picked here) a search field for the articles (snippets/search-options). With JS it
    re-renders the blog's section in place (<section-swap data-section-forms>, @ui/section-swap).
  Styles: packages/ui/css/sections.css.
{% endcomment %}
{%- liquid
  # The blog: this one (the blog page) or the one picked (its search results, search.blog.json)
  assign header_blog = blog
  if template.name == 'search'
    assign header_blog = section.settings.blog
  endif
  assign heading = section.settings.heading
  if heading == blank
    case template.name
      when 'collection'
        assign heading = collection.title
      when 'blog'
        assign heading = blog.title
      when 'list-collections'
        assign heading = 'general.collections' | t
      when 'search'
        assign heading = 'search.title' | t
        if header_blog != blank
          assign heading = header_blog.title
        endif
      else
        assign heading = page.title | default: page_title
    endcase
  endif
  assign text = section.settings.text
  if text == blank and template.name == 'collection'
    assign text = collection.description
  endif
  assign image = section.settings.image
  if image == blank and section.settings.image_source == 'collection' and template.name == 'collection'
    assign image = collection.image
  endif
  assign media = 'none'
  if image != blank and section.settings.image_layout != 'none'
    assign media = section.settings.image_layout
  endif
  assign subcollections = collection.metafields.theme.subcollections.value
-%}
<div class="page-header page-header--{{ section.settings.alignment }} page-header--media-{{ media }} color-{{ section.settings.color_scheme }}">
  {%- if media == 'cover' -%}
    <div class="page-header__cover" style="--page-header-tint: {{ section.settings.tint }}%;">
      {{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1200, 1800, 2400', alt: '' }}
    </div>
  {%- endif -%}
  <div class="page-header__inner page-width">
    <div class="page-header__text-col">
      {%- if section.settings.breadcrumbs -%}
        {%- if template.name == 'search' and header_blog != blank -%}
          {%- render 'breadcrumbs', class: 'page-header__breadcrumbs', parent_title: header_blog.title, parent_url: header_blog.url -%}
        {%- else -%}
          {%- render 'breadcrumbs', class: 'page-header__breadcrumbs' -%}
        {%- endif -%}
      {%- endif -%}
      <h1 class="h1 page-header__heading">{{ heading }}</h1>
      {%- if text != blank -%}
        <div class="text-lead page-header__text">{{ text }}</div>
      {%- endif -%}
      {%- if section.settings.blog_search and header_blog != blank -%}
        {%- comment -%} An empty field isn't sent: a hint under it instead (<form-validate>) {%- endcomment -%}
        <form-validate class="page-header__search" data-message-required="{{ 'search.empty_query' | t }}">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" data-section-form>
          <label class="search-field">
            <span class="visually-hidden">{{ 'blog.search_label' | t }}</span>
            {%- render 'icon', name: 'search' -%}
            <input class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'blog.search_placeholder' | t | escape }}" enterkeyhint="search" autocomplete="off" required>
          </label>
          {%- render 'search-options', scope: 'articles' -%}
          <button type="submit" class="btn">{{ 'search.submit' | t }}</button>
        </form>
        </form-validate>
        <script type="module">import '@ui/form-validate';</script>
      {%- endif -%}
      {%- if template.suffix == 'wishlist' or template.suffix == 'compare' -%}
        {%- liquid
          assign label_one = 'general.products_count' | t: count: 1
          assign label_other = 'general.products_count' | t: count: '%n'
        -%}
        <p
          class="page-header__counter"
          data-saved-counter="{{ template.suffix }}"
          data-one="{{ label_one | escape }}"
          data-other="{{ label_other | escape }}"
          data-empty
        ></p>
      {%- endif -%}
      {%- if section.settings.subcollections and subcollections.size > 0 -%}
        <nav class="page-header__subcollections" aria-label="{{ 'collections.subcollections' | t }}">
          <ul class="subcollections" role="list">
            {%- for sub in subcollections -%}
              {%- assign thumb = sub.image | default: sub.products.first.featured_image -%}
              <li>
                <a href="{{ sub.url }}" class="subcollection"{% if sub.handle == collection.handle %} aria-current="page"{% endif %}>
                  {%- if thumb -%}
                    {{ thumb | image_url: width: 96 | image_tag: loading: 'lazy', class: 'subcollection__image', width: 48, height: 48, alt: '' }}
                  {%- endif -%}
                  <span class="subcollection__title">{{ sub.title | escape }}</span>
                  <span class="subcollection__count">{{ sub.products_count }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
    {%- if media == 'split' -%}
      <div class="frame page-header__media" style="--frame-ratio: 4 / 3;">
        {{ image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 40vw, 100vw', widths: '600, 900, 1200, 1400', alt: '' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.page_header.name",
  "class": "page-header-section",
  "disabled_on": { "groups": ["*"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "info": "t:sections.page_header.heading_info" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "info": "t:sections.page_header.text_info" },
    { "type": "checkbox", "id": "breadcrumbs", "label": "t:sections.page_header.breadcrumbs", "default": true },
    { "type": "checkbox", "id": "blog_search", "label": "t:sections.page_header.blog_search", "info": "t:sections.page_header.blog_search_info", "default": true },
    { "type": "blog", "id": "blog", "label": "t:sections.main_search.blog", "info": "t:sections.page_header.blog_info" },
    { "type": "checkbox", "id": "subcollections", "label": "t:sections.page_header.subcollections", "info": "t:sections.page_header.subcollections_info", "default": true },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.page_header.alignment",
      "options": [
        { "value": "left", "label": "t:sections.page_header.alignment_left" },
        { "value": "center", "label": "t:sections.page_header.alignment_center" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "t:sections.page_header.image_header" },
    {
      "type": "select",
      "id": "image_layout",
      "label": "t:sections.page_header.image_layout",
      "options": [
        { "value": "none", "label": "t:sections.page_header.image_none" },
        { "value": "split", "label": "t:sections.page_header.image_split" },
        { "value": "cover", "label": "t:sections.page_header.image_cover" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "image_source",
      "label": "t:sections.page_header.image_source",
      "options": [
        { "value": "collection", "label": "t:sections.page_header.image_source_collection" },
        { "value": "picked", "label": "t:sections.page_header.image_source_picked" }
      ],
      "default": "collection"
    },
    { "type": "image_picker", "id": "image", "label": "t:sections.page_header.image", "info": "t:sections.page_header.image_info" },
    { "type": "range", "id": "tint", "label": "t:sections.hero.overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "t:sections.page_header.name" }]
}
{% endschema %}
