{% doc %}
  Document head meta: charset, viewport, title (with tags and page number), canonical, meta
  description (store description as fallback), Open Graph and Twitter cards. Rendered first in the
  layouts head; structured data lives in snippets/structured-data.
{% enddoc %}
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = page_image | default: settings.share_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if og_image -%}
  <meta
    property="og:image"
    content="https:{{ og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:height"
    content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>{% render 'document-title' %}</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- comment -%} Pages without their own description fall back to the store description (Online Store > Preferences) {%- endcomment -%}
{%- assign meta_description = page_description | default: shop.description -%}
{% if meta_description != blank %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% endif %}

{%- comment -%}
  Search results and filtered collection lists duplicate catalog pages, the wishlist and compare pages
  are personal: not indexed, links followed.
  (The canonical of a filtered list points to the collection itself.)
{%- endcomment -%}
{%- liquid
  assign noindex = false
  if request.page_type == 'search' or template.suffix == 'wishlist' or template.suffix == 'compare'
    assign noindex = true
  endif
  if request.page_type == 'collection'
    for filter in collection.filters
      if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank
        assign noindex = true
        break
      endif
    endfor
  endif
-%}
{%- if noindex -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}
