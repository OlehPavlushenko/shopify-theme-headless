<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'meta-tags' -%}
    {{ 'ui-tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-components.css' | asset_url | stylesheet_tag }}
    {%- comment -%} The countdown (announcements), the sign-up form (promo), the page itself (sections) {%- endcomment -%}
    {{ 'ui-announcements.css' | asset_url | stylesheet_tag }}
    {{ 'ui-promo.css' | asset_url | stylesheet_tag }}
    {{ 'ui-sections.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-tokens' -%}
    {%- render 'color-schemes' -%}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    {%- render 'import-map' -%}
    <script type="module">import '@ui/dialog';</script>
    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
