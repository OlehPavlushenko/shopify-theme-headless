{% comment %}
  Predictive search results, fetched by @ui/predictive-search through the Section Rendering API:
  {{ routes.predictive_search_url }}?q=<terms>&section_id=predictive-search&resources[...]
  Not added through the theme editor (no presets). The client reads [data-predictive-results].
{% endcomment %}
{%- liquid
  assign resources = predictive_search.resources
  assign total = resources.products.size | plus: resources.collections.size | plus: resources.pages.size | plus: resources.articles.size | plus: resources.queries.size
  assign terms = predictive_search.terms | escape
-%}
<div data-predictive-results data-count="{{ total }}">
  {%- if predictive_search.performed -%}
    {%- if total == 0 -%}
      <p class="search-results__empty">{{ 'search.no_results_html' | t: terms: terms }}</p>
    {%- else -%}
      <div class="search-results__layout">
        <div class="search-results__aside">
          {%- if resources.queries.size > 0 -%}
            <section class="search-results__group" aria-labelledby="PredictiveQueries">
              <h2 id="PredictiveQueries" class="eyebrow search-results__heading">{{ 'search.suggestions' | t }}</h2>
              <ul class="link-list" role="list">
                {%- for query in resources.queries limit: 5 -%}
                  <li>
                    <a href="{{ query.url }}" class="link-list__link">
                      {%- render 'icon', name: 'search' -%}
                      <span>{{- query.styled_text -}}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if resources.collections.size > 0 -%}
            <section class="search-results__group" aria-labelledby="PredictiveCollections">
              <h2 id="PredictiveCollections" class="eyebrow search-results__heading">{{ 'search.collections' | t }}</h2>
              <ul class="link-list" role="list">
                {%- for collection in resources.collections limit: 5 -%}
                  <li><a href="{{ collection.url }}" class="link-list__link">{{ collection.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if resources.pages.size > 0 or resources.articles.size > 0 -%}
            <section class="search-results__group" aria-labelledby="PredictivePages">
              <h2 id="PredictivePages" class="eyebrow search-results__heading">{{ 'search.pages' | t }}</h2>
              <ul class="link-list" role="list">
                {%- for page in resources.pages limit: 3 -%}
                  <li><a href="{{ page.url }}" class="link-list__link">{{ page.title | escape }}</a></li>
                {%- endfor -%}
                {%- for article in resources.articles limit: 3 -%}
                  <li><a href="{{ article.url }}" class="link-list__link">{{ article.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}
        </div>
        {%- if resources.products.size > 0 -%}
          <ui-slider class="slider search-slider search-results__main" aria-labelledby="PredictiveProducts">
            <div class="slider__head">
              <h2 id="PredictiveProducts" class="eyebrow search-results__heading">{{ 'search.products' | t }}</h2>
              <div class="slider__head-end">
                {%- assign products_label = 'search.products' | t -%}
                {%- render 'slider-nav', label: products_label -%}
              </div>
            </div>
            <ul class="slider__track" data-slider-track role="list">
              {%- for product in resources.products limit: 10 -%}
                <li>
                  {%- render 'product-card',
                    product: product,
                    show_secondary_image: false,
                    sizes: '(min-width: 1280px) 260px, (min-width: 750px) 30vw, 45vw',
                    heading_tag: 'p'
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          </ui-slider>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- if total > 0 -%}
      <div class="search-results__footer">
        <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last" class="btn btn--outline btn--sm">
          {{- 'search.view_all_html' | t: terms: terms -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.search",
  "class": "predictive-search-section"
}
{% endschema %}
