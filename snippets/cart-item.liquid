<div class="ajax-cart__line-item">
    <div class="ajax-cart-item__media">
        {% if item.image %}
            {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
            <a href="{{ item.url }}" class="ajax-cart-item__link" aria-hidden="true" tabindex="-1">
                <div class="ajax-cart-item__image-container media media__size--{{ size  }}">
                    <img
                        src="{{ item.image | image_url: width: 300 }}"
                        class="ajax-cart-item__image media__image"
                        alt="{{ item.product.title }}"
                        loading="eager"
                        fetchpriority="high"
                        width="150"
                        height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                    >
                </div>
            </a>
        {% endif %}
    </div>
    <div class="ajax-cart-item__details">
        {% if template_cart %}
            <div class="ajax-cart-item__details--left">
        {% endif %}
        <p class="ajax-cart-caption">{{ item.product.vendor }}</p>
        <h5 class="ajax-cart-item__name">
            <a href="{{ item.url }}" class="break">
                {{- item.product.title | escape -}}
            </a>
        </h5>
        

        {%- if item.product.has_only_default_variant == false
            or item.properties.size != 0
            or item.selling_plan_allocation != null
        -%}
            <div class="ajax-cart-product-options">
                {%- if item.product.has_only_default_variant == false -%}
                    <div class="ajax-cart-product-option">
                        {%- for option in item.options_with_values -%}
                            {% if forloop.index == 1 %}
                                <span>{{ option.value }}</span>
                            {% else %}
                                <span>\ {{ option.value }} </span>
                            {% endif %}
                        {%- endfor -%}
                    </div>
                {%- endif -%}

                {%- for property in item.properties -%}
                    {%- assign property_first_char = property.first | slice: 0 -%}
                    {%- if property.last != blank and property_first_char != '_' -%}
                        <div class="ajax-cart-product-option">
                            <dt>{{ property.first }}:</dt>
                            <dd>
                                {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">
                                        {{ property.last | split: '/' | last }}
                                    </a>
                                    {{ property.last }}
                                {%- endif -%}
                            </dd>
                        </div>
                    {%- endif -%}
                {%- endfor -%}
            </div>

            <p class="ajax-cart-product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}

        <ul
            class="ajax-cart-discounts list-unstyled"
            role="list"
            aria-label="{{ 'customer.order.discount' | t }}"
        >
            {%- for discount in item.discounts -%}
                <li class="discounts__discount">
                    {% render 'icons-svg', icons: 'discount' %}
                    {{ discount.title }}
                </li>
            {%- endfor -%}
        </ul>
        {% if template_cart %}
            </div>
        {% endif %}
        <div class="ajax-cart-item__price-wrapper">
            {%- if item.original_line_price != item.final_line_price -%}
                <div class="ajax-cart-item__discounted-prices price">
                    <span class="price--end">
                        {{ item.final_line_price | money }}
                    </span>
                    <span class="visually-hidden">
                        {{ 'products.product.price.regular_price' | t }}
                    </span>
                    <s class="cart-item__old-price price price--end">
                        {{ item.original_line_price | money }}
                    </s>
                    <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                    </span>
                   <div class="price__badge">
                        <span>
                        {{-
                        item.original_line_price
                        | minus: item.final_line_price
                        | times: 100.0
                        | divided_by: item.original_line_price
                        | money_without_currency
                        | replace: ',', '.'
                        | times: 100
                        | remove: '.0'
                        -}}%</span>
                    </div>
                </div>
            {%- else -%}
                <span class="price">
                    {%- if item.original_price == item.variant.compare_at_price -%}
                        {{ item.original_price | money }}
                        {% assign total_amount = total_amount | plus: item.original_price %}
                    {%- else -%}
                       
                        <span class="price-origin">
                            {{ item.original_price | money }}
                        </span>
                        {% if item.variant.compare_at_price %}
                            <span class="price-compare">
                                {{ item.variant.compare_at_price | money }}
                            </span>
                        {%- endif -%}
                        {% assign total_amount = total_amount | plus: item.variant.compare_at_price %}
                    {%- endif -%}
                    {% if item.variant.compare_at_price %}
                        <div class="price__badge">
                            <span>
                            {{-
                            item.variant.compare_at_price
                            | minus: item.original_price
                            | times: 100.0
                            | divided_by: item.variant.compare_at_price
                            | money_without_currency
                            | replace: ',', '.'
                            | times: 100
                            | remove: '.0'
                            -}}%</span>
                        </div>
                    {% endif %}
                    </span>
            {%- endif -%}

            {%- if item.variant.available
            and item.unit_price_measurement
            -%}
                <div class="unit-price caption">
                        <span class="visually-hidden">
                            {{- 'products.product.price.unit_price' | t -}}
                        </span>
                    {{ item.unit_price | money }}
                    <span aria-hidden="true">/</span>
                    <span class="visually-hidden"
                    >&nbsp;
                            {{- 'accessibility.unit_price_separator' | t -}}
                            &nbsp;</span
                    >
                    {%- if item.unit_price_measurement.reference_value != 1
                    -%}
                        {{- item.unit_price_measurement.reference_value -}}
                    {%- endif -%}
                    {{ item.unit_price_measurement.reference_unit }}
                </div>
            {%- endif -%}
        </div>
        <div class="ajax-cart-item__quantity{% if property_discount %} hidden{% endif %}">
            <div class="ajax-cart-item__quantity-wrapper">
                <ajax-cart-quantity>
                <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                    {{ 'sections.cart.quantity' | t }}
                </label>
                <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                    class="ajax-cart__quantity-button ajax-cart__quantity-button--minus"
                    data-ajax-cart-quantity-minus
                >
                    {% render 'icons-svg', icons: 'minus' %}
                </a>
                <input
                    class="ajax-cart-drawer__input cart-drawer__input--qty"
                    type="number"
                    value="{{ item.quantity }}"
                    min="0"
                    name="updates[]"
                    data-ajax-cart-quantity-input="{{ forloop.index }}"
                >
                <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                    class="ajax-cart__quantity-button ajax-cart__quantity-button--plus"
                    data-ajax-cart-quantity-plus
                >
                    {% render 'icons-svg', icons: 'plus' %}
                </a>
                </ajax-cart-quantity>
            </div>
            <div data-ajax-cart-errors="{{ item.key }}"></div>
        </div>

        {% if settings.currency_code_enabled %}
            <div class="ajax-cart-total {% if property_discount %} hidden{% endif %}">
                {{ 'sections.cart.total' | t }}
                {% if item.original_line_price != item.final_line_price %}
                    <del>{{ item.original_line_price | money_with_currency }}</del>
                    {{ item.final_line_price | money_with_currency }}
                {% else %}
                    {{ item.original_line_price | money_with_currency }}
                {% endif %}
            </div>
        {% else %}
            <div class="ajax-cart-total {% if property_discount %} hidden{% endif %}">
                {{ 'sections.cart.total' | t }}
                {% if item.original_line_price != item.final_line_price %}
                    <del>{{ item.original_line_price | money }}</del>
                    {{ item.final_line_price | money }}
                {% else %}
                    {{ item.original_line_price | money }}
                {% endif %}
            </div>
        {% endif %}
        <div class="ajax-cart-remove {% if property_discount %} js-combo-remove{% endif %}">
            <a
                href="{{ item.url_to_remove }}"
                class="ajax-cart__remove-button"
                data-ajax-cart-request-button 
            >
                {% render 'icons-svg', icons: 'trash' %}
                <small>{{ 'sections.cart.remove' | t }}</small>
            </a>
        </div>
    </div>
</div>
