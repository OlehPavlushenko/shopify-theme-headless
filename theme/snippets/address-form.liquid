{% doc %}
  Fields of a customer address form (add or edit), inside {% form 'customer_address' %}: name,
  company, address lines, city, country and province (filled by Shopify's CountryProvinceSelector
  from data-default), ZIP, phone, "default address", and the buttons.
  Styles: .account-form in packages/ui/css/account.css.

  @param {object} form - The form object (its fields are the address's values)
  @param {string} id - Unique prefix for the field ids (one per form on the page)
  @param {boolean} [is_new] - The "add a new address" form (its cancel closes the panel)
{% enddoc %}
<div class="account-form__row">
  <label class="account-form__field">
    <span class="account-form__label">{{ 'customers.fields.first_name' | t }}</span>
    <input class="input" type="text" name="address[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name">
  </label>
  <label class="account-form__field">
    <span class="account-form__label">{{ 'customers.fields.last_name' | t }}</span>
    <input class="input" type="text" name="address[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name">
  </label>
</div>
<label class="account-form__field">
  <span class="account-form__label">{{ 'customers.fields.company' | t }}</span>
  <input class="input" type="text" name="address[company]" value="{{ form.company | escape }}" autocomplete="organization">
</label>
<label class="account-form__field">
  <span class="account-form__label">{{ 'customers.fields.address1' | t }}</span>
  <input class="input" type="text" name="address[address1]" value="{{ form.address1 | escape }}" autocomplete="address-line1">
</label>
<label class="account-form__field">
  <span class="account-form__label">{{ 'customers.fields.address2' | t }}</span>
  <input class="input" type="text" name="address[address2]" value="{{ form.address2 | escape }}" autocomplete="address-line2">
</label>
<div class="account-form__row">
  <label class="account-form__field">
    <span class="account-form__label">{{ 'customers.fields.city' | t }}</span>
    <input class="input" type="text" name="address[city]" value="{{ form.city | escape }}" autocomplete="address-level2">
  </label>
  <label class="account-form__field">
    <span class="account-form__label">{{ 'customers.fields.zip' | t }}</span>
    <input class="input" type="text" name="address[zip]" value="{{ form.zip | escape }}" autocomplete="postal-code" autocapitalize="characters">
  </label>
</div>
<div class="account-form__row">
  <label class="account-form__field">
    <span class="account-form__label">{{ 'customers.fields.country' | t }}</span>
    <select class="input" id="{{ id }}-country" name="address[country]" data-default="{{ form.country | escape }}" data-country-select="{{ id }}" autocomplete="country">
      {{ all_country_option_tags }}
    </select>
  </label>
  <label class="account-form__field" id="{{ id }}-province-field">
    <span class="account-form__label">{{ 'customers.fields.province' | t }}</span>
    <select class="input" id="{{ id }}-province" name="address[province]" data-default="{{ form.province | escape }}" autocomplete="address-level1"></select>
  </label>
</div>
<label class="account-form__field">
  <span class="account-form__label">{{ 'customers.fields.phone' | t }}</span>
  <input class="input" type="tel" name="address[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
</label>
<label class="account-form__check">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customers.addresses.set_default' | t }}</span>
</label>
<div class="account-form__actions">
  <button type="submit" class="btn">
    {%- if is_new -%}{{ 'customers.addresses.add' | t }}{%- else -%}{{ 'customers.addresses.update' | t }}{%- endif -%}
  </button>
  <button type="button" class="btn btn--outline" data-address-cancel>{{ 'customers.addresses.cancel' | t }}</button>
</div>
