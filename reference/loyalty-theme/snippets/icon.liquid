{% doc %}
    Inline SVG icon, 24×24 grid, stroke uses currentColor. Size via the --icon-size custom property.
    (Legacy sections still use snippets/icons-svg.liquid; new code uses this snippet.)

    @param {string} name - close | plus | minus | cart | bag | check | arrow-right | arrow-left | chevron-down | search | account | menu | trash
    @param {string} [class] - Extra classes
{% enddoc %}
<svg
    class="svg-icon svg-icon--{{ name }} {{ class }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
>
    {%- case name -%}
        {%- when 'close' -%}
            <path d="M6 6l12 12M18 6L6 18"/>
        {%- when 'plus' -%}
            <path d="M12 5v14M5 12h14"/>
        {%- when 'minus' -%}
            <path d="M5 12h14"/>
        {%- when 'cart' -%}
            <path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6.2"/><circle cx="9" cy="20" r="1"/><circle cx="17" cy="20" r="1"/>
        {%- when 'bag' -%}
            <path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
        {%- when 'check' -%}
            <path d="M5 12.5l4.5 4.5L19 7.5"/>
        {%- when 'arrow-right' -%}
            <path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'arrow-left' -%}
            <path d="M19 12H5M11 6l-6 6 6 6"/>
        {%- when 'chevron-down' -%}
            <path d="M6 9l6 6 6-6"/>
        {%- when 'search' -%}
            <circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>
        {%- when 'account' -%}
            <circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0"/>
        {%- when 'menu' -%}
            <path d="M4 7h16M4 12h16M4 17h16"/>
        {%- when 'trash' -%}
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>
    {%- endcase -%}
</svg>
