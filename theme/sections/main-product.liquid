{% comment %}
  Product page: media gallery + product info (blocks), in one <product-info> (@ui/variant-picker)
  so price, buttons, stock, media and the URL follow the picked variant.
  Gallery layouts (setting): grid (two columns of images), thumbnails (one big image + a strip),
  stacked (one column of large images). Phones: always a swipe slider with a counter.
  Info blocks: vendor, title, rating, price, variant picker, buy buttons (quantity, add to cart,
  dynamic checkout, stock, in-cart note), delivery estimate, highlights, text, collapsible rows,
  complementary products, wishlist / compare, share. The info column sticks while the gallery scrolls.
  Also: a zoom lightbox, a sticky buy bar once the main button scrolls away, recently viewed record.
  Behavior: assets/product.js. Styles: packages/ui/css/product.css.
{% endcomment %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign gallery = section.settings.gallery_layout
  assign media_list = product.media
  assign form_id = 'ProductForm-' | append: section.id
  assign label_add = 'products.add_to_cart' | t
  assign label_sold_out = 'products.sold_out' | t
  assign label_unavailable = 'products.unavailable' | t
  capture discount
    render 'discount-percent', price: variant.price, compare_at: variant.compare_at_price
  endcapture
  assign discount = discount | strip | plus: 0
  case gallery
    when 'grid'
      assign media_sizes = '(min-width: 990px) 28vw, 100vw'
    when 'stacked'
      assign media_sizes = '(min-width: 990px) 55vw, 100vw'
    else
      assign media_sizes = '(min-width: 990px) 50vw, 100vw'
  endcase
-%}
<product-info
  class="main-product main-product--{{ gallery }} main-product--info-{{ section.settings.info_style }} color-{{ section.settings.color_scheme }}"
  data-update-url
  data-product-handle="{{ product.handle }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-label-add="{{ label_add | escape }}"
  data-label-sold-out="{{ label_sold_out | escape }}"
  data-label-unavailable="{{ label_unavailable | escape }}"
>
  {%- if section.settings.breadcrumbs -%}
    <div class="page-width main-product__crumbs">{%- render 'breadcrumbs' -%}</div>
  {%- endif -%}
  <div class="page-width main-product__inner">
    {%- comment -%}
      The head — the product's label (metafield custom.label, e.g. "Bestseller") and the title, the
      page's only h1 — comes before the gallery: on phones the title is above the photos, from 990px
      the grid puts it at the top of the info column. Rendered where the Title block is.
    {%- endcomment -%}
    {%- assign title_block = section.blocks | where: 'type', 'title' | first -%}
    {%- if title_block -%}
      <div class="main-product__head" {{ title_block.shopify_attributes }}>
        {%- assign product_label = product.metafields.custom.label.value -%}
        {%- if product_label != blank -%}
          <span class="pill pill--soft main-product__label">{{ product_label | escape }}</span>
        {%- endif -%}
        <h1 class="h2 main-product__title">{{ product.title | escape }}</h1>
      </div>
    {%- endif -%}
    {%- comment -%} ----------------------------------------------------------- gallery {%- endcomment -%}
    <product-gallery class="product-gallery product-gallery--{{ gallery }}" data-layout="{{ gallery }}">
      <ul class="product-gallery__track" role="list" data-gallery-track>
        {%- for media in media_list -%}
          {%- liquid
            assign eager = false
            if forloop.first
              assign eager = true
            endif
            assign media_alt = media.alt | default: product.title
          -%}
          <li class="product-gallery__item product-gallery__item--{{ media.media_type }}" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <button type="button" class="frame product-gallery__zoom" style="--frame-ratio: {{ section.settings.ratio }};" data-zoom="{{ forloop.index0 }}" aria-label="{{ 'products.zoom' | t: index: forloop.index }}">
                  {%- if eager -%}
                    {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: media_sizes, widths: '600, 900, 1200, 1600', alt: media_alt }}
                  {%- else -%}
                    {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: media_sizes, widths: '600, 900, 1200, 1600', alt: media_alt }}
                  {%- endif -%}
                  <span class="product-gallery__zoom-icon" aria-hidden="true">{%- render 'icon', name: 'zoom' -%}</span>
                </button>
              {%- when 'video' -%}
                <div class="frame product-gallery__video" style="--frame-ratio: {{ section.settings.ratio }};">
                  {{ media | video_tag: controls: true, muted: true, playsinline: true, loop: true, preload: 'none', image_size: '1200x' }}
                </div>
              {%- when 'external_video' -%}
                <div class="frame product-gallery__video" style="--frame-ratio: 16 / 9;">
                  {{ media | external_video_tag: loading: 'lazy' }}
                </div>
              {%- else -%}
                <div class="frame" style="--frame-ratio: {{ section.settings.ratio }};">
                  {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: media_sizes, alt: media_alt }}
                </div>
            {%- endcase -%}
          </li>
        {%- else -%}
          <li class="product-gallery__item">
            <div class="frame" style="--frame-ratio: 1;">{{ 'product-1' | placeholder_svg_tag }}</div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if media_list.size > 1 -%}
        <p class="product-gallery__counter" aria-hidden="true"><span data-gallery-current>1</span> / {{ media_list.size }}</p>
        {%- if gallery == 'thumbnails' -%}
          <ul class="product-gallery__thumbs" role="list">
            {%- for media in media_list -%}
              <li>
                <button type="button" class="frame product-gallery__thumb" style="--frame-ratio: 1;" data-thumb="{{ forloop.index0 }}" aria-label="{{ 'products.show_media' | t: index: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '80px', widths: '100, 200', alt: '' }}
                  {%- if media.media_type contains 'video' -%}
                    <span class="product-gallery__thumb-play" aria-hidden="true">{%- render 'icon', name: 'play' -%}</span>
                  {%- endif -%}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}

      {%- if discount > 0 -%}
        <span class="pill product-gallery__badge" data-discount-badge>−{{ discount }}%</span>
      {%- else -%}
        <span class="pill product-gallery__badge" data-discount-badge hidden></span>
      {%- endif -%}
    </product-gallery>

    {%- comment -%} -------------------------------------------------------------- info {%- endcomment -%}
    <div class="main-product__info">
      <div class="main-product__info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="main-product__vendor" {{ block.shopify_attributes }}>
                  <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor | escape }}</a>
                </p>
              {%- endif -%}

            {%- when 'title' -%}
              {%- comment -%} Rendered above, in the head (before the gallery) {%- endcomment -%}

            {%- when 'rating' -%}
              {%- if product.metafields.reviews.rating.value -%}
                <a href="#{{ block.settings.anchor | default: 'judgeme_product_reviews' }}" class="main-product__rating" {{ block.shopify_attributes }}>
                  {%- render 'rating', product: product, full: true -%}
                </a>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="main-product__price" {{ block.shopify_attributes }}>
                <span class="price-tag{% if discount > 0 %} price-tag--sale{% endif %} main-product__price-tag" data-product-price>
                  <span class="price-tag__current">{{ variant.price | money }}</span>
                  <s class="price-tag__compare"{% if discount == 0 %} hidden{% endif %}>
                    <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
                    <span data-compare-value>{{ variant.compare_at_price | money }}</span>
                  </s>
                </span>
                {%- if discount > 0 -%}
                  <span class="pill" data-discount-badge>−{{ discount }}%</span>
                {%- else -%}
                  <span class="pill" data-discount-badge hidden></span>
                {%- endif -%}
                {%- if cart.taxes_included -%}
                  <p class="main-product__tax">{{ 'products.tax_included' | t }}</p>
                {%- endif -%}
              </div>
              {%- if product.available -%}{%- render 'offer-timer', product: product, class: 'main-product__offer' -%}{%- endif -%}

            {%- when 'quantity_breaks' -%}
              {%- unless product.metafields.custom.bundle_offer.value == true -%}{%- continue -%}{%- endunless -%}
              {%- comment -%}
                Shown only on products with the metafield custom.bundle_offer ("Bundle & save") on.
                Bundle & save: up to three tiles in a row (1 item, 2 items −10%, … with the price per
                item); picking one sets the quantity
                of the form. The discount itself is an automatic discount made in the admin with the same
                quantities — the cards only show it. @ui/quantity-breaks keeps the prices in step with
                the variant and the card in step with the quantity stepper.
              {%- endcomment -%}
              {%- liquid
                assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first
                assign has_stepper = buy_block.settings.show_quantity
                assign popular = block.settings.popular | plus: 0
              -%}
              <quantity-breaks class="quantity-breaks" data-form="{{ form_id }}" {{ block.shopify_attributes }}>
                <fieldset class="quantity-breaks__group">
                  <legend class="quantity-breaks__legend">{{ block.settings.heading | escape }}</legend>
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign qty_key = 'qty_' | append: i
                      assign off_key = 'discount_' | append: i
                      assign qty = block.settings[qty_key]
                      assign off = block.settings[off_key]
                      if qty == 0
                        continue
                      endif
                      # Price per item with the discount (whole cents, rounded down)
                      assign each = 100 | minus: off | times: variant.price | divided_by: 100
                    -%}
                    <label class="quantity-breaks__option">
                      <input
                        class="quantity-breaks__input"
                        type="radio"
                        {% unless has_stepper %}name="quantity" form="{{ form_id }}"{% else %}name="quantity-break-{{ section.id }}"{% endunless %}
                        value="{{ qty }}"
                        data-discount="{{ off }}"
                        {% if forloop.first %}checked{% endif %}
                      >
                      {%- if popular == i -%}
                        <span class="pill quantity-breaks__badge">{{ 'products.quantity_breaks.popular' | t }}</span>
                      {%- endif -%}
                      <span class="quantity-breaks__title">{{ 'products.quantity_breaks.items' | t: count: qty }}</span>
                      <span class="quantity-breaks__save">
                        {%- if off > 0 -%}
                          {{ 'products.quantity_breaks.save' | t: percent: off }}
                        {%- else -%}
                          {{ 'products.quantity_breaks.standard' | t }}
                        {%- endif -%}
                      </span>
                      <span class="quantity-breaks__price">
                        <span data-break-each>{{ each | money }}</span>
                        {%- if qty > 1 -%}<span class="quantity-breaks__unit">{{ 'products.quantity_breaks.each' | t }}</span>{%- endif -%}
                      </span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              </quantity-breaks>
              <script type="module">import '@ui/quantity-breaks';</script>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="main-product__picker" {{ block.shopify_attributes }}>
                  {%- render 'variant-picker', product: product, id: section.id, low_stock: block.settings.low_stock -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="main-product__buy" {{ block.shopify_attributes }}>
                {%- if block.settings.show_stock -%}
                  {%- liquid
                    assign stock_state = 'in'
                    if variant.available == false
                      assign stock_state = 'out'
                    elsif variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= block.settings.low_stock
                      assign stock_state = 'low'
                    endif
                    assign label_in = 'products.stock_in' | t
                    assign label_low = 'products.stock_low' | t: count: '%n'
                    assign label_out = 'products.sold_out' | t
                  -%}
                  <p class="main-product__stock" data-stock data-state="{{ stock_state }}" data-in="{{ label_in | escape }}" data-low="{{ label_low | escape }}" data-out="{{ label_out | escape }}">
                    <span class="main-product__stock-dot" aria-hidden="true"></span>
                    <span data-stock-label>
                      {%- case stock_state -%}
                        {%- when 'low' -%}{{ label_low | replace: '%n', variant.inventory_quantity }}
                        {%- when 'out' -%}{{ label_out }}
                        {%- else -%}{{ label_in }}
                      {%- endcase -%}
                    </span>
                  </p>
                {%- endif -%}
                <ajax-cart-product-form data-product-form>
                  {%- form 'product', product, id: form_id, class: 'main-product__form', novalidate: 'novalidate' -%}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    <div class="main-product__actions">
                      {%- if block.settings.show_quantity -%}
                        <quantity-input class="qty main-product__qty">
                          <button type="button" class="qty__btn" data-qty="-1" aria-label="{{ 'cart.decrease' | t: product: product.title | escape }}">{%- render 'icon', name: 'minus' -%}</button>
                          <input class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'cart.quantity' | t }}">
                          <button type="button" class="qty__btn" data-qty="1" aria-label="{{ 'cart.increase' | t: product: product.title | escape }}">{%- render 'icon', name: 'plus' -%}</button>
                        </quantity-input>
                      {%- endif -%}
                      <button type="submit" class="btn btn--lg main-product__add" data-add-button{% unless variant.available %} disabled{% endunless %}>
                        <span data-add-label>
                          {%- if variant.available -%}{{ label_add }}{%- else -%}{{ label_sold_out }}{%- endif -%}
                        </span>
                      </button>
                      {%- if settings.wishlist_enabled or settings.compare_enabled -%}
                        {%- render 'saved-toggles', product: product, class: 'main-product__saved' -%}
                      {%- endif -%}
                    </div>
                    {%- if block.settings.show_dynamic_checkout -%}
                      <div class="main-product__checkout">{{ form | payment_button }}</div>
                    {%- endif -%}
                    {%- comment -%} Shop Pay Installments ("4 payments of …"): shown only where the store offers them {%- endcomment -%}
                    <div class="main-product__terms">{{ form | payment_terms }}</div>
                  {%- endform -%}
                </ajax-cart-product-form>
                {%- assign in_cart_label = 'products.in_cart_note' | t: count: '%n' -%}
                <cart-item-state class="main-product__in-cart" data-variant-id="{{ variant.id }}" data-label="{{ in_cart_label | escape }}">
                  {%- render 'icon', name: 'check' -%}
                  <span data-in-cart-label></span>
                  <a href="{{ routes.cart_url }}" data-dialog-open="CartDrawer">{{ 'cart.view_cart' | t }}</a>
                </cart-item-state>
                {%- comment -%}
                  Back in stock: for a sold-out variant, an email field sent to project-server (POST /notify,
                  <contact-form> with data-action="notify"); <stock-notify> (assets/product.js) shows it for
                  sold-out variants only and keeps the variant fields in step. Needs the API URL.
                {%- endcomment -%}
                {%- capture api -%}{% render 'api-url' %}{%- endcapture -%}
                {%- assign api = api | strip -%}
                {%- if block.settings.show_notify and api != blank -%}
                  <stock-notify class="stock-notify"{% if variant.available %} hidden{% endif %}>
                    <contact-form
                      data-endpoint="{{ api }}/notify"
                      data-action="notify"
                      {% if settings.recaptcha_site_key != blank %}
                        data-recaptcha="{{ settings.recaptcha_site_key | escape }}"
                      {% endif %}
                      data-message-error="{{ 'products.notify.error' | t | escape }}"
                      data-message-email="{{ 'forms.email' | t | escape }}"
                    >
                      <form-validate {% render 'form-validate-messages' %}>
                        <form class="stock-notify__form">
                          <p class="stock-notify__title">{%- render 'icon', name: 'mail' -%}{{ 'products.notify.title' | t }}</p>
                          <p class="stock-notify__text">{{ 'products.notify.text' | t }}</p>
                          <variant-fields data-product="{{ product.title | escape }}">
                            <input type="hidden" name="variant" value="{{ variant.id }}" data-variant-id>
                            <input type="hidden" name="product" value="{{ product.title | escape }}{% unless product.has_only_default_variant %} / {{ variant.title | escape }}{% endunless %}" data-variant-title>
                          </variant-fields>
                          <p class="form-errors" role="alert" data-contact-message></p>
                          <div class="search-form stock-notify__row">
                            <label class="visually-hidden" for="Notify-{{ section.id }}">{{ 'contact.email' | t }}</label>
                            <input class="input" type="email" id="Notify-{{ section.id }}" name="email" value="{{ customer.email }}" autocomplete="email" spellcheck="false" placeholder="{{ 'newsletter.placeholder' | t }}" required>
                            <button type="submit" class="btn">{{ 'products.notify.submit' | t }}</button>
                          </div>
                        </form>
                      </form-validate>
                      <template data-contact-success>
                        <p class="notice notice--success" role="status" tabindex="-1">
                          {%- render 'icon', name: 'check' -%}
                          {{ 'products.notify.success' | t }}
                        </p>
                      </template>
                    </contact-form>
                  </stock-notify>
                  <script type="module">
                    import '@ui/form-validate';
                    import '@ui/contact-form';
                  </script>
                {%- endif -%}
              </div>

            {%- when 'delivery' -%}
              <delivery-estimate
                class="main-product__delivery"
                data-min="{{ block.settings.min_days }}"
                data-max="{{ block.settings.max_days }}"
                data-cutoff="{{ block.settings.cutoff }}"
                data-template="{{ 'products.delivery' | t: dates: '%dates' | escape }}"
                data-template-today="{{ 'products.delivery_cutoff' | t: time: '%time', dates: '%dates' | escape }}"
                data-time-long="{{ 'delivery.time_long' | t | escape }}"
                data-time-short="{{ 'delivery.time_short' | t | escape }}"
                data-locale="{{ request.locale.iso_code }}"
                {{ block.shopify_attributes }}
              >
                {%- render 'icon', name: 'truck' -%}
                <span data-delivery-text>{{ block.settings.fallback }}</span>
              </delivery-estimate>

            {%- when 'info_links' -%}
              {%- comment -%}
                A row of small links that open a page in a popup (size guide, shipping, returns…), and
                "Ask a question": a short form about this product and its current variant. With the
                API URL it goes to project-server (POST /contact, the customer note + tag "contact");
                without it, Shopify's contact form (emailed to the store's contact email; the popup
                opens again after the post with its result). Without JS, or for a page without text (built
                from sections), a page link is a plain link.
              {%- endcomment -%}
              {%- capture api -%}{% render 'api-url' %}{%- endcapture -%}
              {%- assign api = api | strip -%}
              <div class="info-links" {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign label_key = 'label_' | append: i
                    assign icon_key = 'icon_' | append: i
                    assign page_key = 'page_' | append: i
                    assign info_page = block.settings[page_key]
                    if info_page == blank or block.settings[label_key] == blank
                      continue
                    endif
                    assign popup_id = 'Info-' | append: block.id | append: '-' | append: i
                  -%}
                  <a href="{{ info_page.url }}" class="btn btn--link info-links__link"{% if info_page.content != blank %} data-dialog-open="{{ popup_id }}"{% endif %}>
                    {%- render 'icon', name: block.settings[icon_key] -%}
                    {{- block.settings[label_key] | escape -}}
                  </a>
                  {%- if info_page.content == blank -%}{%- continue -%}{%- endif -%}
                  <dialog class="popup" id="{{ popup_id }}" aria-labelledby="{{ popup_id }}-title">
                    <div class="popup__inner">
                      <div class="popup__header">
                        <h2 class="h5" id="{{ popup_id }}-title">{{ info_page.title | escape }}</h2>
                        <button type="button" class="btn btn--icon" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
                          {%- render 'icon', name: 'close' -%}
                        </button>
                      </div>
                      <div class="popup__body rte">{{ info_page.content }}</div>
                    </div>
                  </dialog>
                {%- endfor -%}
                {%- if block.settings.show_ask -%}
                  {%- liquid
                    assign ask_id = 'Ask-' | append: block.id
                    assign name_label = 'contact.name' | t
                    assign product_label = 'products.ask.product' | t
                    capture ask_product
                      echo product.title
                      unless product.has_only_default_variant
                        echo ' / ' | append: variant.title
                      endunless
                    endcapture
                    if api != blank
                      assign name_field = 'name'
                      assign email_field = 'email'
                      assign product_field = 'subject'
                      assign body_field = 'message'
                    else
                      assign name_field = 'contact[' | append: name_label | append: ']'
                      assign email_field = 'contact[email]'
                      assign product_field = 'contact[' | append: product_label | append: ']'
                      assign body_field = 'contact[body]'
                    endif
                  -%}
                  <button type="button" class="btn btn--link info-links__link" data-dialog-open="{{ ask_id }}">
                    {%- render 'icon', name: 'chat' -%}
                    {{- 'products.ask.title' | t -}}
                  </button>
                  {%- capture ask_success -%}
                    <p class="notice notice--success" role="status" tabindex="-1">
                      {%- render 'icon', name: 'check' -%}
                      {{ 'contact.success' | t }}
                    </p>
                  {%- endcapture -%}
                  {%- capture ask_fields -%}
                    <variant-fields data-product="{{ product.title | escape }}">
                      <p class="ask-form__about">{{ 'products.ask.about' | t }} <strong data-variant-title>{{ ask_product | escape }}</strong></p>
                      <input type="hidden" name="{{ product_field }}" value="{{ ask_product | escape }}" data-variant-title>
                    </variant-fields>
                    <div class="field">
                      <label class="field__label" for="{{ ask_id }}-name">{{ name_label }}</label>
                      <input class="input" type="text" id="{{ ask_id }}-name" name="{{ name_field }}" value="{{ customer.name }}" autocomplete="name" maxlength="100">
                    </div>
                    <div class="field">
                      <label class="field__label" for="{{ ask_id }}-email">{{ 'contact.email' | t }} *</label>
                      <input class="input" type="email" id="{{ ask_id }}-email" name="{{ email_field }}" value="{{ customer.email }}" autocomplete="email" spellcheck="false" required>
                    </div>
                    <div class="field">
                      <label class="field__label" for="{{ ask_id }}-message">{{ 'products.ask.question' | t }} *</label>
                      <textarea class="input" id="{{ ask_id }}-message" name="{{ body_field }}" rows="5" maxlength="5000" required></textarea>
                    </div>
                    <button type="submit" class="btn btn--full">{{ 'contact.send' | t }}</button>
                  {%- endcapture -%}
                  <dialog class="popup" id="{{ ask_id }}" aria-labelledby="{{ ask_id }}-title">
                    <div class="popup__inner">
                      <div class="popup__header">
                        <h2 class="h5" id="{{ ask_id }}-title">{{ 'products.ask.title' | t }}</h2>
                        <button type="button" class="btn btn--icon" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
                          {%- render 'icon', name: 'close' -%}
                        </button>
                      </div>
                      <div class="popup__body">
                        <contact-form
                          {% if api != blank %}
                            data-endpoint="{{ api }}/contact"
                          {% endif %}
                          {% if settings.recaptcha_site_key != blank %}
                            data-recaptcha="{{ settings.recaptcha_site_key | escape }}"
                          {% endif %}
                          data-message-error="{{ 'contact.error' | t | escape }}"
                          data-message-email="{{ 'forms.email' | t | escape }}"
                        >
                          <form-validate {% render 'form-validate-messages' %}>
                            {%- if api != blank -%}
                              <form class="ask-form">
                                <p class="form-errors" role="alert" data-contact-message></p>
                                {{ ask_fields }}
                              </form>
                            {%- else -%}
                              {%- assign ask_form_id = ask_id | append: '-form' -%}
                              {%- form 'contact', id: ask_form_id, class: 'ask-form' -%}
                                {%- if form.posted_successfully? -%}
                                  {%- assign ask_reopen = true -%}
                                  {{ ask_success }}
                                {%- elsif form.errors -%}
                                  {%- assign ask_reopen = true -%}
                                  <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
                                {%- endif -%}
                                {{ ask_fields }}
                              {%- endform -%}
                            {%- endif -%}
                          </form-validate>
                          <template data-contact-success>{{ ask_success }}</template>
                        </contact-form>
                      </div>
                    </div>
                  </dialog>
                  <script type="module">
                    import '@ui/form-validate';
                    import '@ui/contact-form';
                  </script>
                  {%- if ask_reopen -%}
                    {%- comment -%} Back from Shopify's contact post: show its result {%- endcomment -%}
                    <script type="module">
                      import { openDialog } from '@ui/dialog';
                      openDialog(document.getElementById('{{ ask_id }}'), document.querySelector('[data-dialog-open="{{ ask_id }}"]'));
                    </script>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'pickup' -%}
              <pickup-availability class="main-product__pickup" data-root="{{ routes.root_url }}" {{ block.shopify_attributes }}>
                {%- render 'pickup-availability', variant: variant, id: section.id -%}
              </pickup-availability>

            {%- when 'meta' -%}
              {%- comment -%} Collections (the first six), product type and vendor, as links {%- endcomment -%}
              <dl class="product-meta" {{ block.shopify_attributes }}>
                {%- assign listed = product.collections -%}
                {%- if listed.size > 0 -%}
                  <div class="product-meta__row">
                    <dt>{{ 'products.meta.collections' | t }}</dt>
                    <dd>
                      {%- for item in listed limit: 6 -%}
                        <a href="{{ item.url }}">{{ item.title | escape }}</a>{% unless forloop.last %}, {% endunless %}
                      {%- endfor -%}
                    </dd>
                  </div>
                {%- endif -%}
                {%- if product.type != blank -%}
                  <div class="product-meta__row">
                    <dt>{{ 'products.meta.type' | t }}</dt>
                    <dd>{{ product.type | link_to_type }}</dd>
                  </div>
                {%- endif -%}
                {%- if product.vendor != blank -%}
                  <div class="product-meta__row">
                    <dt>{{ 'products.meta.vendor' | t }}</dt>
                    <dd>{{ product.vendor | link_to_vendor }}</dd>
                  </div>
                {%- endif -%}
              </dl>

            {%- when 'highlights' -%}
              <ul class="main-product__highlights" role="list" {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign text_key = 'text_' | append: i
                    assign icon_key = 'icon_' | append: i
                  -%}
                  {%- if block.settings[text_key] != blank -%}
                    <li class="main-product__highlight">
                      <span class="main-product__highlight-icon">{%- render 'icon', name: block.settings[icon_key] -%}</span>
                      <span>{{ block.settings[text_key] }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'text' -%}
              <div class="rte main-product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'collapsible' -%}
              {%- liquid
                case block.settings.source
                  when 'description'
                    assign body = product.description
                  when 'page'
                    assign body = block.settings.page.content
                  when 'metafield'
                    assign key_parts = block.settings.metafield | split: '.'
                    assign body = product.metafields[key_parts[0]][key_parts[1]] | metafield_tag
                  else
                    assign body = block.settings.content
                endcase
              -%}
              {%- if body != blank -%}
                <details class="accordion main-product__accordion"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    <span class="accordion__title">
                      {%- if block.settings.icon != 'none' -%}{%- render 'icon', name: block.settings.icon -%}{%- endif -%}
                      {{- block.settings.heading | escape -}}
                    </span>
                    <span class="accordion__icon" aria-hidden="true">{%- render 'icon', name: 'plus' -%}</span>
                  </summary>
                  <div class="accordion__content rte">{{ body }}</div>
                </details>
              {%- endif -%}

            {%- when 'complementary' -%}
              <product-recommendations
                class="main-product__complementary"
                data-url="{{ routes.product_recommendations_url }}?section_id=product-complementary&product_id={{ product.id }}&limit={{ block.settings.limit }}&intent=complementary"
                {{ block.shopify_attributes }}
              >
                <p class="eyebrow">{{ block.settings.heading | escape }}</p>
                <ul class="product-rows" role="list" data-recommendations></ul>
              </product-recommendations>

            {%- when 'share' -%}
              {%- assign share_url = request.origin | append: product.url -%}
              <share-button class="main-product__share" data-url="{{ share_url }}" data-title="{{ product.title | escape }}" data-copied="{{ 'products.link_copied' | t | escape }}" {{ block.shopify_attributes }}>
                <button type="button" class="btn btn--link">
                  {%- render 'icon', name: 'share' -%}
                  <span data-share-label>{{ 'blog.share' | t }}</span>
                </button>
              </share-button>

            {%- when '@app' -%}
              {%- comment -%} App blocks (star rating, reviews summary, subscriptions…) {%- endcomment -%}
              <div class="main-product__app">{% render block %}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} --------------------------------------------------------- lightbox {%- endcomment -%}
  {%- assign images = media_list | where: 'media_type', 'image' -%}
  {%- if images.size > 0 -%}
    <dialog class="popup product-lightbox" id="Lightbox-{{ section.id }}" aria-label="{{ product.title | escape }}">
      <div class="product-lightbox__inner">
        <button type="button" class="btn btn--icon product-lightbox__close" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">{%- render 'icon', name: 'close' -%}</button>
        <ul class="product-lightbox__track" role="list" data-lightbox-track>
          {%- for media in media_list -%}
            {%- if media.media_type == 'image' -%}
              {%- assign media_alt = media.alt | default: product.title -%}
              <li class="product-lightbox__item" data-index="{{ forloop.index0 }}">
                {{ media | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '1200, 1800, 2400', alt: media_alt }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </dialog>
  {%- endif -%}

  {%- comment -%}
    Sticky bar: what the main form adds — the variant ("Size / Color"), the quantity (a stepper kept
    in step with the main one from 750px; "× 2" in the text line on phones), the price and the add
    button, which submits the main form. A round up-arrow button first takes you back up to the
    options (to change the variant). <sticky-buy-bar> in assets/product.js.
  {%- endcomment -%}
  {%- if section.settings.sticky_bar -%}
    {%- assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first -%}
    <sticky-buy-bar class="sticky-buy" data-form="{{ form_id }}" hidden>
      <div class="page-width sticky-buy__inner">
        {%- assign back_label = 'products.back_to_options' | t -%}
        <button type="button" class="btn btn--icon sticky-buy__top" data-sticky-top aria-label="{{ back_label | escape }}" title="{{ back_label | escape }}">
          {%- render 'icon', name: 'arrow-right' -%}
        </button>
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', class: 'sticky-buy__image', width: 48, height: 48, alt: '' }}
        {%- endif -%}
        <div class="sticky-buy__text">
          <span class="sticky-buy__title">{{ product.title | escape }}</span>
          <span class="sticky-buy__meta">
            {%- unless product.has_only_default_variant -%}<span data-sticky-variant>{{ variant.title | escape }}</span>{%- endunless -%}
            <span class="sticky-buy__count" data-sticky-count hidden></span>
          </span>
        </div>
        {%- if buy_block.settings.show_quantity -%}
          <quantity-input class="qty sticky-buy__qty">
            <button type="button" class="qty__btn" data-qty="-1" aria-label="{{ 'cart.decrease' | t: product: product.title | escape }}">{%- render 'icon', name: 'minus' -%}</button>
            <input class="qty__input" type="number" value="1" min="1" inputmode="numeric" aria-label="{{ 'cart.quantity' | t }}" data-sticky-qty>
            <button type="button" class="qty__btn" data-qty="1" aria-label="{{ 'cart.increase' | t: product: product.title | escape }}">{%- render 'icon', name: 'plus' -%}</button>
          </quantity-input>
        {%- endif -%}
        <span class="price-tag{% if discount > 0 %} price-tag--sale{% endif %} sticky-buy__price" data-product-price>
            <span class="price-tag__current">{{ variant.price | money }}</span>
            <s class="price-tag__compare"{% if discount == 0 %} hidden{% endif %}><span data-compare-value>{{ variant.compare_at_price | money }}</span></s>
        </span>
        <button type="submit" form="{{ form_id }}" class="btn sticky-buy__button" data-add-button{% unless variant.available %} disabled{% endunless %}>
          <span data-add-label>{%- if variant.available -%}{{ label_add }}{%- else -%}{{ label_sold_out }}{%- endif -%}</span>
        </button>
      </div>
    </sticky-buy-bar>
  {%- endif -%}
</product-info>
<script type="module">
  import '@ui/variant-picker';
  import 'product';
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "main-product-section",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:sections.main_product.gallery_layout",
      "info": "t:sections.main_product.gallery_layout_info",
      "options": [
        { "value": "grid", "label": "t:sections.main_product.gallery_grid" },
        { "value": "thumbnails", "label": "t:sections.main_product.gallery_thumbnails" },
        { "value": "stacked", "label": "t:sections.main_product.gallery_stacked" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:sections.collection_list.ratio",
      "options": [
        { "value": "1", "label": "t:sections.collection_list.ratio_square" },
        { "value": "4 / 5", "label": "t:sections.collection_list.ratio_portrait" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "info_style",
      "label": "t:sections.main_product.info_style",
      "options": [
        { "value": "plain", "label": "t:sections.main_product.info_plain" },
        { "value": "card", "label": "t:sections.main_product.info_card" }
      ],
      "default": "plain"
    },
    { "type": "checkbox", "id": "breadcrumbs", "label": "t:sections.page_header.breadcrumbs", "default": true },
    { "type": "checkbox", "id": "sticky_bar", "label": "t:sections.main_product.sticky_bar", "info": "t:sections.main_product.sticky_bar_info", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "t:sections.main_product.block_vendor", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.block_title", "limit": 1 },
    {
      "type": "rating",
      "name": "t:sections.main_product.block_rating",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "t:sections.main_product.rating_info" },
        { "type": "text", "id": "anchor", "label": "t:sections.main_product.rating_anchor", "default": "judgeme_product_reviews" }
      ]
    },
    { "type": "price", "name": "t:sections.main_product.block_price", "limit": 1 },
    {
      "type": "quantity_breaks",
      "name": "t:sections.main_product.block_quantity_breaks",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "t:sections.main_product.quantity_breaks_info" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Bundle & save" },
        { "type": "range", "id": "qty_1", "label": "t:sections.main_product.break_qty_1", "min": 1, "max": 10, "step": 1, "default": 1 },
        { "type": "range", "id": "discount_1", "label": "t:sections.main_product.break_discount", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 0 },
        { "type": "range", "id": "qty_2", "label": "t:sections.main_product.break_qty_2", "min": 0, "max": 10, "step": 1, "default": 2 },
        { "type": "range", "id": "discount_2", "label": "t:sections.main_product.break_discount", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 10 },
        { "type": "range", "id": "qty_3", "label": "t:sections.main_product.break_qty_3", "min": 0, "max": 10, "step": 1, "default": 3 },
        { "type": "range", "id": "discount_3", "label": "t:sections.main_product.break_discount", "min": 0, "max": 50, "step": 1, "unit": "%", "default": 15 },
        {
          "type": "select",
          "id": "popular",
          "label": "t:sections.main_product.break_popular",
          "options": [
            { "value": "0", "label": "t:sections.main_product.break_popular_none" },
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" }
          ],
          "default": "2"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "t:sections.main_product.block_variant_picker",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "low_stock", "label": "t:sections.main_product.low_stock", "min": 1, "max": 20, "step": 1, "default": 5 }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.block_buy_buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_notify", "label": "t:sections.main_product.show_notify", "info": "t:sections.main_product.show_notify_info", "default": true },
        { "type": "checkbox", "id": "show_quantity", "label": "t:sections.main_product.show_quantity", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:sections.main_product.show_dynamic_checkout", "info": "t:sections.main_product.show_dynamic_checkout_info", "default": true },
        { "type": "checkbox", "id": "show_stock", "label": "t:sections.main_product.show_stock", "default": true },
        { "type": "range", "id": "low_stock", "label": "t:sections.main_product.low_stock", "min": 1, "max": 20, "step": 1, "default": 5 }
      ]
    },
    {
      "type": "delivery",
      "name": "t:sections.main_product.block_delivery",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "min_days", "label": "t:sections.main_product.delivery_min", "min": 0, "max": 20, "step": 1, "default": 2 },
        { "type": "range", "id": "max_days", "label": "t:sections.main_product.delivery_max", "min": 1, "max": 30, "step": 1, "default": 4 },
        { "type": "range", "id": "cutoff", "label": "t:sections.main_product.delivery_cutoff", "info": "t:sections.main_product.delivery_cutoff_info", "min": 0, "max": 23, "step": 1, "unit": "h", "default": 14 },
        { "type": "text", "id": "fallback", "label": "t:sections.main_product.delivery_fallback", "default": "Ships within 1–2 business days" }
      ]
    },
    {
      "type": "highlights",
      "name": "t:sections.main_product.block_highlights",
      "settings": [
        { "type": "select", "id": "icon_1", "label": "t:sections.main_product.icon", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "shield", "label": "Shield" }, { "value": "gift", "label": "Gift" }, { "value": "check", "label": "Check" }, { "value": "chat", "label": "Chat" }], "default": "shield" },
        { "type": "inline_richtext", "id": "text_1", "label": "t:labels.text", "default": "<strong>Secure payment</strong>, encrypted checkout" },
        { "type": "select", "id": "icon_2", "label": "t:sections.main_product.icon", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "shield", "label": "Shield" }, { "value": "gift", "label": "Gift" }, { "value": "check", "label": "Check" }, { "value": "chat", "label": "Chat" }], "default": "truck" },
        { "type": "inline_richtext", "id": "text_2", "label": "t:labels.text", "default": "<strong>Free delivery</strong> from $50" },
        { "type": "select", "id": "icon_3", "label": "t:sections.main_product.icon", "options": [{ "value": "leaf", "label": "Leaf" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "shield", "label": "Shield" }, { "value": "gift", "label": "Gift" }, { "value": "check", "label": "Check" }, { "value": "chat", "label": "Chat" }], "default": "return" },
        { "type": "inline_richtext", "id": "text_3", "label": "t:labels.text", "default": "<strong>14-day returns</strong>, easy and free" }
      ]
    },
    {
      "type": "text",
      "name": "t:labels.text",
      "settings": [{ "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Add a short note about this product.</p>" }]
    },
    {
      "type": "collapsible",
      "name": "t:sections.main_product.block_collapsible",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Description" },
        { "type": "select", "id": "icon", "label": "t:sections.main_product.icon", "options": [{ "value": "none", "label": "None" }, { "value": "leaf", "label": "Leaf" }, { "value": "truck", "label": "Truck" }, { "value": "return", "label": "Return" }, { "value": "shield", "label": "Shield" }, { "value": "chat", "label": "Chat" }, { "value": "tag", "label": "Tag" }], "default": "none" },
        {
          "type": "select",
          "id": "source",
          "label": "t:sections.main_product.collapsible_source",
