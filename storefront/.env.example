# Copy to .env.local and fill in. .env.local is git-ignored.

# Admin > Sales channels > Headless > the storefront > Storefront API: public access token
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-10

# The site's public address: canonical URLs, structured data, sitemap.xml
SITE_URL=http://localhost:3000

# Menus shown in the header and the footer (Admin > Content > Menus)
SHOPIFY_HEADER_MENU=main-menu
SHOPIFY_FOOTER_MENU=footer

# The store's time zone (Admin > Settings > General): dates typed in the theme editor are store time
SHOPIFY_TIMEZONE=America/New_York

# The theme's API secret (Theme settings > Integrations), the same as project-server's THEME_SECRET:
# signs the Spin to win prizes. Kept out of git: settings_data.json is committed without it.
THEME_SECRET=

# Admin API token (a custom app with read_products, read_content, read_files): Judge.me reviews, tax
# settings, collection sort orders and counts, page templates. Optional: the pages fall back without it.
SHOPIFY_ADMIN_TOKEN=
