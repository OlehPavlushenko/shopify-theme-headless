{% comment %}
  Collection products (templates/collection.json, under the Page header): toolbar (filters button,
  product count, sort, grid density), active filter chips, the filters panel (snippets/facets) in
  one of three layouts — sidebar, horizontal dropdowns or drawer; always a drawer on phones — and
  the product grid with an optional promo tile, then "Load more" or page numbers.
  <facet-filters> (assets/facets.js) re-renders this section through the Section Rendering API on
  every change and keeps the URL in sync; without JS the form and the links still work.
  Styles: packages/ui/css/facets.css.
{% endcomment %}
{%- liquid
  assign layout = section.settings.filters_layout
  assign form_id = 'FacetsForm-' | append: section.id
  assign panel_id = 'FacetsPanel-' | append: section.id
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
  assign has_filters = false
  if section.settings.show_filters and collection.filters.size > 0
    assign has_filters = true
  endif
  assign active_filters = 0
  for filter in collection.filters
    assign active_filters = active_filters | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_filters = active_filters | plus: 1
      endif
    endif
  endfor
  assign columns = section.settings.columns_desktop
  assign card_sizes = '(min-width: 990px) calc((100vw - 10rem) / ' | append: columns | append: '), (min-width: 750px) 33vw, 50vw'
  if has_filters and layout == 'sidebar'
    assign card_sizes = '(min-width: 990px) calc((100vw - 36rem) / ' | append: columns | append: '), (min-width: 750px) 33vw, 50vw'
  endif
  assign promo = section.blocks | where: 'type', 'promo' | first
-%}
<facet-filters
  class="main-collection facets facets--{{ layout }}{% if has_filters == false %} facets--none{% endif %} color-{{ section.settings.color_scheme }} section-spacing"
  data-section="{{ section.id }}"
>
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="page-width">
      <div class="facets__toolbar">
        {%- if has_filters -%}
          <button type="button" class="btn btn--outline btn--sm facets__toggle" popovertarget="{{ panel_id }}">
            {%- render 'icon', name: 'sliders' -%}
            {{- 'facets.filters' | t -}}
            <span class="facets__toggle-count" data-facets-active-count{% if active_filters == 0 %} hidden{% endif %}>{{ active_filters }}</span>
          </button>
        {%- endif -%}
        <p class="facets__count" data-facets-count role="status">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
        <div class="facets__tools">
          {%- if section.settings.show_sort -%}
            <label class="facets__sort">
              <span class="facets__sort-label">{{ 'facets.sort_by' | t }}</span>
              <select name="sort_by" class="facets__sort-select" form="{{ form_id }}" data-facets-sort>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
              </select>
              {%- render 'icon', name: 'chevron-down' -%}
            </label>
          {%- endif -%}
          {%- if section.settings.show_density -%}
            <div class="facets__density" role="group" aria-label="{{ 'facets.density' | t }}">
              <button type="button" class="facets__density-button facets__density-button--few" data-density="few" aria-label="{{ 'facets.density_few' | t }}" aria-pressed="false">
                <span class="facets__density-icon facets__density-icon--2" aria-hidden="true"></span>
              </button>
              <button type="button" class="facets__density-button facets__density-button--many" data-density="many" aria-label="{{ 'facets.density_many' | t }}" aria-pressed="true">
                <span class="facets__density-icon facets__density-icon--4" aria-hidden="true"></span>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="facets__active" data-facets-active>
        {%- if has_filters -%}
          {%- render 'facets-active', filters: collection.filters, clear_url: clear_url -%}
        {%- endif -%}
      </div>

      <div class="facets__layout">
        {%- if has_filters -%}
          <div id="{{ panel_id }}" class="facets__panel drawer drawer--start" popover="manual" aria-labelledby="{{ panel_id }}-title">
            <div class="drawer__inner facets__panel-inner">
              <div class="drawer__header facets__panel-header">
                <p id="{{ panel_id }}-title" class="h5">{{ 'facets.filters' | t }}</p>
                <button type="button" class="btn btn--icon" popovertarget="{{ panel_id }}" popovertargetaction="hide" aria-label="{{ 'accessibility.close' | t }}">
                  {%- render 'icon', name: 'close' -%}
                </button>
              </div>
              <div class="drawer__body facets__panel-body" data-facets-body>
                {%- comment -%} The toolbar select joins the form (form="…"); without it the current sort rides along hidden {%- endcomment -%}
                {%- liquid
                  assign hidden_sort = nil
                  unless section.settings.show_sort
                    assign hidden_sort = sort_by
                  endunless
                -%}
                {%- render 'facets', filters: collection.filters, form_id: form_id, layout: layout, sort_by: hidden_sort -%}
              </div>
              <div class="drawer__footer facets__panel-footer">
                <a href="{{ clear_url }}" class="btn btn--outline" data-facets-link>{{ 'facets.clear_all' | t }}</a>
                <button type="button" class="btn" popovertarget="{{ panel_id }}" popovertargetaction="hide" data-facets-show>
                  {{- 'facets.show_results' | t: count: collection.products_count -}}
                </button>
              </div>
            </div>
          </div>
        {%- endif -%}

        <div class="facets__results" data-facets-results>
          {%- if collection.products.size > 0 -%}
            {%- comment -%} Heading order h1 (page header) → h2 → h3 (cards) {%- endcomment -%}
            <h2 class="visually-hidden">{{ 'facets.products_heading' | t }}</h2>
            <ul
              id="ProductGrid-{{ section.id }}"
              class="grid facets__grid"
              role="list"
              style="--cols: {{ columns }}; --cols-few: {{ columns | minus: 1 | at_least: 2 }}; --cols-mobile: {{ section.settings.columns_mobile }};"
              data-facets-grid
            >
              {%- for product in collection.products -%}
                {%- if promo and paginate.current_page == 1 and forloop.index == promo.settings.position -%}
                  <li class="facets__promo" {{ promo.shopify_attributes }}>
                    {%- render 'promo-card',
                      url: promo.settings.link,
                      image: promo.settings.image,
                      eyebrow: promo.settings.eyebrow,
                      heading: promo.settings.heading,
                      text: promo.settings.text,
                      link_label: promo.settings.link_label,
                      layout: 'overlay',
                      ratio: '4 / 5',
                      sizes: card_sizes
                    -%}
                  </li>
                {%- endif -%}
                {%- liquid
                  assign eager = false
                  if paginate.current_page == 1 and forloop.index <= columns
                    assign eager = true
                  endif
                -%}
                <li data-facets-item>
                  {%- render 'product-card',
                    product: product,
                    eager: eager,
                    sizes: card_sizes,
                    quick_add: section.settings.quick_add,
                    show_vendor: section.settings.show_vendor
                  -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {%- if section.settings.pagination == 'load_more' -%}
                <div class="facets__more" data-facets-more>
                  <p class="facets__progress">
                    {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
                    {{ 'facets.progress' | t: shown: shown, total: paginate.items }}
                  </p>
                  <span class="facets__progress-bar" style="--progress: {{ shown | times: 100 | divided_by: paginate.items }}%;" aria-hidden="true"></span>
                  {%- if paginate.next -%}
                    <a href="{{ paginate.next.url }}" class="btn btn--outline" data-facets-load-more>{{ 'facets.load_more' | t }}</a>
                  {%- endif -%}
                </div>
              {%- else -%}
                {%- render 'pagination', paginate: paginate, anchor: '' -%}
              {%- endif -%}
            {%- endif -%}
          {%- else -%}
            <div class="facets__empty">
              {%- render 'icon', name: 'search' -%}
              {%- if active_filters > 0 -%}
                <p class="h5">{{ 'facets.no_results' | t }}</p>
                <p>{{ 'facets.no_results_text' | t }}</p>
                <a href="{{ clear_url }}" class="btn" data-facets-link>{{ 'facets.clear_all' | t }}</a>
              {%- else -%}
                <p class="h5">{{ 'collections.empty' | t }}</p>
                <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue_shopping' | t }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endpaginate -%}
</facet-filters>
<script type="module">import 'facets';</script>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "class": "main-collection-section",
  "settings": [
    { "type": "header", "content": "t:sections.main_collection.filters_header" },
    { "type": "checkbox", "id": "show_filters", "label": "t:sections.main_collection.show_filters", "info": "t:sections.main_collection.show_filters_info", "default": true },
    {
      "type": "select",
      "id": "filters_layout",
      "label": "t:sections.main_collection.filters_layout",
      "info": "t:sections.main_collection.filters_layout_info",
      "options": [
        { "value": "sidebar", "label": "t:sections.main_collection.layout_sidebar" },
        { "value": "horizontal", "label": "t:sections.main_collection.layout_horizontal" },
        { "value": "drawer", "label": "t:sections.main_collection.layout_drawer" }
      ],
      "default": "sidebar"
    },
    { "type": "checkbox", "id": "show_sort", "label": "t:sections.main_collection.show_sort", "default": true },
    { "type": "checkbox", "id": "show_density", "label": "t:sections.main_collection.show_density", "default": true },
    { "type": "header", "content": "t:sections.main_collection.grid_header" },
    { "type": "range", "id": "products_per_page", "label": "t:sections.main_collection.products_per_page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.main_collection.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.main_collection.pagination",
      "options": [
        { "value": "load_more", "label": "t:sections.main_collection.pagination_load_more" },
        { "value": "pages", "label": "t:sections.main_collection.pagination_pages" }
      ],
      "default": "load_more"
    },
    { "type": "checkbox", "id": "quick_add", "label": "t:sections.product_list.quick_add", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.main_search.show_vendor", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "t:sections.main_collection.promo",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "position", "label": "t:sections.main_collection.promo_position", "info": "t:sections.main_collection.promo_position_info", "min": 1, "max": 24, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "image", "label": "t:sections.hero.image" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.promo_popup.eyebrow", "default": "Gift ideas" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Ready-to-give sets" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "Free gift wrapping on every order" },
        { "type": "text", "id": "link_label", "label": "t:labels.button_label", "default": "Shop sets" },
        { "type": "url", "id": "link", "label": "t:labels.button_link" }
      ]
    }
  ]
}
{% endschema %}
