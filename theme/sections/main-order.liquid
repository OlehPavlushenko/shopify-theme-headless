{% comment %}
  Order (templates/customers/order.json): back to the account, the order number, date and status
  pills, the products (image, name, options, quantity, price, the tracking link when shipped), the
  totals, and the shipping and billing addresses. Styles: packages/ui/css/account.css.
{% endcomment %}
<div class="account color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width account__inner">
    <header class="account__head">
      <div class="account__hello">
        <a href="{{ routes.account_url }}" class="account__back">
          {%- render 'icon', name: 'arrow-left' -%}
          {{- 'customers.order.back' | t -}}
        </a>
        <h1 class="h2">{{ 'customers.order.title' | t: name: order.name }}</h1>
        {%- assign placed_date = order.created_at | time_tag: format: 'date_at_time' -%}
        <p class="account__meta">{{ 'customers.order.placed_html' | t: date: placed_date }}</p>
        <p class="account-order__status">{%- render 'account-status', order: order -%}</p>
        {%- if order.cancelled -%}
          {%- assign cancelled_date = order.cancelled_at | time_tag: format: 'date' -%}
          <p class="account__meta">{{ 'customers.order.cancelled_on_html' | t: date: cancelled_date }}</p>
        {%- endif -%}
      </div>
      {%- render 'account-nav' -%}
    </header>

    <div class="account__layout">
      <section class="account__main" aria-labelledby="OrderItems">
        <h2 id="OrderItems" class="h4">{{ 'customers.order.items' | t: count: order.item_count }}</h2>
        <ul class="account-items" role="list">
          {%- for item in order.line_items -%}
            <li class="account-item">
              <span class="account-item__media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 80, height: 80, alt: item.title }}
                {%- endif -%}
              </span>
              <span class="account-item__info">
                {%- if item.product.url != blank -%}
                  <a href="{{ item.product.url }}" class="account-item__title">{{ item.product.title | default: item.title | escape }}</a>
                {%- else -%}
                  <span class="account-item__title">{{ item.title | escape }}</span>
                {%- endif -%}
                {%- unless item.product.has_only_default_variant -%}
                  <span class="account__meta">{{ item.variant.title | escape }}</span>
                {%- endunless -%}
                <span class="account__meta">{{ 'customers.order.quantity' | t: count: item.quantity }} × {{ item.final_price | money }}</span>
                {%- if item.fulfillment -%}
                  <span class="account-item__shipped">
                    {%- render 'icon', name: 'truck' -%}
                    {%- assign shipped_date = item.fulfillment.created_at | time_tag: format: 'date' -%}
                    {{ 'customers.order.shipped_html' | t: date: shipped_date }}
                    {%- if item.fulfillment.tracking_url -%}
                      · <a href="{{ item.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ 'customers.order.track' | t }}</a>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </span>
              <span class="account-item__total">{{ item.final_line_price | money }}</span>
            </li>
          {%- endfor -%}
        </ul>

        <dl class="account-totals">
          <div><dt>{{ 'customers.order.subtotal' | t }}</dt><dd>{{ order.line_items_subtotal_price | money }}</dd></div>
          {%- for discount in order.cart_level_discount_applications -%}
            <div class="account-totals__discount"><dt>{{ discount.title | escape }}</dt><dd>−{{ discount.total_allocated_amount | money }}</dd></div>
          {%- endfor -%}
          {%- for line in order.shipping_methods -%}
            <div><dt>{{ 'customers.order.shipping' | t }} · {{ line.title | escape }}</dt><dd>{{ line.price | money }}</dd></div>
          {%- endfor -%}
          {%- for tax in order.tax_lines -%}
            <div><dt>{{ tax.title | escape }} ({{ tax.rate_percentage }}%)</dt><dd>{{ tax.price | money }}</dd></div>
          {%- endfor -%}
          <div class="account-totals__total"><dt>{{ 'customers.order.total' | t }}</dt><dd>{{ order.total_price | money_with_currency }}</dd></div>
        </dl>
      </section>

      <aside class="account__side">
        {%- if order.shipping_address -%}
          <div class="account-panel">
            <div class="account-panel__body">
              <h2 class="h5">{{ 'customers.order.shipping_address' | t }}</h2>
              <address class="account-address__text">{{ order.shipping_address | format_address }}</address>
            </div>
          </div>
        {%- endif -%}
        {%- if order.billing_address -%}
          <div class="account-panel">
            <div class="account-panel__body">
              <h2 class="h5">{{ 'customers.order.billing_address' | t }}</h2>
              <address class="account-address__text">{{ order.billing_address | format_address }}</address>
            </div>
          </div>
        {%- endif -%}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.account.order",
  "class": "main-order-section",
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }]
}
{% endschema %}
