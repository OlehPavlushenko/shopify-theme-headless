{% doc %}
  Product card used across the theme: collection grids, search, product lists, mega menu.
  Shows the featured image (second image on hover), sale / sold-out badge, vendor, title, price.
  Styles: packages/ui/css/product-card.css.

  @param {object} product - Product
  @param {boolean} [show_vendor] - Show the vendor above the title
  @param {boolean} [show_secondary_image] - Swap to the second image on hover (default true)
  @param {string} [sizes] - sizes attribute for the image (default: grid of 2 / 4 columns)
  @param {boolean} [eager] - Load the image eagerly (first row above the fold)
  @param {string} [heading_tag] - Title element (default h3)
  @param {boolean} [compact] - Smaller type and spacing (search panel, mini lists)
{% enddoc %}
{%- liquid
  assign media = product.featured_media
  assign second = product.media[1]
  comment
    Not `| default: true`: Liquid's default also replaces an explicit false.
  endcomment
  if show_secondary_image == false or second == blank or second.media_type != 'image'
    assign second = null
  endif
  assign image_sizes = sizes | default: '(min-width: 990px) calc((100vw - 10rem) / 4), (min-width: 750px) calc((100vw - 6rem) / 3), calc((100vw - 4rem) / 2)'
  assign tag = heading_tag | default: 'h3'
  if eager
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  if variant.compare_at_price > variant.price
    assign on_sale = true
  endif
-%}
<article class="product-card{% if second %} product-card--hover{% endif %}{% if compact %} product-card--compact{% endif %}">
  <a href="{{ product.url }}" class="product-card__media frame" style="--frame-ratio: 1;" tabindex="-1" aria-hidden="true">
    {%- if media -%}
      {{
        media.preview_image
        | image_url: width: 800
        | image_tag:
          class: 'product-card__image',
          loading: loading,
          sizes: image_sizes,
          widths: '240, 360, 480, 640, 800',
          alt: media.alt
      }}
      {%- if second -%}
        {{
          second.preview_image
          | image_url: width: 800
          | image_tag:
            class: 'product-card__image product-card__image--secondary',
            loading: 'lazy',
            sizes: image_sizes,
            widths: '240, 360, 480, 640, 800',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
    {%- endif -%}
  </a>

  {%- if product.available == false -%}
    <span class="pill pill--soft product-card__badge">{{ 'products.sold_out' | t }}</span>
  {%- elsif on_sale -%}
    <span class="pill product-card__badge">{{ 'products.sale' | t }}</span>
  {%- endif -%}

  <div class="product-card__info">
    {%- if show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor | escape }}</p>
    {%- endif -%}
    <{{ tag }} class="product-card__title">
      <a href="{{ product.url }}" class="product-card__link">{{ product.title | escape }}</a>
    </{{ tag }}>
    {%- render 'price', product: product -%}
  </div>
</article>
