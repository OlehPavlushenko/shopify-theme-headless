{% doc %}
  Extra content inside a mega menu, from a header block. Same patterns as the search panel:
  - menu_promo: image card with heading, text and a link
  - menu_products: product slider (.slider + product-card), eyebrow heading and arrows

  @param {object} block - Header block of type menu_promo or menu_products
{% enddoc %}
{%- case block.type -%}
  {%- when 'menu_promo' -%}
    <a href="{{ block.settings.link | default: routes.root_url }}" class="mega-promo" {{ block.shopify_attributes }}>
      <span class="mega-promo__media frame" style="--frame-ratio: 4 / 3;">
        {%- if block.settings.image -%}
          {{
            block.settings.image
            | image_url: width: 800
            | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 280px, 100vw', alt: block.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </span>
      {%- if block.settings.heading != blank -%}
        <span class="label mega-promo__heading">{{ block.settings.heading | escape }}</span>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <span class="text-sm muted">{{ block.settings.text | escape }}</span>
      {%- endif -%}
      {%- if block.settings.link_label != blank -%}
        <span class="mega-promo__cta">
          {{- block.settings.link_label | escape -}}
          {%- render 'icon', name: 'arrow-right' -%}
        </span>
      {%- endif -%}
    </a>

  {%- when 'menu_products' -%}
    {%- if block.settings.products.count > 0 -%}
      <ui-slider class="slider mega-slider" {{ block.shopify_attributes }}>
        <div class="slider__head">
          <p class="eyebrow">{{ block.settings.heading | escape }}</p>
          <div class="slider__head-end">
            {%- render 'slider-nav', label: block.settings.heading -%}
          </div>
        </div>
        <ul class="slider__track" data-slider-track role="list">
          {%- for product in block.settings.products -%}
            <li>
              {%- render 'product-card',
                product: product,
                show_secondary_image: false,
                sizes: '(min-width: 990px) 200px, 45vw',
                heading_tag: 'p'
              -%}
            </li>
          {%- endfor -%}
        </ul>
      </ui-slider>
    {%- endif -%}
{%- endcase -%}
