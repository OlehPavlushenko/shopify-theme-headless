{% doc %}
  Product card used across the theme: collection grids, search, product lists, mega menu.
  Shows the featured image (second image on hover), a sold-out / "Offer" / "−X%" / sale badge (else
  the product's label, metafield custom.label), vendor, title, rating, price, an offer timer and the
  first option's values on one line: color swatches (5 at most, then "+N") or text ("50 ml · 100 ml",
  cut with an ellipsis), sold-out ones faded / struck through. Theme settings > Product cards: image
  shape and fit, second image, label, vendor, rating, values, timer.
  Styles: packages/ui/css/product-card.css.

  @param {object} product - Product
  @param {boolean} [show_vendor] - Show the vendor above the title (also on with Theme settings)
  @param {boolean} [show_secondary_image] - Swap to the second image on hover (default true)
  @param {string} [sizes] - sizes attribute for the image (default: grid of 2 / 4 columns)
  @param {boolean} [eager] - Load the image eagerly (first row above the fold)
  @param {string} [heading_tag] - Title element (default h3)
  @param {boolean} [actions] - Wishlist / compare buttons over the image (default true; false in
    small cards: menus, search suggestions, popups, cart)
  @param {boolean} [quick_add] - Add button under the price: one-click Ajax add for single-variant
    products (Liquid Ajax Cart) that turns into "− 2 in cart +" once added (<cart-item-state>,
    cart.js); a link to the product page for products with options
{% enddoc %}
{%- liquid
  assign media = product.featured_media
  assign media_alt = media.alt | default: product.title
  assign second = product.media[1]
  comment
    Not `| default: true`: Liquid's default also replaces an explicit false.
  endcomment
  if show_secondary_image == false or settings.card_secondary_image == false or second == blank or second.media_type != 'image'
    assign second = null
  endif
  assign image_sizes = sizes | default: '(min-width: 990px) calc((100vw - 10rem) / 4), (min-width: 750px) calc((100vw - 6rem) / 3), calc((100vw - 4rem) / 2)'
  assign tag = heading_tag | default: 'h3'
  if eager
    assign loading = 'eager'
  else
    assign loading = 'lazy'
  endif
  assign variant = product.selected_or_first_available_variant
  # Badge: "−X%" when the shown variant is discounted, "Sale" when only another variant is
  capture discount
    render 'discount-percent', price: variant.price, compare_at: variant.compare_at_price
  endcapture
  assign discount = discount | strip | plus: 0
  assign on_sale = false
  if discount == 0 and product.compare_at_price_max > product.price_min
    assign on_sale = true
  endif
  # Already in the cart: single-variant products get a quantity control instead of the add button,
  # products with options a dark "✓ In cart" button (any of their variants in the cart)
  assign in_cart = 0
  if quick_add and cart.item_count > 0
    assign in_cart = cart.items | where: 'product_id', product.id | map: 'quantity' | sum
  endif
  assign in_cart_label = 'products.in_cart' | t: count: '%n'
  # Image shape: a ratio, or the first image's own
  assign ratio = settings.card_image_ratio | default: '1'
  if ratio == 'natural'
    assign ratio = media.preview_image.aspect_ratio | default: 1
  endif
-%}
<article class="product-card{% if second %} product-card--hover{% endif %}">
  <div class="product-card__media frame" style="--frame-ratio: {{ ratio }};{% if settings.card_image_fit == 'contain' %} --frame-fit: contain;{% endif %}">
    {%- if media -%}
      {{
        media.preview_image
        | image_url: width: 800
        | image_tag:
          class: 'product-card__image',
          loading: loading,
          sizes: image_sizes,
          widths: '240, 360, 480, 640, 800',
          alt: media_alt
      }}
      {%- if second -%}
        {{
          second.preview_image
          | image_url: width: 800
          | image_tag:
            class: 'product-card__image product-card__image--secondary',
            loading: 'lazy',
            sizes: image_sizes,
            widths: '240, 360, 480, 640, 800',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
    {%- endif -%}
  </div>

  {%- comment -%} One link over the whole card; buttons inside the card sit above it {%- endcomment -%}
  <a href="{{ product.url }}" class="product-card__overlay" aria-label="{{ product.title | escape }}"></a>

  {%- unless actions == false -%}
    {%- render 'saved-toggles', product: product, class: 'product-card__actions' -%}
  {%- endunless -%}

  {%- liquid
    # A limited offer (metafield custom.offer_ends ahead): the "Offer" badge and a timer under the price
    assign offer_end = product.metafields.custom.offer_ends.value | date: '%s' | plus: 0
    assign now = 'now' | date: '%s' | plus: 0
    assign offer_active = false
    if offer_end > now
      assign offer_active = true
    endif
  -%}
  {%- if product.available == false -%}
    <span class="pill pill--soft product-card__badge">{{ 'products.sold_out' | t }}</span>
  {%- elsif offer_active -%}
    <span class="pill pill--offer product-card__badge">{{ 'products.offer.badge' | t }}</span>
  {%- elsif discount > 0 -%}
    <span class="pill product-card__badge">−{{ discount }}%</span>
  {%- elsif on_sale -%}
    <span class="pill product-card__badge">{{ 'products.sale' | t }}</span>
  {%- elsif settings.card_show_label and product.metafields.custom.label.value != blank -%}
    <span class="pill pill--soft product-card__badge">{{ product.metafields.custom.label.value | escape }}</span>
  {%- endif -%}

  <div class="product-card__info">
    {%- if show_vendor or settings.card_show_vendor -%}{%- if product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor | escape }}</p>
    {%- endif -%}{%- endif -%}
    <{{ tag }} class="product-card__title line-clamp">{{ product.title | escape }}</{{ tag }}>
    {%- if settings.card_show_rating -%}{%- render 'rating', product: product, class: 'product-card__rating' -%}{%- endif -%}
    {%- render 'price', product: product -%}
    {%- if product.available and settings.card_show_timer -%}{%- render 'offer-timer', product: product, class: 'product-card__offer', active: offer_active -%}{%- endif -%}
    {%- unless product.has_only_default_variant or settings.card_show_options == false -%}
      {%- liquid
        assign option = product.options_with_values.first
        capture is_color
          render 'option-is-color', option: option
        endcapture
        assign swatches = false
        if is_color contains 'true'
          assign swatches = true
        endif
        # Swatches: one row of 5 at most, then "+N"; text values: all of them on one line (ellipsis)
        assign shown = 50
        if swatches
          assign shown = 5
        endif
      -%}
      <ul class="product-card__values{% if swatches %} product-card__values--swatches{% endif %}" role="list" aria-label="{{ option.name | escape }}">
        {%- for value in option.values limit: shown -%}
          <li class="product-card__value{% unless value.available %} product-card__value--unavailable{% endunless %}">
            {%- if swatches -%}
              {%- render 'swatch', value: value -%}
            {%- else -%}
              <span>{{- value | escape -}}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- if option.values.size > shown -%}
          <li class="product-card__value product-card__value--more">+{{ option.values.size | minus: shown }}</li>
        {%- endif -%}
      </ul>
    {%- endunless -%}
  </div>

  {%- if quick_add and product.available -%}
    <div class="product-card__quick-add">
      {%- if product.has_only_default_variant -%}
        <cart-item-state
          class="product-card__cart"
          data-variant-id="{{ variant.id }}"
          data-label="{{ in_cart_label | escape }}"
          {% if in_cart > 0 %}
            data-in-cart
          {% endif %}
        >
          <ajax-cart-product-form>
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button type="submit" class="btn btn--outline btn--sm btn--full">
                {%- render 'icon', name: 'plus' -%}
                {{- 'products.add_to_cart' | t -}}
              </button>
            {%- endform -%}
          </ajax-cart-product-form>
          <div class="product-card__in-cart">
            <button type="button" class="product-card__step" data-step="-1" aria-label="{{ 'cart.decrease' | t: product: product.title | escape }}">
              {%- render 'icon', name: 'minus' -%}
            </button>
            <span class="product-card__in-cart-label" data-in-cart-label aria-live="polite">
              {{- in_cart_label | replace: '%n', in_cart -}}
            </span>
            <button type="button" class="product-card__step" data-step="1" aria-label="{{ 'cart.increase' | t: product: product.title | escape }}">
              {%- render 'icon', name: 'plus' -%}
            </button>
          </div>
        </cart-item-state>
      {%- else -%}
        {%- comment -%}
          In the cart: the button turns dark and reads "✓ In cart" (it still opens quick view). No number:
          the product's lines may be different variants — quick view shows each variant's quantity.
        {%- endcomment -%}
        {%- assign in_cart_short = 'products.in_cart_short' | t -%}
        <cart-item-state
          class="product-card__cart"
          data-product-id="{{ product.id }}"
          data-label="{{ in_cart_short | escape }}"
          {% if in_cart > 0 %}
            data-in-cart
          {% endif %}
        >
          <a href="{{ product.url }}" class="btn btn--outline btn--sm btn--full product-card__options" data-quick-view aria-haspopup="dialog">
            <span class="product-card__options-label">{{ 'products.choose_options' | t }}</span>
            <span class="product-card__options-in-cart">
              {%- render 'icon', name: 'check' -%}
              <span data-in-cart-label>{{ in_cart_short }}</span>
            </span>
          </a>
        </cart-item-state>
      {%- endif -%}
    </div>
  {%- endif -%}
</article>
