{% doc %}
  A form's errors as one alert above its fields (customer forms). Renders nothing without errors.
  Styles: .form-errors in packages/ui/css/components.css.

  @param {object} errors - form.errors
{% enddoc %}
{%- if errors -%}
  <div class="form-errors" role="alert" tabindex="-1" autofocus>
    {{ errors | default_errors }}
  </div>
{%- endif -%}
