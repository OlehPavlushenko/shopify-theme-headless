{
  "$description": "Design tokens (style direction: Studio). Single source of default values. build.mjs turns every leaf into a CSS custom property named after its path (\"DEFAULT\" adds no suffix): color.accent -> --color-accent, ease.DEFAULT -> --ease. The Shopify theme overrides colors, fonts, page width and radii from Theme settings; a headless storefront uses these defaults or its own overrides.",
  "color": {
    "background": "#fbfaf7",
    "background-gradient": "none",
    "foreground": "#3d4440",
    "heading": "#1b2a23",
    "link-hover": "#2f6b4f",
    "accent": "#2f6b4f",
    "accent-2": "#c9772b",
    "surface": "#efeee8",
    "border": "#e1dfd6",
    "button": "#1b2a23",
    "button-label": "#fbfaf7",
    "button-hover": "#2f6b4f",
    "button-label-hover": "#fbfaf7",
    "button-secondary": "#dfe8df",
    "button-secondary-label": "#1b2a23",
    "input-background": "#ffffff",
    "input-text": "#1b2a23",
    "success": "#2f7d4f",
    "info": "#2c5e9e",
    "warning": "#b8742a",
    "danger": "#b3261e",
    "focus": "#2f6b4f"
  },
  "font": {
    "body-family": "'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "body-style": "normal",
    "body-weight": "400",
    "body-weight-bold": "600",
    "heading-family": "'Bricolage Grotesque', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "heading-style": "normal",
    "heading-weight": "700",
    "body-scale": "1",
    "heading-scale": "1"
  },
  "text": {
    "xs": "1.2rem",
    "sm": "1.4rem",
    "md": "1.6rem",
    "lg": "1.8rem",
    "xl": "clamp(2rem, 1.7rem + 0.8vw, 2.4rem)",
    "2xl": "clamp(2.4rem, 1.9rem + 1.4vw, 3.2rem)",
    "3xl": "clamp(3rem, 2.1rem + 2.4vw, 4.4rem)",
    "4xl": "clamp(3.6rem, 2.2rem + 3.8vw, 6rem)"
  },
  "leading": {
    "tight": "1.08",
    "snug": "1.25",
    "normal": "1.6"
  },
  "tracking": {
    "heading": "-0.02em",
    "label": "0.02em"
  },
  "page-width": {
    "DEFAULT": "144rem",
    "narrow": "86rem"
  },
  "gutter": {
    "DEFAULT": "clamp(1.6rem, 4vw, 4.8rem)"
  },
  "space": {
    "2xs": "0.4rem",
    "xs": "0.8rem",
    "s": "1.2rem",
    "m": "1.6rem",
    "l": "2.4rem",
    "xl": "3.2rem",
    "2xl": "4.8rem",
    "3xl": "6.4rem",
    "4xl": "9.6rem"
  },
  "control": {
    "height": "4.8rem",
    "height-sm": "4rem"
  },
  "radius": {
    "button": "40px",
    "input": "12px",
    "card": "20px",
    "media": "20px",
    "badge": "40px"
  },
  "shadow": {
    "sm": "0 1px 2px rgb(27 42 35 / 0.06), 0 1px 1px rgb(27 42 35 / 0.04)",
    "md": "0 8px 24px rgb(27 42 35 / 0.08)",
    "overlay": "0 24px 64px rgb(27 42 35 / 0.18)"
  },
  "duration": {
    "short": "120ms",
    "default": "220ms",
    "long": "420ms"
  },
  "ease": {
    "DEFAULT": "cubic-bezier(0.2, 0, 0, 1)",
    "out": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
