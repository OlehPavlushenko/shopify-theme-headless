{% doc %}
  Article card: cover image, date and reading time, title and an optional excerpt; the whole card is
  one link. Used by the Blog posts section and the blog page. Styles: packages/ui/css/sections.css.

  @param {object} article - Article
  @param {boolean} [show_date] - Show the publish date and reading time (default true)
  @param {boolean} [show_excerpt] - Show the excerpt (default true)
  @param {string} [layout] - 'featured': image beside the text, bigger title (the blog's newest article)
  @param {string} [heading_tag] - Title element (default h3; h2 on the blog page)
  @param {string} [sizes] - Image sizes attribute
{% enddoc %}
{%- liquid
  assign image_alt = article.image.alt | default: ''
  assign tag = heading_tag | default: 'h3'
  # Reading time at ~200 words a minute
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
-%}
<a href="{{ article.url }}" class="article-card{% if layout == 'featured' %} article-card--featured{% endif %}">
  <span class="frame article-card__media" style="--frame-ratio: 3 / 2;">
    {%- if article.image -%}
      {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: sizes, widths: '450, 600, 900, 1200', alt: image_alt }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </span>
  <span class="article-card__body">
    {%- unless show_date == false -%}
      <span class="article-card__date">
        {{- article.published_at | time_tag: format: 'date' }} · {{ 'blog.reading_time' | t: count: minutes -}}
      </span>
    {%- endunless -%}
    <{{ tag }} class="{% if layout == 'featured' %}h3{% else %}h5{% endif %} article-card__title">{{ article.title | escape }}</{{ tag }}>
    {%- unless show_excerpt == false -%}
      <span class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</span>
    {%- endunless -%}
    <span class="article-card__more">
      {{- 'blog.read_more' | t -}}
      {%- render 'icon', name: 'arrow-right' -%}
    </span>
  </span>
</a>
