{% doc %}
  Article card: cover image, date, title and an optional excerpt; the whole card is one link.
  Used by the blog posts section (and the blog page later). Styles: packages/ui/css/sections.css.

  @param {object} article - Article
  @param {boolean} [show_date] - Show the publish date (default true)
  @param {boolean} [show_excerpt] - Show the excerpt (default true)
  @param {string} [sizes] - Image sizes attribute
{% enddoc %}
{%- assign image_alt = article.image.alt | default: '' -%}
<a href="{{ article.url }}" class="article-card">
  <span class="frame article-card__media" style="--frame-ratio: 3 / 2;">
    {%- if article.image -%}
      {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: sizes, widths: '450, 600, 900', alt: image_alt }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </span>
  {%- unless show_date == false -%}
    <span class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</span>
  {%- endunless -%}
  <span class="h5 article-card__title">{{ article.title | escape }}</span>
  {%- unless show_excerpt == false -%}
    <span class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</span>
  {%- endunless -%}
  <span class="article-card__more">
    {{- 'blog.read_more' | t -}}
    {%- render 'icon', name: 'arrow-right' -%}
  </span>
</a>
