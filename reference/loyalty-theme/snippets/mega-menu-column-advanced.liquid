{% liquid
    assign menu_item_title = block.settings.title | handleize
    assign current_link_title = link.title | handleize
    assign img_size = block.settings.img_size
    assign dropdown_width = block.settings.dropdown_width
    assign dropdown_position = block.settings.position
    assign product_title = block.settings.prod_title
    assign collection = collections[block.settings.products]
    assign limit = block.settings.prod_limit
%}

{% if menu_item_title == current_link_title %}
    {% capture mega_menu_dropdown %}
        {% for i in (i..3) %}

            {% liquid
                assign current_column_title = 'column_menu_title_' | append: forloop.index
                assign current_column_menu = 'column_menu_' | append: forloop.index
                assign current_column_url = 'column_link_' | append: forloop.index
                assign current_columnt_image = 'column_menu_image_' | append: forloop.index

                assign column_title = block.settings[current_column_title]
                assign column_menu = block.settings[current_column_menu]
                assign column_url = block.settings[current_column_url]
                assign column_image = block.settings[current_columnt_image]
            %}

            {% if column_menu.links.size > 0 %}
                <div class='mega-menu__item-submenu--links'>
                    {% if column_title != blank %}
                        <div class='mega-menu__list-title'>
                            <a class='not-link' href='#'>{{ column_title | escape }}</a>
                        </div>
                    {% endif %}

                    {% if column_image != blank %}
                        <picture class='mega-menu__media media media__size--{{ img_size }}'>
                        {% if column_url.size > 0 %}
                            <a href='{{ column_url }}'>
                                {% render 'image', image_box: column_image, image_box_class: 'mega-menu__image' %}
                            </a>
                        {% else %}
                            {% render 'image', image_box: column_image, image_box_class: 'mega-menu__image' %}
                        {% endif %}
                        </picture>
                    {% endif %}

                    <div class='mega-menu__submenu' tabindex='-1'>
                        
                        <ul class='mega-menu__list list-style-none'>
                        {% for mega_menu_link in column_menu.links %}

                        {% liquid
                            if mega_menu_link.title contains ';'
                            assign badge = mega_menu_link.title | split: ';'
                            assign title = badge[0] | split: '["'
                            assign badge_name = badge[1]
                            assign badge_color = badge[2] | split: '"]'

                            else

                            assign title = mega_menu_link.title
                            assign badge_name = ''
                            assign badge_color = ''
                            endif
                        %}

                        <li class='mega-menu__list-item'>
                            <a class='mega-menu__list-link{% if mega_menu_link.current %} mega-menu__list-link--active{% endif %}' href='{{ mega_menu_link.url }}'>
                                {{- title -}}
                                {% if badge_name != blank %}
                                <span style='background:{{ badge_color }};' class='mega-menu__list-badge'>{{ badge_name }}</span>
                                {% endif %}
                            </a>
                        </li>
                        {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% endcapture %}

    {% if mega_menu_dropdown != blank %}
        {%- liquid 
            assign mega_menu_background_color = block.settings.background_color
            assign ban_image_size = block.settings.ban_img_size
            assign ban_text_color = block.settings.ban_text_color
        -%}

        {% capture mega_menu_styles %}
            --mega-menu-advanced-background-color: {{ mega_menu_background_color }};
            --mega-menu-advanced-banner-text-color: {{ ban_text_color }};
        {% endcapture %}

        {% capture mega_menu_media %}
            {% for i in (i..1) %}

            {% liquid
                assign current_ban_image = 'ban_image_' | append: forloop.index
                assign current_ban_subtitle = 'ban_subtitle_' | append: forloop.index
                assign current_ban_title = 'ban_title_' | append: forloop.index
                assign current_ban_button = 'ban_button_' | append: forloop.index
                assign current_ban_link = 'ban_link_' | append: forloop.index

                assign ban_image = block.settings[current_ban_image]
                assign ban_subtitle = block.settings[current_ban_subtitle]
                assign ban_title = block.settings[current_ban_title]
                assign ban_button = block.settings[current_ban_button]
                assign ban_link = block.settings[current_ban_link]
            %}

            {% if ban_image != blank %}
                <div class="mega-menu__column-image">
                    <picture class="mega-menu__image-media media__size--{{ ban_image_size }} media">
                        {% render 'image', image_box: ban_image, image_box_class: 'mega-menu__image' %}
                    </picture>
                    <div class="mega-menu__image-content">
                        {% if ban_subtitle != blank %}
                            <span class="mega-menu__image-subtitle caption">{{ ban_subtitle }}</span>
                        {% endif %}
                        {% if ban_title != blank %}
                            <h4 class="mega-menu__image-title">{{ ban_title }}</h4>
                        {% endif %}
                        {% if ban_link != blank %}
                            <a href='{{ ban_link }}' class="button button--small">{{ ban_button }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% endcapture %}

    {% capture mega_menu_products %}
        {% if collection.products.size > 0 %}
        <div class='mega-menu__block'>
            {% if product_title != blank %}
                <div class='mega-menu__list-title'>
                    <a class='not-link' href='#'>{{ product_title | escape }}</a>
                </div>
            {% endif %}
            <div class='mega-menu__block--grid'>
                {% for product in collection.products limit: limit %}
                <div class='mega-menu__grid--item mega-menu-product-post'>
                {% render 'menu-product-listing', card_product: product, image_size: img_size %}
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    {% endcapture %}

        {% assign mega_menu_styles = mega_menu_styles | strip_newlines %}
        <li class="header__menu-item menu-item--{{ block.type }} menu-item-width--{{ dropdown_width }} menu-item-position--{{ dropdown_position }} has-submenu--lvl-1">
            <menu-open>
                <a
                    id="headerMenuItemLink-{{ block.id }}"
                    class="header__menu-item-link drawer-menu-link{% if link.child_active %} header__menu-item-link--active{% endif %} js-link-toggle"
                    href="{{ link.url }}"
                >
                    {{ link.title }}
                    {% render 'icons-svg', icons: 'down' %}
                </a>
                <div
                    style="{{ mega_menu_styles }}"
                    class="mega-menu js-link-details drawer-submenu--parent"
                   
                >
                    <div class="mega-menu__wrapper page-width">
                        <div class="mega-menu__row">
                            <div class="mega-menu__column-list{% if mega_menu_products == blank %} product-empty{% endif %}">
                                <div class="mega-menu__list-row">
                                    {{ mega_menu_dropdown }}
                                </div>
                            </div>
                            {{ mega_menu_products }}
                        </div>

                        {% if mega_menu_media != blank %}
                        <div class="mega-menu__row">
                            {{ mega_menu_media }}
                        </div>
                        {% endif %}
                    </div>
                </div>
            </menu-open>
        </li>
    {% endif %}
{% endif %}
