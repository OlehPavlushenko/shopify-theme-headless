{% doc %}
  Active filters as removable chips ("Color: Green ×", "$5–$20 ×") and "Clear all". Every chip
  is a link to the same list without that filter, so it works without JS; facets.js intercepts the
  clicks. Renders nothing without active filters.

  @param {object[]} filters - collection.filters or search.filters
  @param {string} clear_url - URL without any filter (keeps sort / search terms)
{% enddoc %}
{%- capture chips -%}
  {%- for filter in filters -%}
    {%- if filter.type == 'price_range' -%}
      {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
        {%- liquid
          assign from = filter.min_value.value | default: 0 | money_without_trailing_zeros
          assign to = filter.max_value.value | default: filter.range_max | money_without_trailing_zeros
          assign range_label = from | append: '–' | append: to
        -%}
        <li>
          <a href="{{ filter.url_to_remove }}" class="chip chip--compact facets-active__chip" data-facets-link aria-label="{{ 'facets.remove' | t: filter: range_label | escape }}">
            {{- range_label -}}
            {%- render 'icon', name: 'close' -%}
          </a>
        </li>
      {%- endif -%}
    {%- else -%}
      {%- liquid
        assign is_swatch = false
        if filter.presentation == 'swatch'
          assign is_swatch = true
        else
          capture is_color
            render 'option-is-color', option: filter
          endcapture
          if is_color contains 'true'
            assign is_swatch = true
          endif
        endif
      -%}
      {%- for value in filter.active_values -%}
        <li>
          <a href="{{ value.url_to_remove }}" class="chip chip--compact facets-active__chip" data-facets-link aria-label="{{ 'facets.remove' | t: filter: value.label | escape }}">
            {%- if is_swatch -%}
              {%- render 'swatch', value: value, class: 'facets-active__swatch' -%}
            {%- endif -%}
            {{- value.label | escape -}}
            {%- render 'icon', name: 'close' -%}
          </a>
        </li>
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if chips != blank -%}
  <ul class="facets-active" role="list">
    {{ chips }}
    <li><a href="{{ clear_url }}" class="btn btn--link facets-active__clear" data-facets-link>{{ 'facets.clear_all' | t }}</a></li>
  </ul>
{%- endif -%}
