{% doc %}
  An order's status as pills: cancelled, or the payment status and the delivery status (account
  and order pages). Styles: .pill in packages/ui/css/components.css.

  @param {object} order - The order
{% enddoc %}
{%- if order.cancelled -%}
  <span class="pill pill--danger">{{ 'customers.order.cancelled' | t }}</span>
{%- else -%}
  {%- liquid
    assign paid_class = 'pill pill--soft'
    if order.financial_status == 'paid'
      assign paid_class = 'pill pill--success'
    endif
    assign ship_class = 'pill pill--soft'
    if order.fulfillment_status == 'fulfilled'
      assign ship_class = 'pill pill--success'
    endif
  -%}
  <span class="{{ paid_class }}">{{ order.financial_status_label }}</span>
  <span class="{{ ship_class }}">{{ order.fulfillment_status_label }}</span>
{%- endif -%}
