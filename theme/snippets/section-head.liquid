{% doc %}
  Heading row of a content section: an h2 with an optional "view all" link right after it.
  Inside a <ui-slider> it also takes the slider arrows on the right (nav: true).
  Styles: packages/ui/css/sections.css.

  @param {string} [heading] - Section heading (rich text allowed)
  @param {string} [heading_tag] - Heading element (default: h2)
  @param {string} [heading_class] - Size class of the heading (default: h3)
  @param {string} [id] - Id of the heading (the section's aria-labelledby)
  @param {string} [link_label] - Text of the link after the heading
  @param {string} [link] - URL of the link
  @param {boolean} [nav] - Render the slider arrows (inside <ui-slider>)
{% enddoc %}
{%- if heading != blank or link_label != blank or nav -%}
  <div class="section-head{% if nav %} slider__head{% endif %}">
    {%- if heading != blank -%}
      {%- assign head_tag = heading_tag | default: 'h2' -%}
      <{{ head_tag }}{% if id != blank %} id="{{ id }}"{% endif %} class="{{ heading_class | default: 'h3' }} section-head__title">
        {{- heading -}}
      </{{ head_tag }}>
    {%- endif -%}
    {%- if link_label != blank and link != blank -%}
      <a href="{{ link }}" class="link-arrow section-head__link">
        {{- link_label | escape -}}
        {%- render 'icon', name: 'arrow-right' -%}
      </a>
    {%- endif -%}
    {%- if nav -%}
      <div class="section-head__end">
        {%- assign nav_label = heading | strip_html -%}
        {%- render 'slider-nav', label: nav_label -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
