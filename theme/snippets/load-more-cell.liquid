{% doc %}
  "Load more" as the last cell of a paginated grid: "Showing 24 of 86", a progress bar, the link to
  the next page (a real URL: without JS it opens the next page). Renders nothing on the last page.
  <load-more> (@ui/load-more) around the grid appends the next page and sets the cell's span.
  Styles: .load-more in packages/ui/css/components.css.

  @param {object} paginate - The paginate object
  @param {number} shown - Items shown so far (offset + items on this page)
{% enddoc %}
{%- if paginate.next -%}
  <li class="load-more" data-load-more-cell>
    <p class="load-more__progress">{{ 'facets.progress' | t: shown: shown, total: paginate.items }}</p>
    <span class="load-more__bar" style="--progress: {{ shown | times: 100 | divided_by: paginate.items }}%;" aria-hidden="true"></span>
    <a href="{{ paginate.next.url }}" class="btn btn--outline" data-load-more-link>{{ 'facets.load_more' | t }}</a>
  </li>
{%- endif -%}
