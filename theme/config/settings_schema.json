[
  {
    "name": "theme_info",
    "theme_name": "Loyalty",
    "theme_version": "0.1.0",
    "theme_author": "Loyalty",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:settings.brand.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.brand.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:settings.brand.logo_width",
        "min": 40,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.brand.favicon",
        "info": "t:settings.brand.favicon_info"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "t:settings.brand.share_image",
        "info": "t:settings.brand.share_image_info"
      }
    ]
  },
  {
    "name": "t:settings.store.name",
    "settings": [
      { "type": "paragraph", "content": "t:settings.store.info" },
      { "type": "header", "content": "t:settings.store.contacts" },
      { "type": "text", "id": "store_phone", "label": "t:settings.store.phone" },
      { "type": "text", "id": "store_email", "label": "t:settings.store.email" },
      { "type": "textarea", "id": "store_address", "label": "t:settings.store.address" },
      { "type": "text", "id": "store_hours", "label": "t:settings.store.hours", "info": "t:settings.store.hours_info" },
      { "type": "header", "content": "t:settings.store.social" },
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_tiktok", "label": "Tiktok" },
      { "type": "url", "id": "social_youtube", "label": "Youtube" },
      { "type": "url", "id": "social_telegram", "label": "Telegram" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest" }
    ]
  },
