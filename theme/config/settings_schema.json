[
  {
    "name": "theme_info",
    "theme_name": "Loyalty",
    "theme_version": "0.1.0",
    "theme_author": "Loyalty",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:settings.brand.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.brand.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:settings.brand.logo_width",
        "min": 40,
        "max": 300,
        "step": 5,
        "unit": "px",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.brand.favicon",
        "info": "t:settings.brand.favicon_info"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "t:settings.brand.share_image",
        "info": "t:settings.brand.share_image_info"
      }
    ]
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "header",
            "content": "t:settings.colors.background_text"
          },
          {
            "type": "color",
            "id": "background",
            "label": "t:settings.colors.background",
            "default": "#fbfaf7"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings.colors.background_gradient",
            "info": "t:settings.colors.background_gradient_info"
          },
          {
            "type": "color",
            "id": "foreground",
            "label": "t:settings.colors.foreground",
            "default": "#3d4440"
          },
          {
            "type": "color",
            "id": "heading",
            "label": "t:settings.colors.heading",
            "default": "#1b2a23"
          },
          {
            "type": "color",
            "id": "link_hover",
            "label": "t:settings.colors.link_hover",
            "default": "#2f6b4f"
          },
          {
            "type": "header",
            "content": "t:settings.colors.accents"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:settings.colors.accent",
            "default": "#2f6b4f"
          },
          {
            "type": "color",
            "id": "accent_2",
            "label": "t:settings.colors.accent_2",
            "default": "#c9772b"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:settings.colors.surface",
            "info": "t:settings.colors.surface_info",
            "default": "#efeee8"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:settings.colors.border",
            "default": "#e1dfd6"
          },
          {
            "type": "header",
            "content": "t:settings.colors.buttons"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.colors.button",
            "default": "#1b2a23"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.colors.button_label",
            "default": "#fbfaf7"
          },
          {
            "type": "color",
            "id": "button_hover",
            "label": "t:settings.colors.button_hover",
            "default": "#2f6b4f"
          },
          {
            "type": "color",
            "id": "button_label_hover",
            "label": "t:settings.colors.button_label_hover",
            "default": "#fbfaf7"
          },
          {
            "type": "color",
            "id": "button_secondary",
            "label": "t:settings.colors.button_secondary",
            "default": "#dfe8df"
          },
          {
            "type": "color",
            "id": "button_secondary_label",
            "label": "t:settings.colors.button_secondary_label",
            "default": "#1b2a23"
          },
          {
            "type": "header",
            "content": "t:settings.colors.inputs"
          },
          {
            "type": "color",
            "id": "input_background",
            "label": "t:settings.colors.input_background",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "input_text",
            "label": "t:settings.colors.input_text",
            "default": "#1b2a23"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "foreground",
          "links": "heading",
          "icons": "foreground",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "button_secondary",
          "on_secondary_button": "button_secondary_label",
          "secondary_button_border": "button_secondary"
        }
      },
      {
        "type": "header",
        "content": "t:settings.colors.status"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "t:settings.colors.success",
        "default": "#2f7d4f"
      },
      {
        "type": "color",
        "id": "color_info",
        "label": "t:settings.colors.info",
        "default": "#2c5e9e"
      },
      {
        "type": "color",
        "id": "color_warning",
        "label": "t:settings.colors.warning",
        "default": "#b8742a"
      },
      {
        "type": "color",
        "id": "color_danger",
        "label": "t:settings.colors.danger",
        "default": "#b3261e"
      },
      {
        "type": "color",
        "id": "color_focus",
        "label": "t:settings.colors.focus",
        "default": "#2f6b4f"
      }
    ]
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings.typography.heading_font",
        "default": "bricolage_grotesque_n7"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "t:settings.typography.heading_scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings.typography.body_font",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "t:settings.typography.body_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings.layout.page_width",
        "min": 1000,
        "max": 1920,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "header",
        "content": "t:settings.layout.radius"
      },
      {
        "type": "range",
        "id": "radius_button",
        "label": "t:settings.layout.radius_button",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "radius_input",
        "label": "t:settings.layout.radius_input",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "radius_card",
        "label": "t:settings.layout.radius_card",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "radius_media",
        "label": "t:settings.layout.radius_media",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "radius_badge",
        "label": "t:settings.layout.radius_badge",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      }
    ]
  },
  {
    "name": "t:settings.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart.cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:settings.cart.cart_type_drawer"
          },
          {
            "value": "notification",
            "label": "t:settings.cart.cart_type_notification"
          },
          {
            "value": "page",
            "label": "t:settings.cart.cart_type_page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "header",
        "content": "t:settings.cart.free_shipping"
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping",
        "label": "t:settings.cart.show_free_shipping",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:settings.cart.free_shipping_threshold",
        "info": "t:settings.cart.free_shipping_threshold_info",
        "default": 100
      },
      {
        "type": "header",
        "content": "t:settings.cart.upsell"
      },
      {
        "type": "checkbox",
        "id": "show_upsell",
        "label": "t:settings.cart.show_upsell",
        "default": true
      },
      {
        "type": "product_list",
        "id": "upsell_products",
        "label": "t:settings.cart.upsell_products",
        "info": "t:settings.cart.upsell_products_info",
        "limit": 6
      },
      {
        "type": "header",
        "content": "t:settings.cart.order_details"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "t:settings.cart.show_cart_note",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.behavior.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "view_transitions",
        "label": "t:settings.behavior.view_transitions",
        "info": "t:settings.behavior.view_transitions_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "prefetch_links",
        "label": "t:settings.behavior.prefetch_links",
        "info": "t:settings.behavior.prefetch_links_info",
        "default": true
      }
    ]
  }
]
