{% comment %}
  Collections page (templates/list-collections.json, under the Page header): every collection with
  products, minus those marked "Hide from collection lists" (metafield theme.hidden), in one of
  three layouts:
  - editorial: one wide row per collection — number, title, description, count, four product
    thumbnails, "Shop collection →" (suits a handful of collections with descriptions)
  - bento: a mosaic of tiles with the title over the image; "Featured in collection lists"
    (metafield theme.featured) — or, without any, the first collection — gets a large tile
  - grid: collection cards (snippets/collection-card)
  Styles: .main-collections in sections.css.
{% endcomment %}
{%- liquid
  case section.settings.sort
    when 'alphabetical'
      assign list = collections | sort: 'title'
    when 'products'
      assign list = collections | sort: 'products_count' | reverse
    else
      assign list = collections
  endcase
  assign layout = section.settings.layout
  assign any_featured = false
  for collection in list
    if collection.metafields.theme.featured.value
      assign any_featured = true
      break
    endif
  endfor
  assign index = 0
-%}
<div class="main-collections main-collections--{{ layout }} color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width">
    <ul
      class="main-collections__list{% if layout == 'grid' %} grid main-collections__grid{% endif %}"
      role="list"
      {% if layout == 'grid' %}
        style="--grid-columns: {{ section.settings.columns }}; --grid-columns-mobile: 2;"
      {% endif %}
    >
      {%- for collection in list -%}
        {%- if collection.metafields.theme.hidden.value or collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign index = index | plus: 1 -%}
        {%- case layout -%}
          {%- when 'editorial' -%}
            <li>
              <a href="{{ collection.url }}" class="collection-row">
                <span class="collection-row__index" aria-hidden="true">{% if index < 10 %}0{% endif %}{{ index }}</span>
                <span class="collection-row__text">
                  <span class="h2 collection-row__title">{{ collection.title | escape }}</span>
                  {%- if collection.description != blank -%}
                    <span class="collection-row__description">{{ collection.description | strip_html | truncatewords: 26 }}</span>
                  {%- endif -%}
                  <span class="collection-row__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
                </span>
                <span class="collection-row__products" aria-hidden="true">
                  {%- for product in collection.products limit: 4 -%}
                    <span class="frame collection-row__thumb" style="--frame-ratio: 1;">
                      {%- if product.featured_media -%}
                        {{ product.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 120px, 22vw', widths: '150, 300', alt: '' }}
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                </span>
                <span class="link-arrow collection-row__cta" aria-hidden="true">
                  {{- 'collections.shop' | t -}}
                  {%- render 'icon', name: 'arrow-right' -%}
                </span>
              </a>
            </li>
          {%- when 'bento' -%}
            {%- liquid
              assign large = false
              if collection.metafields.theme.featured.value
                assign large = true
              elsif any_featured == false and index == 1
                assign large = true
              endif
              assign cover = collection.image | default: collection.products.first.featured_image
            -%}
            <li class="collection-tile{% if large %} collection-tile--large{% endif %}">
              <a href="{{ collection.url }}" class="collection-tile__link">
                <span class="collection-tile__media">
                  {%- if cover -%}
                    {%- if large and index == 1 -%}
                      {%- comment -%} The first large tile is the page's main image {%- endcomment -%}
                      {{ cover | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: '' }}
                    {%- elsif large -%}
                      {{ cover | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: '' }}
                    {%- else -%}
                      {{ cover | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800', alt: '' }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>
                <span class="collection-tile__caption">
                  <span class="collection-tile__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
                  <span class="{% if large %}h2{% else %}h4{% endif %} collection-tile__title">
                    {{- collection.title | escape -}}
                    {%- render 'icon', name: 'arrow-right' -%}
                  </span>
                  {%- if large and collection.description != blank -%}
                    <span class="collection-tile__description">{{ collection.description | strip_html | truncatewords: 18 }}</span>
                  {%- endif -%}
                </span>
              </a>
            </li>
          {%- else -%}
            <li>
              {%- render 'collection-card', collection: collection, ratio: section.settings.ratio, sizes: '(min-width: 990px) 25vw, 50vw' -%}
            </li>
        {%- endcase -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "class": "main-collections-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.main_list_collections.layout",
      "info": "t:sections.main_list_collections.layout_info",
      "options": [
        { "value": "editorial", "label": "t:sections.main_list_collections.layout_editorial" },
        { "value": "bento", "label": "t:sections.main_list_collections.layout_bento" },
        { "value": "grid", "label": "t:sections.main_list_collections.layout_grid" }
      ],
      "default": "editorial"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "t:sections.main_list_collections.sort",
      "options": [
        { "value": "default", "label": "t:sections.main_list_collections.sort_default" },
        { "value": "alphabetical", "label": "t:sections.main_list_collections.sort_alphabetical" },
        { "value": "products", "label": "t:sections.main_list_collections.sort_products" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "t:sections.main_list_collections.grid_header" },
    { "type": "range", "id": "columns", "label": "t:sections.product_list.columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:sections.collection_list.ratio",
      "options": [
        { "value": "1", "label": "t:sections.collection_list.ratio_square" },
        { "value": "4 / 5", "label": "t:sections.collection_list.ratio_portrait" }
      ],
      "default": "1"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
