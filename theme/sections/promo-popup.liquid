{% comment %}
  Promo popup, in the "Overlays" section group (rendered on every page). Content from blocks:
  text, countdown, newsletter, "Spin to win" wheel (its segments are the Prize blocks), products,
  button — in the editor's order. Optional image beside the
  content (hidden on phones). Phones get a sheet from the bottom instead of a centered window.
  When it opens and how often: <promo-popup> (@ui/promo-popup). Styles: packages/ui/css/promo.css.
{% endcomment %}
{%- liquid
  capture active
    render 'schedule-active', from: section.settings.show_from, until: section.settings.show_until
  endcapture
  assign on_page = true
  case section.settings.pages
    when 'home'
      if template.name != 'index'
        assign on_page = false
      endif
    when 'not_cart'
      if template.name == 'cart'
        assign on_page = false
      endif
  endcase
  if request.design_mode
    assign on_page = true
  endif
-%}
{%- if active contains 'true' and on_page and section.blocks.size > 0 -%}
  {%- liquid
    assign title_id = 'PromoPopup-title-' | append: section.id
    assign titled = section.blocks | where: 'type', 'text' | map: 'settings' | map: 'heading' | compact | first
    # Delay: when set, or as the only trigger when the others are off
    assign use_delay = false
    if section.settings.delay > 0
      assign use_delay = true
    elsif section.settings.scroll == 0 and section.settings.exit_intent == false
      assign use_delay = true
    endif
  -%}
  <promo-popup
    data-id="{{ section.id }}"
    {% if use_delay %}
      data-delay="{{ section.settings.delay }}"
    {% endif %}
    data-scroll="{{ section.settings.scroll }}"
    data-days="{{ section.settings.days }}"
    {% if section.settings.exit_intent %}
      data-exit
    {% endif %}
  >
    <dialog
      class="popup promo-popup color-{{ section.settings.color_scheme }}{% if section.settings.image %} promo-popup--media{% endif %}"
      {% if titled != blank %}
        aria-labelledby="{{ title_id }}"
      {% else %}
        aria-label="{{ 'accessibility.promo' | t | escape }}"
      {% endif %}
    >
      <div class="promo-popup__inner">
        {%- if section.settings.image -%}
          <div class="promo-popup__media">
            {{
              section.settings.image
              | image_url: width: 900
              | image_tag: loading: 'lazy', sizes: '360px', widths: '360, 540, 720, 900', alt: ''
            }}
          </div>
        {%- endif -%}

        {%- comment -%} Focus lands here on open (not on the close button, which would show its focus ring) {%- endcomment -%}
        <div class="promo-popup__content" tabindex="-1" autofocus>
          {%- render 'close-button', class: 'promo-popup__close' -%}

          {%- assign has_title = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="promo-popup__text" {{ block.shopify_attributes }}>
                  {%- liquid
                    assign heading_id = nil
                    unless has_title
                      assign heading_id = title_id
                    endunless
                    render 'section-intro', eyebrow: block.settings.eyebrow, heading: block.settings.heading, heading_class: 'h3 promo-popup__heading', heading_id: heading_id, text: block.settings.text, text_class: 'promo-popup__body'
                    if block.settings.heading != blank
                      assign has_title = true
                    endif
                  -%}
                </div>

              {%- when 'countdown' -%}
                {%- if block.settings.end != blank -%}
                  <p class="promo-popup__countdown" data-countdown-section {{ block.shopify_attributes }}>
                    {%- render 'countdown', end: block.settings.end -%}
                  </p>
                {%- endif -%}

              {%- when 'newsletter' -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'newsletter-form',
                    id: block.id,
                    button_label: block.settings.button_label,
                    success_text: block.settings.success_text,
                    already_text: block.settings.already_text,
                    note: block.settings.note,
                    discount_code: block.settings.discount_code
                  -%}
                </div>

              {%- when 'wheel' -%}
                {%- comment -%}
                  Spin to win: the segments are the section's Prize blocks in their order (label, code
                  from Discounts, chance). With the API URL the newsletter sign-up starts the spin,
                  else a button.
                  The disc is a conic gradient (surface / accent segments) with the labels along the
                  radius; <spin-wheel> (@ui/spin-wheel) picks the prize and applies its code.
                {%- endcomment -%}
                {%- liquid
                  capture api
                    render 'api-url'
                  endcapture
                  assign api = api | strip
                  assign prizes = section.blocks | where: 'type', 'prize'
                  assign count = 0
                  assign prizes_json = ''
                  assign prize_names = ''
                  for prize in prizes
                    assign label = prize.settings.label | strip
                    assign code = prize.settings.code | strip | upcase
                    assign weight = prize.settings.chance | default: 1
                    if label == blank
                      continue
                    endif
                    if count > 0
                      assign prizes_json = prizes_json | append: ','
                      assign prize_names = prize_names | append: ', '
                    endif
                    assign label_json = label | json
                    assign code_json = code | json
                    assign item = '{"label":' | append: label_json | append: ',"code":' | append: code_json | append: ',"weight":' | append: weight | append: '}'
                    assign prizes_json = prizes_json | append: item
                    assign prize_names = prize_names | append: label
                    assign count = count | plus: 1
                  endfor
                -%}
                {%- if count > 1 -%}
                  {%- liquid
                    assign stops = ''
                    assign last = count | minus: 1
                    assign odd = count | modulo: 2
                    for i in (0..last)
                      assign from = i | times: 100.0 | divided_by: count
                      assign to = i | plus: 1 | times: 100.0 | divided_by: count
                      assign color = 'var(--color-surface)'
                      assign parity = i | modulo: 2
                      if parity == 1
                        assign color = 'var(--color-accent)'
                      endif
                      if odd == 1 and i == last
                        assign color = 'var(--color-accent-2)'
                      endif
                      if i > 0
                        assign stops = stops | append: ', '
                      endif
                      assign stops = stops | append: color | append: ' ' | append: from | append: '% ' | append: to | append: '%'
                    endfor
                  -%}
                  <spin-wheel class="spin-wheel" data-key="{{ section.id }}" {{ block.shopify_attributes }}>
                    <div class="spin-wheel__stage" aria-hidden="true">
                      <span class="spin-wheel__pointer"></span>
                      <div class="spin-wheel__disc" data-wheel-disc style="--segments: {{ count }}; background: conic-gradient({{ stops }});">
                        {%- assign i = 0 -%}
                        {%- for prize in prizes -%}
                          {%- assign label = prize.settings.label | strip -%}
                          {%- if label == blank -%}{%- continue -%}{%- endif -%}
                          {%- liquid
                            assign parity = i | modulo: 2
                            # On the left half the text turns over so it reads the right way up
                            assign twice = i | times: 2 | plus: 1
                          -%}
                          <span class="spin-wheel__label{% if parity == 1 or odd == 1 and i == last %} spin-wheel__label--on-color{% endif %}{% if twice > count %} spin-wheel__label--flip{% endif %}" style="--i: {{ i }};" {{ prize.shopify_attributes }}>
                            <span>{{ label | escape }}</span>
                          </span>
                          {%- assign i = i | plus: 1 -%}
                        {%- endfor -%}
                      </div>
                      <span class="spin-wheel__hub">{%- render 'icon', name: 'gift' -%}</span>
                    </div>
                    <p class="visually-hidden">{{ 'wheel.prizes' | t }}: {{ prize_names | escape }}</p>
                    <script type="application/json" data-wheel-prizes>[{{ prizes_json }}]</script>

                    <div class="spin-wheel__action">
                      {%- if api != blank -%}
                        {%- assign spinning = 'wheel.spinning' | t | prepend: '<p>' | append: '</p>' -%}
                        {%- render 'newsletter-form',
                          id: block.id,
                          button_label: block.settings.button_label,
                          success_text: spinning,
                          already_text: spinning,
                          note: block.settings.note
                        -%}
                      {%- else -%}
                        <button type="button" class="btn btn--full" data-wheel-spin>{{ block.settings.button_label | escape }}</button>
                        {%- if block.settings.note != blank -%}
                          <p class="newsletter-form__note">{{ block.settings.note }}</p>
                        {%- endif -%}
                      {%- endif -%}
                    </div>

                    <div class="spin-wheel__result" data-wheel-result role="status" tabindex="-1" hidden>
                      <p class="eyebrow">{{ 'wheel.won' | t }}</p>
                      <p class="h3 spin-wheel__prize" data-wheel-prize></p>
                      <div class="spin-wheel__code">
                        <code data-wheel-code></code>
                        <button type="button" class="btn btn--outline btn--sm" data-wheel-copy data-copied="{{ 'wheel.copied' | t | escape }}">
                          {{- 'wheel.copy' | t -}}
                        </button>
                      </div>
                      <p
                        class="spin-wheel__note"
                        data-wheel-note
                        data-applying="{{ 'wheel.applying' | t | escape }}"
                        data-applied="{{ 'wheel.applied' | t | escape }}"
                        data-failed="{{ 'wheel.failed' | t | escape }}"
                        data-saved="{{ 'wheel.saved' | t | escape }}"
                      ></p>
                    </div>
                  </spin-wheel>
                  <script type="module">import '@ui/spin-wheel';</script>
                {%- endif -%}

              {%- when 'prize' -%}
                {%- comment -%} A segment of the wheel (above), nothing of its own {%- endcomment -%}

              {%- when 'products' -%}
                {%- comment -%} Fetched when the popup opens (snippets/lazy-section); section.index is blank when the section is rendered on its own {%- endcomment -%}
                {%- if block.settings.products.count > 0 and section.index and request.design_mode == false -%}
                  {%- render 'lazy-section',
                    section_id: section.id,
                    key: block.id,
                    class: 'slider promo-popup__products',
                    heading: block.settings.heading
                  -%}
                {%- elsif block.settings.products.count > 0 -%}
                  <ui-slider class="slider promo-popup__products" data-lazy-key="{{ block.id }}" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="eyebrow">{{ block.settings.heading | escape }}</p>
                    {%- endif -%}
                    <ul class="scroll-track slider__track" data-slider-track role="list">
                      {%- for product in block.settings.products -%}
                        <li>
                          {%- render 'product-card',
                            product: product,
                            actions: false,
                            quick_add: true,
                            show_secondary_image: false,
                            heading_tag: 'p',
                            sizes: '160px'
                          -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </ui-slider>
                {%- endif -%}

              {%- when 'button' -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--full" {{ block.shopify_attributes }}>
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </dialog>
  </promo-popup>
  <script type="module">import '@ui/promo-popup';</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.promo_popup.name",
  "class": "promo-popup-section",
  "enabled_on": { "groups": ["custom.overlay"] },
  "settings": [
    { "type": "header", "content": "t:sections.promo_popup.when" },
    {
      "type": "range",
      "id": "delay",
      "label": "t:sections.promo_popup.delay",
      "info": "t:sections.promo_popup.delay_info",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 8
    },
    {
      "type": "range",
      "id": "scroll",
      "label": "t:sections.promo_popup.scroll",
      "info": "t:sections.promo_popup.scroll_info",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "default": 40
    },
    { "type": "checkbox", "id": "exit_intent", "label": "t:sections.promo_popup.exit_intent", "info": "t:sections.promo_popup.exit_intent_info", "default": true },
    {
      "type": "range",
      "id": "days",
      "label": "t:sections.promo_popup.days",
      "info": "t:sections.promo_popup.days_info",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 3
    },
    {
      "type": "select",
      "id": "pages",
      "label": "t:sections.promo_popup.pages",
      "options": [
        { "value": "all", "label": "t:sections.promo_popup.pages_all" },
        { "value": "home", "label": "t:sections.promo_popup.pages_home" },
        { "value": "not_cart", "label": "t:sections.promo_popup.pages_not_cart" }
      ],
      "default": "not_cart"
    },
    { "type": "text", "id": "show_from", "label": "t:labels.show_from", "info": "t:labels.schedule_info" },
    { "type": "text", "id": "show_until", "label": "t:labels.show_until", "info": "t:labels.schedule_info" },
    { "type": "header", "content": "t:sections.promo_popup.look" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "image_picker", "id": "image", "label": "t:labels.image", "info": "t:sections.promo_popup.image_info" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "t:labels.text",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
        { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Get 10% off your first order" },
        { "type": "richtext", "id": "text", "label": "t:labels.text" }
      ]
    },
    {
      "type": "countdown",
      "name": "t:sections.countdown.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "end", "label": "t:sections.countdown.end", "info": "t:sections.countdown.end_info", "default": "2026-12-31 23:59" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.promo_popup.newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "t:labels.button_label" },
        { "type": "richtext", "id": "success_text", "label": "t:sections.promo_popup.success_text", "info": "t:sections.promo_popup.success_text_info" },
        { "type": "richtext", "id": "already_text", "label": "t:sections.promo_popup.already_text" },
        { "type": "inline_richtext", "id": "note", "label": "t:sections.promo_popup.note" },
        { "type": "text", "id": "discount_code", "label": "t:sections.promo_popup.discount_code", "info": "t:sections.promo_popup.discount_code_info" }
      ]
    },
    {
      "type": "wheel",
      "name": "t:sections.promo_popup.wheel",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "t:sections.promo_popup.wheel_info" },
        { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Spin the wheel" },
        { "type": "inline_richtext", "id": "note", "label": "t:sections.promo_popup.note", "default": "One spin per person. No spam." }
      ]
    },
    {
      "type": "prize",
      "name": "t:sections.promo_popup.prize",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.promo_popup.prize_label", "info": "t:sections.promo_popup.prize_label_info", "default": "10% off" },
        { "type": "text", "id": "code", "label": "t:sections.promo_popup.prize_code", "info": "t:sections.promo_popup.prize_code_info", "default": "SPIN10" },
        {
          "type": "range",
          "id": "chance",
          "label": "t:sections.promo_popup.prize_chance",
          "info": "t:sections.promo_popup.prize_chance_info",
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 10
        }
      ]
    },
    {
      "type": "products",
      "name": "t:labels.products",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading" },
        { "type": "product_list", "id": "products", "label": "t:labels.products", "limit": 6 }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.promo_popup.button",
      "settings": [
        { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "t:labels.button_link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_popup.name",
      "blocks": [{ "type": "text" }, { "type": "newsletter" }]
    }
  ]
}
{% endschema %}
