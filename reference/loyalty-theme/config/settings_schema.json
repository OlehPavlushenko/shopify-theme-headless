        "label": "Button"
      },
      {
        "type": "select",
        "id": "img_size",
        "label": "Image size",
        "options": [
          {
            "value": "cropped",
            "label": "Cropped"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          }
        ]
      },
      {
        "type": "header",
        "content": "Page options"
      },
      {
        "type": "range",
        "id": "page_limit",
        "min": 6,
        "max": 36,
        "step": 6,
        "default": 12,
        "label": "Page Limit"
