{% layout none %}
{% comment %}
  Gift card page — the link in the gift card email (/gift_cards/…): the card itself (logo, shop,
  balance; the initial value when part is spent), the sender's message, the code with a copy button,
  the expiry, a QR code to pay in a shop (Shopify's qrcode.js), Apple Wallet, "Shop now" and print.
  A full page of its own (no theme layout). Styles: .gift-card in packages/ui/css/sections.css.
{% endcomment %}
{%- liquid
  assign balance = gift_card.balance | money_without_trailing_zeros
  assign initial = gift_card.initial_value | money_without_trailing_zeros
  assign active = true
  if gift_card.enabled == false or gift_card.expired
    assign active = false
  endif
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'meta-tags' -%}
    {{ 'ui-tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-components.css' | asset_url | stylesheet_tag }}
    {{ 'ui-sections.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-tokens' -%}
    {%- render 'color-schemes' -%}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body>
    <main class="gift-card color-scheme-2">
      <div class="gift-card__inner">
        <header class="gift-card__top">
          <a href="{{ routes.root_url }}" class="gift-card__shop">
            {%- if settings.logo -%}
              {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
              {{ settings.logo | image_url: width: 480 | image_tag: width: settings.logo_width, height: logo_height, alt: shop.name }}
            {%- else -%}
              <span class="h4">{{ shop.name | escape }}</span>
            {%- endif -%}
          </a>
        </header>

        <h1 class="h2 gift-card__title">{{ 'gift_card.title' | t: shop: shop.name }}</h1>

        <div class="gift-card__card{% unless active %} gift-card__card--inactive{% endunless %}">
          <div class="gift-card__card-top">
            <span class="gift-card__card-label">{{ 'gift_card.card' | t }}</span>
            {%- if active == false -%}
              <span class="gift-card__status">
                {%- if gift_card.expired -%}{{ 'gift_card.expired_badge' | t }}{%- else -%}{{ 'gift_card.disabled' | t }}{%- endif -%}
              </span>
            {%- endif -%}
          </div>
          <p class="gift-card__balance">{{ balance }}</p>
          <div class="gift-card__card-bottom">
            <span class="gift-card__card-shop">{{ shop.name | escape }}</span>
            {%- if gift_card.balance != gift_card.initial_value -%}
              <span class="gift-card__initial">{{ 'gift_card.initial_html' | t: value: initial }}</span>
            {%- endif -%}
          </div>
        </div>

        {%- if gift_card.message != blank -%}
          <figure class="gift-card__message">
            <blockquote><p>{{ gift_card.message | escape | newline_to_br }}</p></blockquote>
            {%- if gift_card.customer -%}
              <figcaption>— {{ gift_card.customer.first_name | default: gift_card.customer.name | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}

        {%- if active -%}
          <div class="gift-card__code-block">
            <p class="gift-card__hint">{{ 'gift_card.use_at_checkout' | t }}</p>
            <gift-card-code class="gift-card__code" data-copied="{{ 'gift_card.copied' | t | escape }}">
              <code data-code>{{ gift_card.code | format_code }}</code>
              <button type="button" class="btn btn--sm" data-copy hidden>{{ 'gift_card.copy' | t }}</button>
            </gift-card-code>
            {%- if gift_card.expires_on -%}
              {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
              <p class="gift-card__hint">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
            {%- endif -%}
          </div>

          <div class="gift-card__qr">
            <div class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}" data-alt="{{ 'gift_card.qr_alt' | t | escape }}"></div>
            <p class="gift-card__hint">{{ 'gift_card.qr_hint' | t }}</p>
          </div>
        {%- else -%}
          <p class="gift-card__hint">{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}

        <div class="gift-card__actions">
          <a href="{{ shop.url }}" class="btn">{{ 'gift_card.shop_now' | t }}</a>
          <button type="button" class="btn btn--outline" data-print hidden>{{ 'gift_card.print' | t }}</button>
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
              <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" alt="{{ 'gift_card.add_to_apple_wallet' | t }}" width="120" height="40">
            </a>
          {%- endif -%}
        </div>
      </div>
    </main>

    <script>
      // Copy and print need JS: the buttons show with it. The QR code comes from Shopify's qrcode.js.
      customElements.define(
        'gift-card-code',
        class extends HTMLElement {
          connectedCallback() {
            const button = this.querySelector('[data-copy]');
            const code = this.querySelector('[data-code]').textContent.trim();
            if (!navigator.clipboard) return;
            button.hidden = false;
            button.addEventListener('click', async () => {
              await navigator.clipboard.writeText(code.replace(/\s/g, ''));
              const label = button.textContent;
              button.textContent = this.dataset.copied;
              setTimeout(() => (button.textContent = label), 2000);
            });
          }
        }
      );
      const print = document.querySelector('[data-print]');
      print.hidden = false;
      print.addEventListener('click', () => window.print());
      window.addEventListener('load', () => {
        const qr = document.querySelector('.gift-card__qr-code');
        if (qr && window.QRCode) new QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120, imageAltText: qr.dataset.alt });
      });
    </script>
  </body>
</html>
