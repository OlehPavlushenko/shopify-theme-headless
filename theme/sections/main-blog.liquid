{% comment %}
  Blog page (templates/blog.json, under the Page header) and the blog's search results
  (templates/search.blog.json — the Page header's blog search field). The body is
  snippets/blog-page: the topics are the tags on the article cards — a click adds that topic to the
  filter (several: /blogs/<handle>/tagged/a+b, articles with all of them; snippets/blog-topic-url) —
  the chosen topics (or the search terms) as removable chips with the count, the newest article
  large on the first page (optional), then the cards (snippets/article-card) with "Load more" or
  page numbers. Topic links and the search form re-render the section in place (<section-swap>,
  @ui/section-swap). Styles: .main-blog in sections.css.
{% endcomment %}
{%- if template.name == 'search' -%}
  {%- paginate search.results by section.settings.per_page -%}
    {%- render 'blog-page', section: section, articles: search.results, paginate: paginate, blog_url: section.settings.blog.url, terms: search.terms, count: search.results_count -%}
  {%- endpaginate -%}
{%- else -%}
  {%- paginate blog.articles by section.settings.per_page -%}
    {%- render 'blog-page', section: section, articles: blog.articles, paginate: paginate, blog_url: blog.url -%}
  {%- endpaginate -%}
{%- endif -%}
<script type="module">import '@ui/section-swap';</script>
{%- if section.settings.pagination == 'load_more' -%}
  <script type="module">import '@ui/load-more';</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "class": "main-blog-section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "t:sections.main_blog.per_page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "checkbox", "id": "tags", "label": "t:sections.main_blog.tags", "info": "t:sections.main_blog.tags_info", "default": true },
    { "type": "blog", "id": "blog", "label": "t:labels.blog", "info": "t:sections.main_blog.blog_info" },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.main_collection.pagination",
      "options": [
        { "value": "load_more", "label": "t:sections.main_collection.pagination_load_more" },
        { "value": "pages", "label": "t:sections.main_collection.pagination_pages" }
      ],
      "default": "load_more"
    },
    { "type": "checkbox", "id": "featured", "label": "t:sections.main_blog.featured", "info": "t:sections.main_blog.featured_info", "default": true },
    { "type": "header", "content": "t:sections.main_blog.signup_header" },
    { "type": "checkbox", "id": "show_signup", "label": "t:sections.main_blog.show_signup", "info": "t:sections.main_blog.show_signup_info", "default": false },
    { "type": "range", "id": "signup_position", "label": "t:sections.main_blog.signup_position", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "signup_heading", "label": "t:labels.heading", "default": "One guide a week, straight to your inbox" },
    { "type": "text", "id": "signup_text", "label": "t:labels.text", "default": "Guides, product news and early access to new arrivals. No spam." },
    { "type": "text", "id": "signup_button", "label": "t:labels.button_label", "default": "Subscribe" },
    { "type": "text", "id": "signup_note", "label": "t:sections.password.newsletter_note", "default": "Unsubscribe any time." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "t:sections.main_collection.promo",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "position", "label": "t:sections.main_blog.promo_position", "info": "t:sections.main_blog.promo_position_info", "min": 1, "max": 12, "step": 1, "default": 3 },
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Gift ideas" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Ready-to-give sets" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "Free gift wrapping on every order" },
        { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop sets" },
        { "type": "url", "id": "button_link", "label": "t:labels.button_link" }
      ]
    }
  ]
}
{% endschema %}
