{% doc %}
  Link row: round thumbnail (or an icon when there is no image), title and a trailing arrow.
  Used for quick links and collection links (search panel; later mega menu, mobile menu, footer).
  Styles: .link-tile in packages/ui/css/components.css.

  @param {string} title - Link text
  @param {string} [url] - Destination (defaults to the home page)
  @param {object} [image] - Thumbnail image
{% enddoc %}
<a href="{{ url | default: routes.root_url }}" class="link-tile">
  <span class="link-tile__media">
    {%- if image -%}
      {{ image | image_url: width: 96 | image_tag: loading: 'lazy', sizes: '32px', alt: '' }}
    {%- else -%}
      {%- render 'icon', name: 'arrow-right' -%}
    {%- endif -%}
  </span>
  <span class="link-tile__title">{{ title | escape }}</span>
  {%- render 'icon', name: 'arrow-right', class: 'link-tile__arrow' -%}
</a>
