{% comment %}
  Complementary products of a product as compact rows (snippets/product-row) — rendered for the
  "Pairs well with" block of the product page (@ui/product fetches
  /recommendations/products?section_id=product-complementary&intent=complementary). Search &
  Discovery decides which products these are; nothing when there are none.
{% endcomment %}
<ul class="product-rows" role="list" data-recommendations>
  {%- for product in recommendations.products -%}
    {%- render 'product-row', product: product -%}
  {%- endfor -%}
</ul>

{% schema %}
{
  "name": "t:sections.product_complementary.name",
  "class": "product-complementary-section"
}
{% endschema %}
