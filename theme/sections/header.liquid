{% comment %}
  Site header.
  - Layouts (setting "layout"): logo left + inline menu, logo center + menu below, logo center + menu left.
    One markup, grid areas switch per layout (packages/ui/css/header.css).
  - Sticky: none / always / reveal on scroll up (@ui/header, CSS sticky on the section wrapper).
  - Transparent: overlays the first section on the home page until the page scrolls.
  - Desktop menu with dropdowns and mega menus (snippets/site-nav), mobile drill-down menu panel
    under the header (snippets/mobile-menu), country/language selector (snippets/localization-form).
  - Blocks "Menu promo" / "Menu products" attach content to a mega menu by top-level link title.
  - Search panel (snippets/search-panel): predictive search, top sheet or side drawer; while the
    query is empty it shows the search_* blocks (terms, quick links, products, collections).
{% endcomment %}
{%- liquid
  assign menu = section.settings.menu
  assign layout = section.settings.layout
  assign transparent = false
  if section.settings.transparent and template.name == 'index'
    assign transparent = true
  endif
  assign on_cart_page = false
  if template.name == 'cart'
    assign on_cart_page = true
  endif
  # Below 990px the utility panel's content moves to the bottom of the mobile menu (when there is one)
  assign has_mobile_menu = false
  if menu.links.size > 0 and section.settings.show_utility_panel
    assign has_mobile_menu = true
  endif
-%}

<site-header
  class="site-header site-header--{{ layout }} color-{{ section.settings.color_scheme }}"
  data-sticky="{{ section.settings.sticky }}"
  {% if transparent %}
    data-transparent
    style="--header-transparent-fg: {{ section.settings.transparent_text_color }};"
  {% endif %}
>
  <div class="site-header__inner page-width">
    {%- if menu.links.size > 0 -%}
      {%- comment -%} Opens/closes the menu panel under the header; the icon turns into a cross while open {%- endcomment -%}
      <button
        type="button"
        class="btn btn--icon site-header__toggle"
        popovertarget="MenuPanel"
        aria-label="{{ 'accessibility.menu' | t }}"
      >
        {%- render 'icon', name: 'menu' -%}
        {%- render 'icon', name: 'close' -%}
      </button>
    {%- endif -%}

    {%- comment -%} Home page h1: the logo carries the shop name (SEO: one h1 per page). {%- endcomment -%}
    {%- if template.name == 'index' -%}<h1 class="site-header__heading">{%- endif -%}
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        {%- liquid
          assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round
          assign logo_sizes = settings.logo_width | append: 'px'
        -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'site-header__logo-image',
            width: settings.logo_width,
            height: logo_height,
            alt: shop.name,
            loading: 'eager',
            fetchpriority: 'high',
            sizes: logo_sizes
        }}
        {%- if transparent and section.settings.logo_transparent != blank -%}
          {{
            section.settings.logo_transparent
            | image_url: width: 600
            | image_tag:
              class: 'site-header__logo-image site-header__logo-image--transparent',
              width: settings.logo_width,
              height: logo_height,
              alt: shop.name,
              loading: 'eager',
              sizes: logo_sizes
          }}
        {%- endif -%}
      {%- else -%}
        <span class="site-header__shop-name">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    {%- if template.name == 'index' -%}</h1>{%- endif -%}

    {%- if menu.links.size > 0 -%}
      <div class="site-header__nav">
        {%- render 'site-nav', menu: menu, blocks: section.blocks -%}
      </div>
    {%- endif -%}

    <div class="site-header__icons">
      <a
        href="{{ routes.search_url }}"
        class="btn btn--icon"
        data-dialog-open="SearchPanel"
        aria-haspopup="dialog"
        aria-label="{{ 'search.title' | t }}"
      >
        {%- render 'icon', name: 'search' -%}
      </a>
      {%- if section.settings.show_utility_panel -%}
        {%- render 'utility-panel',
          id: 'UtilityPanel',
          menu: section.settings.utility_menu,
          show_account: section.settings.show_account,
          show_wishlist: section.settings.show_wishlist,
          show_compare: section.settings.show_compare,
          show_currency: section.settings.show_currency,
          show_language: section.settings.show_language,
          in_mobile_menu: has_mobile_menu
        -%}
      {%- endif -%}
      <a
        href="{{ routes.cart_url }}"
        class="btn btn--icon site-header__cart"
        {% unless on_cart_page %}
          data-dialog-open="CartDrawer"
          aria-haspopup="dialog"
        {% endunless %}
        aria-label="{{ 'cart.title' | t }}"
      >
        {%- render 'icon', name: 'bag' -%}
        <span
          class="cart-count"
          data-cart-count-bubble
          {% if cart.item_count == 0 %}
            data-empty
          {% endif %}
          aria-hidden="true"
        >
          <span data-ajax-cart-bind="item_count">{{ cart.item_count }}</span>
        </span>
      </a>
    </div>
  </div>
</site-header>

{%- render 'search-panel',
  id: 'SearchPanel',
  style: section.settings.search_style,
  color_scheme: section.settings.search_color_scheme,
  blocks: section.blocks
-%}

{%- if menu.links.size > 0 -%}
  {%- comment -%}
    Mobile menu: a manual popover (not a modal dialog), so the header stays usable and its toggle
    closes the menu. It sits under the header (--header-bottom from @ui/header). Toggle, outside
    click and Esc are handled by @ui/dialog, which also plays the closing animation.
  {%- endcomment -%}
  <div
    id="MenuPanel"
    class="menu-panel color-{{ section.settings.color_scheme }}"
    popover="manual"
    aria-label="{{ 'accessibility.menu' | t }}"
  >
    <div class="menu-panel__inner page-width">
      {%- capture mobile_utility -%}
        {%- if has_mobile_menu -%}
          {%- render 'utility-content',
            id: 'MenuPanelUtility',
            menu: section.settings.utility_menu,
            show_account: section.settings.show_account,
            show_wishlist: section.settings.show_wishlist,
            show_compare: section.settings.show_compare,
            show_currency: section.settings.show_currency,
            show_language: section.settings.show_language
          -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- render 'mobile-menu', menu: menu, utility: mobile_utility -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:general.header",
  "class": "site-header-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.header.layout",
      "options": [
        {
          "value": "logo-left",
          "label": "t:sections.header.layout_logo_left"
        },
        {
          "value": "logo-center-below",
          "label": "t:sections.header.layout_logo_center_below"
        },
        {
          "value": "logo-center-left",
          "label": "t:sections.header.layout_logo_center_left"
        }
      ],
      "default": "logo-left"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:sections.header.menu_info",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:sections.header.behavior"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "t:sections.header.sticky",
      "options": [
        {
          "value": "none",
          "label": "t:sections.header.sticky_none"
        },
        {
          "value": "always",
          "label": "t:sections.header.sticky_always"
        },
        {
          "value": "scroll-up",
          "label": "t:sections.header.sticky_scroll_up"
        }
      ],
      "default": "scroll-up"
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "t:sections.header.transparent",
      "info": "t:sections.header.transparent_info",
      "default": false
    },
    {
      "type": "color",
      "id": "transparent_text_color",
      "label": "t:sections.header.transparent_text_color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.transparent }}"
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "t:sections.header.logo_transparent",
      "info": "t:sections.header.logo_transparent_info",
      "visible_if": "{{ section.settings.transparent }}"
    },
    {
      "type": "header",
      "content": "t:sections.header.search"
    },
    {
      "type": "select",
      "id": "search_style",
      "label": "t:sections.header.search_style",
      "options": [
        {
          "value": "top",
          "label": "t:sections.header.search_style_top"
        },
        {
          "value": "drawer",
          "label": "t:sections.header.search_style_drawer"
        }
      ],
      "default": "top"
    },
    {
      "type": "color_scheme",
      "id": "search_color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "t:sections.header.search_blocks_info"
    },
    {
      "type": "header",
      "content": "t:sections.header.utility_panel"
    },
    {
      "type": "checkbox",
      "id": "show_utility_panel",
      "label": "t:sections.header.show_utility_panel",
      "info": "t:sections.header.show_utility_panel_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.header.show_account",
      "default": true,
      "visible_if": "{{ section.settings.show_utility_panel }}"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "t:sections.header.show_wishlist",
      "default": false,
      "visible_if": "{{ section.settings.show_utility_panel }}"
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "t:sections.header.show_compare",
      "default": false,
      "visible_if": "{{ section.settings.show_utility_panel }}"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "t:sections.header.show_currency",
      "info": "t:sections.header.show_currency_info",
      "default": true,
      "visible_if": "{{ section.settings.show_utility_panel }}"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:sections.header.show_language",
      "default": true,
      "visible_if": "{{ section.settings.show_utility_panel }}"
    },
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "t:sections.header.utility_menu",
      "info": "t:sections.header.utility_menu_info",
      "visible_if": "{{ section.settings.show_utility_panel }}"
    }
  ],
  "blocks": [
    {
      "type": "search_term",
      "name": "t:blocks.search_term.name",
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "t:blocks.search_term.term",
          "info": "t:blocks.search_term.info"
        }
      ]
    },
    {
      "type": "search_link",
      "name": "t:blocks.search_link.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:blocks.search_link.title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:blocks.search_link.link"
        }
      ]
    },
    {
      "type": "search_products",
      "name": "t:blocks.search_products.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:blocks.search_products.heading",
          "default": "Trending now"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:blocks.search_products.collection"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "t:blocks.search_products.products",
          "info": "t:blocks.search_products.products_info",
          "limit": 12
        },
        {
          "type": "range",
          "id": "limit",
          "label": "t:blocks.search_products.limit",
          "min": 2,
          "max": 12,
          "step": 1,
          "default": 8
        }
      ]
    },
    {
      "type": "search_collections",
      "name": "t:blocks.search_collections.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:blocks.search_collections.heading",
          "default": "Shop by category"
        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "t:blocks.search_collections.collections",
          "limit": 8
        }
      ]
    },
    {
      "type": "menu_promo",
      "name": "t:blocks.menu_promo.name",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "t:blocks.menu_item.label",
          "info": "t:blocks.menu_item.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:blocks.menu_promo.image"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "t:blocks.menu_promo.layout",
          "options": [
            { "value": "stacked", "label": "t:blocks.menu_promo.layout_stacked" },
            { "value": "overlay", "label": "t:blocks.menu_promo.layout_overlay" }
          ],
          "default": "overlay"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:blocks.menu_promo.eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:blocks.menu_promo.heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:blocks.menu_promo.text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:blocks.menu_promo.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:blocks.menu_promo.link"
        }
      ]
    },
    {
      "type": "menu_products",
      "name": "t:blocks.menu_products.name",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "t:blocks.menu_item.label",
          "info": "t:blocks.menu_item.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:blocks.menu_products.heading"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "t:blocks.menu_products.products",
          "limit": 4
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
