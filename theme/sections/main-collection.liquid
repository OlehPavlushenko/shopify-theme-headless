{% comment %}
  Collection page: title (the page's h1), description, product grid of product-card, pagination.
  Filters and sorting (Search & Discovery) come in the collection stage.
{% endcomment %}
{%- liquid
  assign per_page = section.settings.products_per_page
-%}
<div
  class="main-collection color-{{ section.settings.color_scheme }} section-spacing"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width stack" style="--stack-gap: var(--space-xl);">
    <header class="main-collection__header stack" style="--stack-gap: var(--space-s);">
      <h1 class="h2">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="main-collection__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by per_page -%}
      {%- if collection.products.size > 0 -%}
        <p class="main-collection__count small muted">
          {{ 'collections.product_count' | t: count: collection.products_count }}
        </p>
        <ul
          id="ProductGrid"
          class="grid main-collection__grid"
          role="list"
          style="--grid-columns: {{ section.settings.columns_desktop }}; --grid-columns-mobile: {{ section.settings.columns_mobile }};"
        >
          {%- for product in collection.products -%}
            {%- liquid
              assign eager = false
              if forloop.index <= section.settings.columns_desktop
                assign eager = true
              endif
            -%}
            <li>
              {%- render 'product-card', product: product, eager: eager, show_vendor: section.settings.show_vendor -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- render 'pagination', paginate: paginate, anchor: '#ProductGrid' -%}
      {%- else -%}
        <div class="main-collection__empty stack">
          <p>{{ 'collections.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue_shopping' | t }}</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.collection",
  "class": "main-collection-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main_collection.show_description",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_collection.products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.main_collection.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.main_search.show_vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
