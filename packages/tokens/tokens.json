{
  "$description": "Design tokens: single source of default values. build.mjs turns every leaf into a CSS custom property named after its path (\"DEFAULT\" adds no suffix): color.accent -> --color-accent, ease.DEFAULT -> --ease. The Shopify theme overrides colors, fonts, page width and radii from Theme settings; a headless storefront uses these defaults or its own overrides.",
  "color": {
    "background": "#ffffff",
    "background-gradient": "none",
    "foreground": "#4d4d4d",
    "heading": "#212121",
    "link-hover": "#500515",
    "accent": "#500515",
    "accent-2": "#c29a10",
    "surface": "#f4f4f4",
    "border": "#d3d3d3",
    "button": "#500515",
    "button-label": "#fafbfb",
    "button-hover": "#9c0929",
    "button-label-hover": "#fafbfb",
    "button-secondary": "#212121",
    "button-secondary-label": "#fafbfb",
    "input-background": "#f8f8f8",
    "input-text": "#212121",
    "success": "#538f17",
    "info": "#022edb",
    "warning": "#db8018",
    "danger": "#db0d3a",
    "focus": "#022edb"
  },
  "font": {
    "body-family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "body-style": "normal",
    "body-weight": "400",
    "body-weight-bold": "700",
    "heading-family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "heading-style": "normal",
    "heading-weight": "600",
    "body-scale": "1",
    "heading-scale": "1"
  },
  "page-width": {
    "DEFAULT": "144rem",
    "narrow": "90rem"
  },
  "gutter": {
    "DEFAULT": "clamp(1.6rem, 4vw, 4rem)"
  },
  "space": {
    "2xs": "0.4rem",
    "xs": "0.8rem",
    "s": "1.2rem",
    "m": "1.6rem",
    "l": "2.4rem",
    "xl": "3.2rem",
    "2xl": "4.8rem",
    "3xl": "6.4rem"
  },
  "radius": {
    "button": "4px",
    "input": "4px",
    "card": "8px",
    "media": "4px",
    "badge": "4px"
  },
  "duration": {
    "short": "120ms",
    "default": "200ms",
    "long": "400ms"
  },
  "ease": {
    "DEFAULT": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "shadow": {
    "overlay": "0 1.2rem 4rem rgb(0 0 0 / 0.18)"
  }
}
