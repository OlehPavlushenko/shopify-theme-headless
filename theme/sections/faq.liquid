{% comment %}
  FAQ: questions and answers as an accordion (blocks), with an optional intro column (eyebrow,
  heading, text, button — e.g. "Contact us"). Native <details>: works without JS; "One open at a
  time" uses the details name attribute. Outputs FAQPage structured data (SEO), built from the
  same blocks — one section per page carries all its questions, so a long FAQ groups them with
  Topic blocks (headings in the list) instead of several sections.
  "Topics and search": the intro also lists the topics as links and gets a search field that
  filters the questions as you type (<faq-search>, @ui/faq-search).
  Styles: .accordion (components.css), .faq (sections.css).
{% endcomment %}
{%- liquid
  assign topics = section.blocks | where: 'type', 'topic'
  assign questions = section.blocks | where: 'type', 'question'
  assign show_nav = section.settings.show_nav
  assign has_intro = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank or show_nav
    assign has_intro = true
  endif
  assign wrapper = 'div'
  if show_nav
    assign wrapper = 'faq-search'
  endif
  assign contact_url = section.settings.button_link | default: routes.root_url
-%}
<div class="faq faq--{{ section.settings.layout }}{% if show_nav %} faq--nav{% endif %} color-{{ section.settings.color_scheme }} section-spacing">
  <{{ wrapper }} class="page-width faq__inner{% if has_intro == false %} faq__inner--list-only{% endif %}">
    {%- if has_intro -%}
      <div class="faq__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte faq__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if show_nav -%}
          {%- comment -%} Search + topics: sticky — in the intro column from 990px, a bar under the header on phones {%- endcomment -%}
          <div class="faq__tools" data-faq-tools>
            <label class="faq__search search-field">
              <span class="visually-hidden">{{ 'faq.search' | t }}</span>
              {%- render 'icon', name: 'search' -%}
              <input type="search" class="input" placeholder="{{ 'faq.search' | t | escape }}" autocomplete="off" data-faq-input>
            </label>
            {%- if topics.size > 0 -%}
              <nav class="faq__nav" aria-label="{{ 'faq.topics' | t | escape }}">
                <ul class="faq__nav-list" role="list">
                  {%- for topic in topics -%}
                    <li><a href="#faq-{{ section.id }}-{{ topic.id }}" class="chip faq__nav-link" data-faq-topic-link>{{ topic.settings.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ contact_url }}" class="btn btn--outline">
            {{- section.settings.button_label | escape -}}
            {%- render 'icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq__list">
      {%- assign topic_id = '' -%}
      {%- assign first_question = true -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'topic' -%}
            {%- assign topic_id = 'faq-' | append: section.id | append: '-' | append: block.id -%}
            {%- comment -%} h2 when the section has no heading of its own (no jump from the page's h1 to h3) {%- endcomment -%}
            {%- if section.settings.heading != blank -%}{%- assign topic_level = 'h3' -%}{%- else -%}{%- assign topic_level = 'h2' -%}{%- endif -%}
            <{{ topic_level }} id="{{ topic_id }}" class="h5 faq__topic" data-faq-topic {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</{{ topic_level }}>
          {%- when 'question' -%}
            <details
              class="accordion"
              data-faq-item
              {% if topic_id != blank %}
                data-topic="{{ topic_id }}"
              {% endif %}
              {% if section.settings.single_open %}
                name="faq-{{ section.id }}"
              {% endif %}
              {% if first_question and section.settings.open_first %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="accordion__summary">
                <span class="accordion__title">{{ block.settings.question | escape }}</span>
                <span class="accordion__icon" aria-hidden="true">{%- render 'icon', name: 'plus' -%}</span>
              </summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
            {%- assign first_question = false -%}
        {%- endcase -%}
      {%- endfor -%}
      {%- if show_nav -%}
        <div class="faq__empty" data-faq-empty hidden>
          <p class="h5">{{ 'faq.no_results_html' | t: terms: '<span data-faq-terms></span>' }}</p>
          <p>{{ 'faq.no_results_text' | t }}</p>
          {%- if section.settings.button_label != blank -%}
            <a href="{{ contact_url }}" class="btn">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
        </div>
        <p class="visually-hidden" role="status" data-faq-status data-label="{{ 'faq.results' | t | escape }}"></p>
      {%- endif -%}
    </div>
  </{{ wrapper }}>
</div>
{%- if show_nav -%}
  <script type="module">import '@ui/faq-search';</script>
{%- endif -%}

{%- comment -%} FAQPage markup only where it is on (the FAQ page): one page per set of questions {%- endcomment -%}
{%- if questions.size > 0 and section.settings.structured_data -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in questions -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.faq.name",
  "class": "faq-section",
  "disabled_on": { "groups": ["*"] },
  "max_blocks": 50,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.faq.layout",
      "options": [
        { "value": "split", "label": "t:sections.faq.layout_split" },
        { "value": "stacked", "label": "t:sections.faq.layout_stacked" }
      ],
      "default": "split"
    },
    { "type": "text", "id": "eyebrow", "label": "t:sections.promo_popup.eyebrow", "default": "FAQ" },
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Questions & answers" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Can't find what you're looking for? Our team replies within a day.</p>" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Contact us" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "checkbox", "id": "show_nav", "label": "t:sections.faq.show_nav", "info": "t:sections.faq.show_nav_info", "default": false },
    { "type": "checkbox", "id": "single_open", "label": "t:sections.faq.single_open", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "t:sections.faq.open_first", "default": false },
    { "type": "checkbox", "id": "structured_data", "label": "t:sections.faq.structured_data", "info": "t:sections.faq.structured_data_info", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "t:sections.faq.topic",
      "settings": [{ "type": "text", "id": "title", "label": "t:labels.heading", "default": "Delivery" }]
    },
    {
      "type": "question",
      "name": "t:sections.faq.question",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq.question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq.answer", "default": "<p>Orders ship within 1–2 business days. Delivery across the country usually takes 2–4 days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>Orders ship within 1–2 business days. Delivery across the country usually takes 2–4 days.</p>" } },
        { "type": "question", "settings": { "question": "Can I return a product?", "answer": "<p>Yes — unopened products can be returned within 14 days. Write to us and we'll arrange a free pickup.</p>" } },
        { "type": "question", "settings": { "question": "How do you choose your products?", "answer": "<p>We try every product ourselves before it goes in the store, and each product page lists its full details.</p>" } },
        { "type": "question", "settings": { "question": "How do I use a discount code?", "answer": "<p>Enter it in the cart under \"Have a promo code?\" — the discount shows before checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
