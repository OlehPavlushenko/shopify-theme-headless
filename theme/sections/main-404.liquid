{% comment %}
  404: a big "404", the page heading (h1), a line of text, a search field and two buttons. Product
  sections can follow in templates/404.json (e.g. best sellers). Styles: .main-404 in sections.css.
{% endcomment %}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = '404.title' | t
  endif
-%}
<div class="main-404 color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width page-width--narrow main-404__inner">
    <p class="main-404__code" aria-hidden="true">404</p>
    <h1 class="h2">{{ heading | escape }}</h1>
    <div class="text-lead main-404__text">{{ section.settings.text }}</div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="main-404__search">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'search.title' | t }}</label>
      <input id="NotFoundSearch" class="input" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
      <button type="submit" class="btn">{{ 'search.submit' | t }}</button>
    </form>
    <div class="main-404__actions">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">
        {{- '404.back_to_shopping' | t -}}
        {%- render 'icon', name: 'arrow-right' -%}
      </a>
      <a href="{{ routes.root_url }}" class="btn btn--link">{{ '404.home' | t }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "class": "main-404-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "We can't find that page" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>The link may be old or the page has moved. Try a search, or keep browsing from the catalog.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
