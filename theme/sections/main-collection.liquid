{% comment %}
  Product grid with filters — the collection page (templates/collection.json, under the Page
  header) and the search results (templates/search.json, under Search header): toolbar, active
  filter chips, the filters panel in one of three layouts — sidebar, horizontal dropdowns or drawer;
  always a drawer on phones — and the grid, then "Load more" or page numbers (snippets/facets-page).
  On search the filters, sort and results come from search.* and the terms ride along in the form;
  nothing renders before a search. <facet-filters> (assets/facets.js) re-renders this section
  through the Section Rendering API on every change and keeps the URL in sync; without JS the form
  and the links still work. Styles: packages/ui/css/facets.css.
{% endcomment %}
{%- liquid
  assign per_page = section.settings.products_per_page
  assign is_search = false
  if template.name == 'search'
    assign is_search = true
    assign filters = search.filters
    assign sort_by = search.sort_by | default: search.default_sort_by
    assign terms = search.terms | escape
    assign clear_url = routes.search_url | append: '?q=' | append: search.terms | url_encode | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
    assign count = search.results_count
    assign count_label = 'search.results_count' | t: count: count
  else
    assign filters = collection.filters
    assign sort_by = collection.sort_by | default: collection.default_sort_by
    assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
    assign count = collection.products_count
    assign count_label = 'collections.product_count' | t: count: count
  endif
  assign has_filters = false
  if section.settings.show_filters and filters.size > 0
    assign has_filters = true
  endif
-%}
{%- unless is_search and search.performed == false -%}
<facet-filters
  class="main-collection facets facets--{{ section.settings.filters_layout }}{% if has_filters == false %} facets--none{% endif %} color-{{ section.settings.color_scheme }} section-spacing"
  data-section="{{ section.id }}"
>
  {%- if is_search -%}
    {%- paginate search.results by per_page -%}
      {%- render 'facets-page',
        section: section,
        items: search.results,
        paginate: paginate,
        filters: filters,
        sort_options: search.sort_options,
        sort_by: sort_by,
        count: count,
        count_label: count_label,
        clear_url: clear_url,
        terms: terms
      -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- paginate collection.products by per_page -%}
      {%- render 'facets-page',
        section: section,
        items: collection.products,
        paginate: paginate,
        filters: filters,
        sort_options: collection.sort_options,
        sort_by: sort_by,
        count: count,
        count_label: count_label,
        clear_url: clear_url
      -%}
    {%- endpaginate -%}
  {%- endif -%}
</facet-filters>
<script type="module">import 'facets';</script>
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "class": "main-collection-section",
  "settings": [
    { "type": "header", "content": "t:sections.main_collection.filters_header" },
    { "type": "checkbox", "id": "show_filters", "label": "t:sections.main_collection.show_filters", "info": "t:sections.main_collection.show_filters_info", "default": true },
    {
      "type": "select",
      "id": "filters_layout",
      "label": "t:sections.main_collection.filters_layout",
      "info": "t:sections.main_collection.filters_layout_info",
      "options": [
        { "value": "sidebar", "label": "t:sections.main_collection.layout_sidebar" },
        { "value": "horizontal", "label": "t:sections.main_collection.layout_horizontal" },
        { "value": "drawer", "label": "t:sections.main_collection.layout_drawer" }
      ],
      "default": "sidebar"
    },
    { "type": "checkbox", "id": "show_sort", "label": "t:sections.main_collection.show_sort", "default": true },
    { "type": "checkbox", "id": "show_density", "label": "t:sections.main_collection.show_density", "default": true },
    { "type": "header", "content": "t:sections.main_collection.grid_header" },
    { "type": "range", "id": "products_per_page", "label": "t:sections.main_collection.products_per_page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.main_collection.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.main_collection.pagination",
      "options": [
        { "value": "load_more", "label": "t:sections.main_collection.pagination_load_more" },
        { "value": "pages", "label": "t:sections.main_collection.pagination_pages" }
      ],
      "default": "load_more"
    },
    { "type": "checkbox", "id": "quick_add", "label": "t:sections.product_list.quick_add", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.main_search.show_vendor", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "t:sections.main_collection.promo",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "position", "label": "t:sections.main_collection.promo_position", "info": "t:sections.main_collection.promo_position_info", "min": 1, "max": 24, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "image", "label": "t:sections.hero.image" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.promo_popup.eyebrow", "default": "Gift ideas" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Ready-to-give sets" },
        { "type": "text", "id": "text", "label": "t:labels.text", "default": "Free gift wrapping on every order" },
        { "type": "text", "id": "link_label", "label": "t:labels.button_label", "default": "Shop sets" },
        { "type": "url", "id": "link", "label": "t:labels.button_link" }
      ]
    }
  ]
}
{% endschema %}
