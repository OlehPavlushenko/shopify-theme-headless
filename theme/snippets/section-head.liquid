{% doc %}
  Heading row of a content section: an h2 on the left, an optional "view all" link on the right.
  Inside a <ui-slider> it also takes the slider arrows (nav: true). Styles: packages/ui/css/sections.css.

  @param {string} [heading] - Section heading (rich text allowed)
  @param {string} [link_label] - Text of the link on the right
  @param {string} [link] - URL of the link
  @param {boolean} [nav] - Render the slider arrows (inside <ui-slider>)
{% enddoc %}
{%- if heading != blank or link_label != blank or nav -%}
  <div class="section-head{% if nav %} slider__head{% endif %}">
    {%- if heading != blank -%}
      <h2 class="h3 section-head__title">{{ heading }}</h2>
    {%- endif -%}
    {%- if link_label != blank or nav -%}
      <div class="section-head__end">
        {%- if link_label != blank and link != blank -%}
          <a href="{{ link }}" class="section-head__link">
            {{- link_label | escape -}}
            {%- render 'icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
        {%- if nav -%}
          {%- assign nav_label = heading | strip_html -%}
          {%- render 'slider-nav', label: nav_label -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
