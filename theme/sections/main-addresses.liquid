{% comment %}
  Addresses (templates/customers/addresses.json): account tabs, "Add a new address" opening its
  form, and the address cards — default first, with Edit (its form opens in place) and Delete
  (asks first). Country / province selects come from Shopify's CountryProvinceSelector
  (shopify_common.js). <details> open and close the forms without JS; Cancel closes them with it.
  Styles: packages/ui/css/account.css.
{% endcomment %}
{%- paginate customer.addresses by 10 -%}
  <div class="account color-{{ section.settings.color_scheme }} section-spacing">
    <div class="page-width account__inner">
      <header class="account__head">
        <h1 class="h2">{{ 'customers.addresses.title' | t }}</h1>
        {%- render 'account-nav' -%}
      </header>

      {%- form 'customer_address', customer.new_address -%}
        <details class="account-panel account-address-new"{% if form.errors %} open{% endif %}>
          <summary class="btn btn--outline account-address-new__toggle">
            {%- render 'icon', name: 'plus' -%}
            {{- 'customers.addresses.add_new' | t -}}
          </summary>
          <div class="account-panel__body account-form">
            <h2 class="h5">{{ 'customers.addresses.add_new' | t }}</h2>
            {%- render 'form-errors', errors: form.errors -%}
            {%- render 'address-form', form: form, id: 'AddressNew', is_new: true -%}
          </div>
        </details>
      {%- endform -%}

      <ul class="account-addresses" role="list">
        {%- for address in customer.addresses -%}
          <li class="account-address{% if address == customer.default_address %} account-address--default{% endif %}">
            {%- if address == customer.default_address -%}
              <span class="pill">{{ 'customers.addresses.default' | t }}</span>
            {%- endif -%}
            <address class="account-address__text">{{ address | format_address }}</address>
            <div class="account-address__actions">
              {%- form 'customer_address', address -%}
                <details class="account-address__edit"{% if form.errors %} open{% endif %}>
                  <summary class="btn btn--link">{{ 'customers.addresses.edit' | t }}</summary>
                  <div class="account-form account-address__form">
                    {%- render 'form-errors', errors: form.errors -%}
                    {%- assign form_id = 'Address' | append: address.id -%}
                    {%- render 'address-form', form: form, id: form_id -%}
                  </div>
                </details>
              {%- endform -%}
              <form method="post" action="{{ address.url }}" class="account-address__delete" data-confirm="{{ 'customers.addresses.delete_confirm' | t | escape }}">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="btn btn--link">{{ 'customers.addresses.delete' | t }}</button>
              </form>
            </div>
          </li>
        {%- else -%}
          <li class="empty-state">
            {%- render 'icon', name: 'map-pin' -%}
            <p>{{ 'customers.addresses.empty' | t }}</p>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate, anchor: '' -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
<script>
  // Country → province selects (Shopify's helper, deferred: it has run by DOMContentLoaded),
  // Cancel closes the form, Delete asks first
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-country-select]').forEach((select) => {
      const id = select.dataset.countrySelect;
      new Shopify.CountryProvinceSelector(`${id}-country`, `${id}-province`, { hideElement: `${id}-province-field` });
    });
  });
  document.addEventListener('click', (event) => {
    const cancel = event.target.closest('[data-address-cancel]');
    if (cancel) cancel.closest('details').open = false;
  });
  document.querySelectorAll('[data-confirm]').forEach((form) =>
    form.addEventListener('submit', (event) => {
      if (!confirm(form.dataset.confirm)) event.preventDefault();
    })
  );
</script>

{% schema %}
{
  "name": "t:sections.account.addresses",
  "class": "main-addresses-section",
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }]
}
{% endschema %}
