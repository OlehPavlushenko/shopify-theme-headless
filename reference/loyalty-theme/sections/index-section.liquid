<div class="page-width index-section">
    <h1>Heading 1</h1>
    <h2>Heading 2</h2>
    <h3>Heading 3</h3>
    <h4>Heading 4</h4>
    <h5>Heading 5</h5>
    <h6>Heading 6</h6>

    <p>
        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Dolorem reiciendis suscipit sint inventore quae!
        Veniam ipsam, commodi expedita magni atque similique reiciendis obcaecati recusandae mollitia sequi amet
        consequuntur incidunt nisi.
    </p>
    <p class="font-large">Larger paragraph font</p>
    <p class="utility">Utility</p>

    <blockquote>Blockquote</blockquote>

    <ul>
        <li>List element</li>
        <li>List element</li>
        <li>List element</li>
        <li>List element</li>
    </ul>

    <ol>
        <li>List element</li>
        <li>List element</li>
        <li>List element</li>
        <li>List element</li>
    </ol>

    <p>
        <a href="#">Inline link</a>
    </p>
    <p>
        <caption>
            Table caption text
        </caption>
    </p>

    <table>
        <thead>
            <tr>
                <th>Column</th>
                <th>Column</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Value 1</td>
                <td>Value 2</td>
            </tr>
        </tbody>
    </table>
    <hr>

    <h3>Form elements</h3>

    <form action="">
        {% render 'success-message', mod_message: 'Form Level Success Message!' %}
        {% render 'error-message', mod_message: 'Form Validation' %}

        <div class="form-row">
            <h3>Error input</h3>
            {% render 'input',
                mod_input_id: 'user-email',
                mod_input_name: 'user-email',
                mod_input_type: 'email',
                mod_input_label: 'Email',
                mod_custom_input_classes: 'has-error'
            %}
            {% render 'error-message',
                mod_message: 'Please enter a valid email',
                mod_is_input: true,
                mod_is_inline: true
            %}
        </div>
        <div class="form-row">
            <h3>Normal input</h3>
            {% render 'input',
                mod_input_id: 'user-name',
                mod_input_name: 'user-name',
                mod_input_type: 'text',
                mod_input_label: 'Name',
                mod_input_placeholder: 'Enter name'
            %}
        </div>

        <div class="form-row">
            <h3>Normal select</h3>
            <div class="input-label">
                <label class="label" for="normal_drop">Subject</label>
                <select name="normal" id="normal_drop">
                    <option value="v1">option 1</option>
                    <option value="v2">option 2</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <h3>Input (text)</h3>
            {% render 'input',
                mod_input_id: 'user-address',
                mod_input_name: 'user-address',
                mod_input_label: 'Address',
                mod_input_placeholder: 'Enter address'
            %}
        </div>
        <div class="form-row">
            <h3>Input (textarea)</h3>
            {% render 'input',
                mod_input_id: 'user-message',
                mod_input_name: 'user-message',
                mod_use_textarea: true,
                mod_input_label: 'Message',
                mod_input_placeholder: 'Enter message'
            %}
        </div>
        <div class="form-row">
            <h3>Radio and checkbox</h3>
            <input type="radio" id="my-radio">
            <label for="my-radio">Label</label>
            <input type="checkbox" id="my-checkbox">
            <label for="my-checkbox">Label</label>
        </div>
        <div class="form-row form-row--submit">
            <button type="button">primary</button>
            <button type="button" class="button button--outline">outline</button>
            <button type="button" disabled>disabled</button>
        </div>
        <div class="form-row form-row--submit">
            <button type="button" class="button button--middle">middle</button>
            <button type="button" class="button button--outline button--middle">outline middle</button>
        </div>
        <div class="form-row form-row--submit">
            <button type="button" class="button button--large">primary large</button>
            <button type="button" class="button button--outline button--large">outline large</button>
        </div>
        <div class="form-row form-row--submit">
            <button type="button" class="button button--secondary">secondary</button>
            <button type="button" class="button button--secondary button--outline">secondary outline</button>
            <button type="button" class="button button--secondary" disabled>secondary disabled</button>
        </div>
        <div class="form-row form-row--submit">
            <button type="button" class="button button--secondary button--middle">secondary middle</button>
            <button type="button" class="button button--secondary button--outline button--middle">
                secondary outline middle
            </button>
        </div>
        <div class="form-row form-row--submit">
            <button type="button" class="button button--secondary button--large">secondary large</button>
            <button type="button" class="button button--secondary button--outline button--large">
                secondary outline large
            </button>
        </div>
        <div class="form-row form-row--submit">
            <button type="button" class="button button--link">Button link</button>
            <button type="button" class="button button--link" disabled>Button link</button>
        </div>
    </form>
    <hr>
</div>
<style>
    .index-section form {
        width: 50%;
    }
    @media screen and (max-width: 750px) {
        .index-section form {
            width: 100%;
        }
    }
</style>
