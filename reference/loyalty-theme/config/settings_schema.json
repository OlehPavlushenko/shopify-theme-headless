      },
      {
        "type": "header",
        "content": "Upsell"
      },
      {
        "type": "checkbox",
        "id": "show_recommend_prod",
        "label": "Show upsell products",
        "default": true
      },
      {
        "type": "product_list",
        "id": "recommend_list",
        "label": "Upsell products",
        "limit": 6,
        "info": "Shown in the cart drawer and on the cart page, skipping products already in the cart."
      },
      {
        "type": "header",
        "content": "Order details"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Show order note",
        "default": true
