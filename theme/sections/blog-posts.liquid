{% comment %}
  Blog posts: the latest articles of a blog as cards (snippets/article-card) in a slider that turns
  into a full row on wide screens. Without a picked blog: the current blog (on an article page,
  where the article itself is skipped — "More articles"), else the store's first blog.
  Styles: packages/ui/css/sections.css.
{% endcomment %}
{%- liquid
  assign source = section.settings.blog | default: blog | default: blogs.first
  assign link = source.url
  assign shown = 0
-%}
<div class="blog-posts color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width">
    <ui-slider class="slider" style="--slider-columns: {{ section.settings.columns }}; --slider-columns-mobile: 1.2;">
      {%- render 'section-head', heading: section.settings.heading, link_label: section.settings.link_label, link: link, nav: true -%}
      <ul class="scroll-track slider__track" data-slider-track role="list">
        {%- for post in source.articles -%}
          {%- if post.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>
            {%- render 'article-card',
              article: post,
              show_date: section.settings.show_date,
              show_excerpt: section.settings.show_excerpt,
              sizes: '(min-width: 990px) 33vw, 85vw'
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </ui-slider>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "class": "blog-posts-section",
  "disabled_on": { "groups": ["*"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "From the blog" },
    { "type": "blog", "id": "blog", "label": "t:labels.blog", "info": "t:sections.blog_posts.blog_info" },
    { "type": "range", "id": "limit", "label": "t:labels.limit", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "t:labels.columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "t:sections.blog_posts.show_date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "t:sections.blog_posts.show_excerpt", "default": true },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "View all" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:sections.blog_posts.name" }]
}
{% endschema %}
