<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'meta-tags' -%}
    {{ 'ui-tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-components.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-tokens' -%}
    {%- render 'color-schemes' -%}
    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
