{% comment %}
  The blog's search results (templates/search.blog.json — /search?type=article&view=blog, from the
  blog's search field; snippets/search-options): the article count, the matching articles as the
  blog's cards (snippets/article-card) with "Load more" (@ui/load-more) or page numbers, and an
  empty state with a way back to the blog. Nothing renders before a search.
  Styles: the blog's (.main-blog__* in sections.css).
{% endcomment %}
{%- if search.performed -%}
  {%- assign terms = search.terms | escape -%}
  {%- paginate search.results by section.settings.per_page -%}
    <div class="main-article-search color-{{ section.settings.color_scheme }} section-spacing">
      <load-more data-section="{{ section.id }}">
        <div class="page-width">
          {%- if search.results_count == 0 -%}
            <div class="empty-state">
              {%- render 'icon', name: 'search' -%}
              <p class="h5">{{ 'blog.search_none_html' | t: terms: terms }}</p>
              {%- if section.settings.blog -%}
                <a href="{{ section.settings.blog.url }}" class="btn btn--outline">{{ 'blog.all_articles' | t }}</a>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="main-blog__active">
              <span class="main-blog__count" role="status">{{ 'blog.articles_count' | t: count: search.results_count }}</span>
            </div>
            <ul class="grid main-blog__grid" role="list" style="--grid-columns: 3; --grid-columns-mobile: 1;" data-load-more-grid>
              {%- for article in search.results -%}
                {%- if article.object_type != 'article' -%}{%- continue -%}{%- endif -%}
                <li data-load-more-item>
                  {%- render 'article-card', article: article, heading_tag: 'h2', show_tags: true, sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' -%}
                </li>
              {%- endfor -%}
              {%- if section.settings.pagination == 'load_more' -%}
                {%- assign shown = paginate.current_offset | plus: search.results.size -%}
                {%- render 'load-more-cell', paginate: paginate, shown: shown -%}
              {%- endif -%}
            </ul>
            {%- if section.settings.pagination == 'pages' -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </load-more>
    </div>
  {%- endpaginate -%}
  {%- if section.settings.pagination == 'load_more' -%}
    <script type="module">import '@ui/load-more';</script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_article_search.name",
  "class": "main-article-search-section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "t:sections.main_article_search.per_page", "min": 3, "max": 24, "step": 3, "default": 9 },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:sections.main_collection.pagination",
      "options": [
        { "value": "load_more", "label": "t:sections.main_collection.pagination_load_more" },
        { "value": "pages", "label": "t:sections.main_collection.pagination_pages" }
      ],
      "default": "load_more"
    },
    { "type": "blog", "id": "blog", "label": "t:sections.main_search.blog" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "disabled_on": { "groups": ["*"] }
}
{% endschema %}
