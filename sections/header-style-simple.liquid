{% liquid
    assign logo = section.settings.logo
    assign logo_alt = section.settings.logo.alt | default: shop.name | escape
    assign logo_width = section.settings.logo_width
    assign logo_height = section.settings.logo_width | divided_by: settings.logo.aspect_ratio


    assign enable_transparent_header = section.settings.enable_transparent_header
    assign enable_sticky_header = section.settings.enable_sticky_header
    assign style_search = section.settings.style_drawer_search

    assign menu = section.settings.menu
    assign top_menu = section.settings.top_menu
    assign logo_width = section.settings.logo_width

    assign compare = section.settings.link_compare
    assign wishlist = section.settings.link_wishlist

    assign enable_currency = section.settings.enable_currency
    assign enable_language = section.settings.enable_language

    assign header_bg = section.settings.header_bg_color
    assign drawer_bg = section.settings.drawer_bg_color
    assign text_color = section.settings.text_color
    assign link_color = section.settings.link_color
    assign link_hover_color = section.settings.link_hover_color
    assign icon_color = section.settings.icon_color
    assign badge_bg_color = section.settings.badge_bg_color
    assign badge_text_color = section.settings.badge_text_color

    assign blocks = section.blocks
    assign settings = section.settings
    assign full_width = section.settings.full_width

    assign pad_top = section.settings.padding_top
    assign pad_bot = section.settings.padding_bottom

    if enable_transparent_header == true and template == 'index'
        assign transparent_header = ' transparent-header'
    endif
%}

{%- capture styles -%}
--header-background: {{ header_bg }};
--header-background-drawer: {{ drawer_bg }};
--header-text-color: {{ text_color }};
--header-link-color: {{ link_color }};
--header-link-hover-color: {{ link_hover_color }};
--header-icon-color: {{ icon_color }};
--header-badge-background: {{ badge_bg_color }};
--header-badge-text-color: {{ badge_text_color }};

--header-logo-width: {{ logo_width }}px;
--header-pad-top: {{ pad_top }}px;
--header-pad-bot: {{ pad_bot }}px;
{%- endcapture -%}

{%- assign styles = styles | strip_newlines -%}

<section-header
    id="shopify-section-header"
    class="header__wrapper full_width--{{ full_width }} header-style-simple {{ transparent_header }}"
    style="{{- styles -}}"
    data-sticky-type="always"
>
    <header class="header-main">
        <div class="container">
            <div class="header__row">
                <div class="header__col-mobile-drawer">
                    <a
                        href="#open"
                        class="header__mobile-drawer-link"
                    >
                    {% render 'icons-svg', icons: 'menu' %}
                    </a>
                </div>
                
                <div class="header__col-logo">
                    <div class="header__logo-wrapper">
                        {% if request.page_type == 'index' %}
                            <h1 class="header__heading">
                                <a href="{{ routes.root_url }}" class="header__logo-link">
                                    {% if logo != blank %}
                                        {{
                                            logo
                                            | image_url: width: section.settings.width
                                            | image_tag:
                                                class: 'header__logo',
                                                widths: '50, 100, 150, 200, 250',
                                                height: logo_height,
                                                width: logo_width,
                                                alt: logo_alt
                                        }}
                                    {% else %}
                                        <span class="h2">{{ shop.name }}</span>
                                    {% endif %}
                                </a>
                            </h1>
                        {% else %}
                            <a href="{{ routes.root_url }}" class="header__logo-link">
                                {% if logo != blank %}
                                    {{
                                        logo
                                        | image_url: width: section.settings.width
                                        | image_tag:
                                            class: 'header__logo',
                                            widths: '50, 100, 150, 200, 250',
                                            height: logo_height,
                                            width: logo_width,
                                            alt: logo_alt
                                    }}
                                {% else %}
                                    <span class="h2">{{ shop.name }}</span>
                                {% endif %}
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="header__col-navigation">
                    {%- render 'header-navigation', menu: menu, blocks: blocks, settings: settings -%}
                </div>

                <div class="header__col-icons">
                        <ul class="header__list-icons list-style-none">
                            <li class="header__list-icons-item header__item--search">
                                <details-open>
                                    {%- render 'header-search', blocks: blocks , style_search: style_search -%}
                                </details-open>
                            </li>
                            {%- if shop.customer_accounts_enabled -%}
                                <li class="header__list-icons-item header__item--user">
                                    <details-open>
                                        <a
                                            class="header__menu-item-link js-summary"
                                            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
                                        >
                                            {%- render 'icons-svg', icons: 'user' -%}
                                            <span class="header__menu-item-text">
                                                {%- liquid
                                                    if customer
                                                        echo 'customer.account_fallback' | t
                                                    else
                                                        echo 'customer.log_in' | t
                                                    endif
                                                -%}
                                            </span>
                                        </a>
                                        <div id="userLinks" class="header__list-icons-details js-details">
                                            <ul class="header__user-list list-style-none">
                                                {%- for link in linklists[top_menu].links -%}
                                                    <li>
                                                        <a href="{{ link.url }}">{{ link.title }}</a>
                                                    </li>
                                                {%- endfor -%}
                                                {%- if compare != blank -%}
                                                    <li>
                                                        <a href="{{ wishlist }}">{{ 'pages.wishlist' | t }}</a>
                                                    </li>
                                                {%- endif -%}
                                                {%- if wishlist != blank -%}
                                                    <li>
                                                        <a href="{{ compare }}">{{ 'pages.compare' | t }}</a>
                                                    </li>
                                                {%- endif -%}
                                            </ul>
                                        </div>
                                    </details-open>
                                </li>
                            {%- endif -%}
                            {% if enable_currency != blank or enable_language != blank %}
                                <li class="header__list-icons-item header__item--params">
                                    <details-open>
                                        <a
                                            class="header__menu-item-link js-summary"
                                            href="#"
                                        >
                                            {% render 'icons-svg', icons: 'params' %}
                                        </a>
                                        <div id="settingsBox" class="header__list-icons-details js-details">
                                            {% if enable_currency != blank %}
                                                <div class="currency-picker">
                                                    <span>{{ 'header.currency' | t }}:</span>
                                                    <localization-form>
                                                        {% form 'localization', id: 'CurrencyForm', class: 'localization-form' %}
                                                            <div class="no-js-hidden">
                                                                <ul
                                                                    id="CurrencyList"
                                                                    role="list"
                                                                    class="header__menu-select list-style-none"
                                                                >
                                                                    {%- for currency in shop.enabled_currencies -%}
                                                                        <li class="localization-form__item">
                                                                            <a
                                                                                class="link link--text localization-form{% if currency == cart.currency %} active{% endif %} focus-inset"
                                                                                href="#"
                                                                                lang="{{ currency.iso_code }}"
                                                                                {% if currency == cart.currency %}
                                                                                    aria-current="true"
                                                                                {% endif %}
                                                                                data-value="{{ currency.iso_code }}"
                                                                            >
                                                                                {{ currency.iso_code -}}
                                                                                {{- currency.symbol }}
                                                                            </a>
                                                                        </li>
                                                                    {%- endfor -%}
                                                                </ul>
                                                                <input
                                                                    type="hidden"
                                                                    name="currency_code"
                                                                    value="{{ localization.country.iso_code }}"
                                                                >
                                                            </div>
                                                        {% endform %}
                                                    </localization-form>
                                                </div>
                                            {% endif %}
                                            {% if enable_language != blank %}
                                                <div class="language-picker">
                                                    <span>{{ 'header.language' | t }}:</span>
                                                    <localization-form>
                                                        {%- form 'localization', id: 'LanguageForm', class: 'localization-form' -%}
                                                            <div class="no-js-hidden">
                                                                <ul
                                                                    id="LanguageList"
                                                                    role="list"
                                                                    class="header__menu-select list-style-none"
                                                                >
                                                                    {%- for language in localization.available_languages -%}
                                                                        <li class="localization-form__item">
                                                                            <a
                                                                                class="link link--text localization-form{% if language.iso_code == localization.language.iso_code %} active{% endif %} focus-inset"
                                                                                href="#"
                                                                                hreflang="{{ language.iso_code }}"
                                                                                lang="{{ language.iso_code }}"
                                                                                {% if language.iso_code == localization.language.iso_code %}
                                                                                    aria-current="true"
                                                                                {% endif %}
                                                                                data-value="{{ language.iso_code }}"
                                                                            >
                                                                                {{ language.endonym_name | capitalize }}
                                                                            </a>
                                                                        </li>
                                                                    {%- endfor -%}
                                                                </ul>
                                                                <input
                                                                    type="hidden"
                                                                    name="locale_code"
                                                                    value="{{ localization.language.iso_code }}"
                                                                >
                                                            </div>
                                                        {%- endform -%}
                                                    </localization-form>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </details-open>
                                </li>
                            {% endif %}
                            <li class="header__list-icons-item header__item--cart">
                                <a
                                    type="button"
                                    href="{{ routes.cart_url }}"
                                    data-ajax-cart-toggle-class-button="js-show-ajax-cart"
                                    class="header__cart-item-link header__menu-item-link cart-page-link mobile-cart-page-link js-ajax-cart-btn"
                                >
                                    {%- render 'icons-svg', icons: 'cart' -%}
                                    <span class="header__menu-item-text">
                                        {{ 'sections.cart.cart' | t }}
                                    </span>
                                    <span class="cart-count{% if cart.item_count == 0 %} hidden-count{% endif %}">
                                        <span class="cart-count-count" data-ajax-cart-bind="item_count">
                                            {{- cart.item_count -}}
                                        </span>
                                        <span class="cart-count-line"> - </span>
                                        {%- if settings.currency_code_enabled -%}
                                            <span class="cart-count-ajax-cart" data-ajax-cart-bind="total_price | money_with_currency">
                                                {{ cart.total_price | money_with_currency }}
                                            </span>
                                        {%- else -%}
                                            <span class="cart-count-ajax-cart" data-ajax-cart-bind="total_price | money">
                                                {{ cart.total_price | money }}
                                            </span>
                                        {%- endif -%}
                                    </span>
                                </a>
                            </li>
                        </ul>
                </div>
            </div>
        </div>
    </header>
</section-header>

<script type="application/ld+json">
    {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo %}
    {% assign image_size = section.settings.logo.width | append: 'x' %}
    "logo": {{ section.settings.logo | img_url: image_size | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
    {{ settings.social_twitter_link | json }}
    {{ settings.social_facebook_link | json }}
    {{ settings.social_pinterest_link | json }}
    {{ settings.social_instagram_link | json }}
    {{ settings.social_tiktok_link | json }}
    {{ settings.social_whatsapp_link | json }}
    {{ settings.social_youtube_link | json }}
    ],
    "url": {{ shop.url | append: page.url | json }}
    }
</script>

{% if request.page_type == 'index' %}
    {% assign potential_action_target = shop.url | append: routes.search_url | append: '?q={search_term_string}' %}
    <script type="application/ld+json">
        {
        "@context": "http://schema.org",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
        },
        "url": {{ shop.url | append: page.url | json }}
        }
    </script>
{% endif %}

