{% doc %}
  The options every store search carries — one place, so the search page, its filters and every
  form and link to it ask for the same thing:
  - products: products only, the last word as a prefix, sold-out products last. The search page
    matches by meaning (Shopify's semantic search: it ignores options[fields]), so it finds more than
    the panel, which matches words in the title, type, variant, vendor, tag and SKU;
  - articles (the blog's search): articles only, the last word as a prefix; view=blog renders
    templates/search.blog.json.
  The panel's own request is in snippets/search-panel.

  @param {string} [scope] - products (default) | articles
  @param {string} [format] - inputs (hidden form fields, default) | query (a query string that
    starts with "&", to append to "?q=…")
{% enddoc %}
{%- if scope == 'articles' -%}
  {%- if format == 'query' -%}
    &type=article&options%5Bprefix%5D=last&view=blog
  {%- else -%}
    <input type="hidden" name="type" value="article">
    <input type="hidden" name="options[prefix]" value="last">
    <input type="hidden" name="view" value="blog">
  {%- endif -%}
{%- elsif format == 'query' -%}
  &type=product&options%5Bprefix%5D=last&options%5Bunavailable_products%5D=last
{%- else -%}
  <input type="hidden" name="type" value="product">
  <input type="hidden" name="options[prefix]" value="last">
  <input type="hidden" name="options[unavailable_products]" value="last">
{%- endif -%}
