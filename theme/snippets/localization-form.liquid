{% doc %}
  Currency or language switcher (Shopify Markets) as a list of buttons; each button submits the
  localization form on its own, no JS needed. Renders nothing when there is only one option.

  Currency: Markets ties currency to the country, so the list shows each currency once and
  submits a country that uses it (the current country when it already uses that currency).

  @param {string} type - 'currency' or 'language'
{% enddoc %}
{%- liquid
  assign current_country = localization.country
  assign currency_codes = localization.available_countries | map: 'currency' | map: 'iso_code' | uniq
-%}
{%- case type -%}
  {%- when 'currency' -%}
    {%- if currency_codes.size > 1 -%}
      {%- form 'localization', class: 'localization' -%}
        <p class="localization__label">{{ 'localization.currency' | t }}</p>
        <div class="localization__options">
          {%- for code in currency_codes -%}
            {%- liquid
              assign target = null
              if current_country.currency.iso_code == code
                assign target = current_country
              else
                for country in localization.available_countries
                  if country.currency.iso_code == code
                    assign target = country
                    break
                  endif
                endfor
              endif
              assign is_current = false
              if current_country.currency.iso_code == code
                assign is_current = true
              endif
            -%}
            <button
              type="submit"
              name="country_code"
              value="{{ target.iso_code }}"
              class="chip"
              aria-pressed="{{ is_current }}"
            >
              {{- code }} {{ target.currency.symbol -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endform -%}
    {%- endif -%}

  {%- when 'language' -%}
    {%- if localization.available_languages.size > 1 -%}
      {%- form 'localization', class: 'localization' -%}
        <p class="localization__label">{{ 'localization.language' | t }}</p>
        <div class="localization__options">
          {%- for language in localization.available_languages -%}
            <button
              type="submit"
              name="language_code"
              value="{{ language.iso_code }}"
              lang="{{ language.iso_code }}"
              class="chip"
              aria-pressed="{% if language.iso_code == localization.language.iso_code %}true{% else %}false{% endif %}"
            >
              {{- language.endonym_name | capitalize -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endform -%}
    {%- endif -%}
{%- endcase -%}
