{% doc %}
  Utility panel: an icon in the header that opens a panel with account, wishlist and compare links,
  an optional utility menu, and the currency/language switchers (snippets/utility-content).
  A .drawer on a manual popover (top layer from the browser); @ui/dialog handles the buttons,
  outside click and Esc, and plays the closing animation.
  Renders nothing, icon included, when the panel would be empty. With in_mobile_menu the same
  content is at the bottom of the mobile menu, so the icon shows from 990px only.

  @param {string} id - Popover element id
  @param {object} [menu] - link_list with extra links (shipping, contacts, help…)
  @param {boolean} show_account - Show the account link
  @param {boolean} show_wishlist - Show the wishlist link
  @param {boolean} show_compare - Show the compare link
  @param {boolean} show_currency - Show the currency switcher
  @param {boolean} show_language - Show the language switcher
  @param {boolean} [in_mobile_menu] - The mobile menu shows this content too: no icon below 990px
{% enddoc %}
{%- capture content -%}
  {%- render 'utility-content',
    id: id,
    menu: menu,
    show_account: show_account,
    show_wishlist: show_wishlist,
    show_compare: show_compare,
    show_currency: show_currency,
    show_language: show_language
  -%}
{%- endcapture -%}

{%- if content != blank -%}
  <button
    type="button"
    class="btn btn--icon utility-panel__trigger{% if in_mobile_menu %} utility-panel__trigger--desktop{% endif %}"
    popovertarget="{{ id }}"
    aria-label="{{ 'accessibility.utility_panel' | t }}"
  >
    {%- render 'icon', name: 'sliders' -%}
  </button>

  <div id="{{ id }}" class="drawer utility-panel" popover="manual" aria-labelledby="{{ id }}-title">
    <div class="drawer__inner">
      <div class="drawer__header">
        <p id="{{ id }}-title" class="h5">{{ 'accessibility.utility_panel' | t }}</p>
        <button
          type="button"
          class="btn btn--icon"
          popovertarget="{{ id }}"
          popovertargetaction="hide"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {%- render 'icon', name: 'close' -%}
        </button>
      </div>
      <div class="drawer__body utility-panel__body">{{ content }}</div>
    </div>
  </div>
{%- endif -%}
