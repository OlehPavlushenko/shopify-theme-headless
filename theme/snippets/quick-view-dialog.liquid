{% doc %}
  Quick view popup shell (one per page, in the layout). quick-view.js fills it with
  sections/quick-view for the product whose [data-quick-view] link was clicked.
  Styles: packages/ui/css/product-card.css.
{% enddoc %}
<dialog id="QuickView" class="popup quick-view-dialog" aria-label="{{ 'products.quick_view' | t }}">
  <div class="quick-view-dialog__inner">
    {%- render 'close-button', class: 'quick-view-dialog__close' -%}
    <div class="quick-view-dialog__content" data-quick-view-content aria-live="polite"></div>
  </div>
</dialog>
