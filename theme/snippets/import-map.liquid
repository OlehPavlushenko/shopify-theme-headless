      "@ui/lazy-section": "{{ 'ui-lazy-section.js' | asset_url }}",
      "@ui/saved-pages": "{{ 'ui-saved-pages.js' | asset_url }}",
      "@ui/facets": "{{ 'ui-facets.js' | asset_url }}",
      "@ui/product": "{{ 'ui-product.js' | asset_url }}",
      "liquid-ajax-cart": "{{ 'liquid-ajax-cart-v2.2.0.js' | asset_url }}",
