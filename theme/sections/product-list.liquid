{% comment %}
  Product list: products from a collection (or picked by hand) as a grid or a slider of product cards.
  Without a collection: the store's catalog (collections.all). Styles: packages/ui/css/sections.css.
  Deal of the week (optional): one product shown first in an accent frame with a label on top and a
  countdown under it; after the end date it's an ordinary card again (on the next render; the open
  page hides the timer). Not repeated if it's in the list too.
  On the search page (setting): only while there are no results to show — before a search and when it
  finds nothing (templates/search.json).
  Tabs (blocks, slider layout): one tab per collection, one slider shown at a time (@ui/tabs).
{% endcomment %}
{%- liquid
  if section.settings.products.count > 0
    assign list = section.settings.products
  elsif section.settings.collection != blank
    assign list = section.settings.collection.products
  else
    assign list = collections.all.products
  endif
  assign link = section.settings.link | default: section.settings.collection.url
  assign slider = false
  if section.settings.layout == 'slider'
    assign slider = true
  endif
  assign card_sizes = '(min-width: 990px) calc((100vw - 10rem) / ' | append: section.settings.columns | append: '), (min-width: 750px) 33vw, 50vw'
  assign deal = section.settings.deal_product
  if deal != blank and section.settings.deal_end != blank
    assign deal_end = section.settings.deal_end | date: '%s' | plus: 0
    assign now = 'now' | date: '%s' | plus: 0
    if deal_end <= now
      assign deal = nil
    endif
  endif
-%}
{%- liquid
  assign hidden = false
  if section.settings.search_empty_only and template.name == 'search' and search.results_count > 0
    assign hidden = true
  endif
-%}
{%- unless hidden -%}
<div class="product-list color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width">
    {%- comment -%} Grid on phones: 4 cards (two rows of 2), the rest under "Show more" in steps of 4 {%- endcomment -%}
    {%- assign total = 0 -%}
    {%- capture deal_card -%}
      {%- if deal != blank -%}
        {%- assign total = 1 -%}
        <div class="deal-card">
          <p class="deal-card__label">{{ section.settings.deal_label | escape }}</p>
          <div class="deal-card__body">
            {%- render 'product-card', product: deal, quick_add: section.settings.quick_add, sizes: '(min-width: 750px) 25vw, 40vw' -%}
          </div>
          {%- if section.settings.deal_end != blank -%}
            <div class="deal-card__timer" data-countdown-section>
              {%- render 'countdown', end: section.settings.deal_end, label: false -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endcapture -%}
    {%- capture cards -%}
      {%- for product in list -%}
        {%- if product.id == deal.id -%}{%- continue -%}{%- endif -%}
        {%- if total >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign total = total | plus: 1 -%}
        <li{% if slider == false and total > 4 %} data-more{% endif %}>
          {%- render 'product-card',
            product: product,
            quick_add: section.settings.quick_add,
            sizes: card_sizes
          -%}
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    {%- assign tabs = section.blocks | where: 'type', 'tab' -%}
    {%- if slider and tabs.size > 0 -%}
      {%- comment -%}
        Tabs (blocks "Tab"): one slider per tab with its collection's products, one shown at a time
        (@ui/tabs); the section's own products aren't used. The deal of the week stays in the first column
        whichever tab is shown, the sliders one column narrower next to it.
      {%- endcomment -%}
      {%- liquid
        assign tab_columns = section.settings.columns
        if deal_card != blank
          assign tab_columns = tab_columns | minus: 1
        endif
      -%}
      <ui-tabs class="product-list__tabs" style="--list-columns: {{ section.settings.columns }};">
        {%- render 'section-head', heading: section.settings.heading, link_label: section.settings.link_label, link: link -%}
        <div class="product-list__tablist scrollbar-hidden" role="tablist" aria-label="{{ section.settings.heading | strip_html | escape }}">
          {%- for block in tabs -%}
            <button
              type="button"
              class="chip"
              role="tab"
              id="Tab-{{ section.id }}-{{ forloop.index }}"
              aria-controls="TabPanel-{{ section.id }}-{{ forloop.index }}"
              aria-selected="{{ forloop.first }}"
              {% unless forloop.first %}
                tabindex="-1"
              {% endunless %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.title | default: block.settings.collection.title | escape -}}
            </button>
          {%- endfor -%}
        </div>
        {%- if deal_card != blank -%}
          <div class="product-list__deal-layout">
          <div class="product-list__deal">{{ deal_card }}</div>
          <div class="product-list__panels">
        {%- endif -%}
        {%- for block in tabs -%}
          <div
            role="tabpanel"
            id="TabPanel-{{ section.id }}-{{ forloop.index }}"
            aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
            {% unless forloop.first %}
              hidden
            {% endunless %}
          >
            <ui-slider
              class="slider product-list__slider"
              style="--slider-columns: {{ tab_columns }}; --slider-columns-mobile: 2.2;"
            >
              {%- assign tab_title = block.settings.title | default: block.settings.collection.title -%}
              {%- render 'section-head', nav: true, heading: tab_title, heading_class: 'visually-hidden' -%}
              <ul class="scroll-track slider__track" data-slider-track role="list">
                {%- assign shown = 0 -%}
                {%- for product in block.settings.collection.products -%}
                  {%- if product.id == deal.id -%}{%- continue -%}{%- endif -%}
                  {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
                  {%- assign shown = shown | plus: 1 -%}
                  <li>
                    {%- render 'product-card', product: product, quick_add: section.settings.quick_add, sizes: card_sizes -%}
                  </li>
                {%- endfor -%}
              </ul>
            </ui-slider>
          </div>
        {%- endfor -%}
        {%- if deal_card != blank -%}
          </div>
          </div>
        {%- endif -%}
      </ui-tabs>
      <script type="module">import '@ui/tabs';</script>
    {%- elsif slider -%}
      {%- comment -%}
        With a deal: the deal card stays put on the left (one column wide; above the slider on phones)
        and the slider of the other products, one column less, scrolls next to it
      {%- endcomment -%}
      {%- liquid
        assign slider_columns = section.settings.columns
        if deal_card != blank
          assign slider_columns = slider_columns | minus: 1
        endif
      -%}
      <ui-slider
        class="slider product-list__slider{% if deal_card != blank %} product-list__slider--deal{% endif %}"
        style="--slider-columns: {{ slider_columns }}; --slider-columns-mobile: 2.2; --list-columns: {{ section.settings.columns }};"
      >
        {%- render 'section-head', heading: section.settings.heading, link_label: section.settings.link_label, link: link, nav: true -%}
        {%- if deal_card != blank -%}
          <div class="product-list__deal-layout">
            <div class="product-list__deal">{{ deal_card }}</div>
            <ul class="scroll-track slider__track" data-slider-track role="list">{{ cards }}</ul>
          </div>
        {%- else -%}
          <ul class="scroll-track slider__track" data-slider-track role="list">{{ cards }}</ul>
        {%- endif -%}
      </ui-slider>
    {%- else -%}
      {%- render 'section-head', heading: section.settings.heading, link_label: section.settings.link_label, link: link -%}
      <show-more class="product-list__more" data-step="4">
        <ul class="grid product-list__grid" role="list" style="--grid-columns: {{ section.settings.columns }}; --grid-columns-mobile: 2;">
          {%- if deal_card != blank -%}
            <li class="product-list__deal">{{ deal_card }}</li>
          {%- endif -%}
          {{ cards }}
        </ul>
        {%- if total > 4 -%}
          <button type="button" class="btn btn--outline product-list__more-button" data-show-more>
            {{- 'sections.product_list.show_more' | t -}}
          </button>
        {%- endif -%}
      </show-more>
      {%- if total > 4 -%}
        <script type="module">import '@ui/show-more';</script>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.product_list.name",
  "class": "product-list-section",
  "disabled_on": { "groups": ["*"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "product_list", "id": "products", "label": "t:labels.products_list", "info": "t:labels.products_list_info", "limit": 12 },
    { "type": "range", "id": "limit", "label": "t:labels.limit", "min": 2, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.product_list.layout",
      "options": [
        { "value": "slider", "label": "t:sections.product_list.layout_slider" },
        { "value": "grid", "label": "t:sections.product_list.layout_grid" }
      ],
      "default": "slider"
    },
    { "type": "range", "id": "columns", "label": "t:labels.columns", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "quick_add", "label": "t:sections.product_list.quick_add", "default": true },
    { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "View all" },
    { "type": "url", "id": "link", "label": "t:labels.link", "info": "t:sections.product_list.link_info" },
    { "type": "checkbox", "id": "search_empty_only", "label": "t:sections.product_list.search_empty_only", "info": "t:sections.product_list.search_empty_only_info", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.product_list.deal" },
    { "type": "product", "id": "deal_product", "label": "t:sections.product_list.deal_product", "info": "t:sections.product_list.deal_product_info" },
    { "type": "text", "id": "deal_label", "label": "t:sections.product_list.deal_label", "default": "Deal of the week" },
    { "type": "text", "id": "deal_end", "label": "t:sections.product_list.deal_end", "info": "t:sections.product_list.deal_end_info", "placeholder": "2026-12-24 23:59" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.product_list.tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        { "type": "text", "id": "title", "label": "t:sections.product_list.tab_title", "info": "t:sections.product_list.tab_title_info" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.product_list.name" }]
}
{% endschema %}
