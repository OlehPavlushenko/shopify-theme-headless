{% comment %}
  Account (templates/customers/account.json): "Hi, Olena" with the account tabs, the orders as
  cards (number, date, payment and delivery status, total, up to four product thumbnails) and, on
  the side, the default address and the wishlist. Styles: packages/ui/css/account.css.
{% endcomment %}
{%- paginate customer.orders by 10 -%}
  <div class="account color-{{ section.settings.color_scheme }} section-spacing">
    <div class="page-width account__inner">
      <header class="account__head">
        <div class="account__hello">
          <p class="eyebrow">{{ 'customers.account.title' | t }}</p>
          <h1 class="h2">
            {%- if customer.first_name != blank -%}
              {{ 'customers.account.hello' | t: name: customer.first_name }}
            {%- else -%}
              {{ 'customers.account.hello_anonymous' | t }}
            {%- endif -%}
          </h1>
          <p class="account__meta">{{ customer.email }}</p>
        </div>
        {%- render 'account-nav' -%}
      </header>

      <div class="account__layout">
        <section class="account__main" aria-labelledby="AccountOrders">
          <h2 id="AccountOrders" class="h4">{{ 'customers.account.orders' | t }}</h2>
          {%- if customer.orders.size > 0 -%}
            <ul class="account-orders" role="list">
              {%- for order in customer.orders -%}
                <li>
                  <a href="{{ order.customer_url }}" class="account-order">
                    <span class="account-order__top">
                      <span class="account-order__name">{{ order.name }}</span>
                      <span class="account-order__date">{{ order.created_at | time_tag: format: 'date' }}</span>
                    </span>
                    <span class="account-order__status">
                      {%- render 'account-status', order: order -%}
                    </span>
                    <span class="account-order__items" aria-hidden="true">
                      {%- for item in order.line_items limit: 4 -%}
                        {%- if item.image -%}
                          {{ item.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if order.line_items.size > 4 -%}
                        <span class="account-order__more">+{{ order.line_items.size | minus: 4 }}</span>
                      {%- endif -%}
                    </span>
                    <span class="account-order__total">
                      {{ order.total_price | money }}
                      {%- render 'icon', name: 'chevron-right' -%}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate, anchor: '' -%}
            {%- endif -%}
          {%- else -%}
            <div class="empty-state">
              {%- render 'icon', name: 'bag' -%}
              <p>{{ 'customers.account.no_orders' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'customers.account.start_shopping' | t }}</a>
            </div>
          {%- endif -%}
        </section>

        <aside class="account__side">
          <div class="account-panel">
            <div class="account-panel__body">
              <h2 class="h5">{{ 'customers.account.default_address' | t }}</h2>
              {%- if customer.default_address -%}
                <address class="account-address__text">{{ customer.default_address | format_address }}</address>
              {%- else -%}
                <p class="account__meta">{{ 'customers.addresses.empty' | t }}</p>
              {%- endif -%}
              <a href="{{ routes.account_addresses_url }}" class="btn btn--link">
                {{- 'customers.account.manage_addresses' | t: count: customer.addresses_count -}}
              </a>
            </div>
          </div>
          {%- if settings.wishlist_enabled and pages['wishlist'] -%}
            <a href="{{ pages['wishlist'].url }}" class="account-panel account-panel--link">
              <span class="account-panel__body">
                {%- render 'icon', name: 'heart' -%}
                <span>
                  <span class="h5">{{ 'wishlist.title' | t }}</span>
                  <span class="account__meta">{{ 'customers.account.wishlist_text' | t }}</span>
                </span>
              </span>
            </a>
          {%- endif -%}
        </aside>
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.account.account",
  "class": "main-account-section",
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }]
}
{% endschema %}
