{% doc %}
  The filters + product grid of a collection or of search results, rendered inside the section's
  paginate block (sections/main-collection): toolbar (filters button, count, sort, grid density),
  active filter chips, the filters panel (snippets/facets) and the grid with an optional promo tile,
  then "Load more" or page numbers. Search results that are pages or articles show as text cards.

  @param {object} section - The section (settings, blocks, id)
  @param {object[]} items - The paginated products (or search results)
  @param {object} paginate - The paginate object
  @param {object[]} filters - collection.filters or search.filters
  @param {object[]} sort_options - collection.sort_options or search.sort_options
  @param {string} sort_by - Current sort
  @param {number} count - Total number of products (results)
  @param {string} count_label - "86 products" / "12 results"
  @param {string} clear_url - The list without any filter (keeps sort / search terms)
  @param {string} [terms] - Search terms (search page): kept in the filter form
{% enddoc %}
{%- liquid
  assign layout = section.settings.filters_layout
  assign form_id = 'FacetsForm-' | append: section.id
  assign panel_id = 'FacetsPanel-' | append: section.id
  assign has_filters = false
  if section.settings.show_filters and filters.size > 0
    assign has_filters = true
  endif
  assign active_filters = 0
  for filter in filters
    assign active_filters = active_filters | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_filters = active_filters | plus: 1
      endif
    endif
  endfor
  assign columns = section.settings.columns_desktop
  # "Bigger cards" density: a column less. Tablets (and the sidebar below 1200px): at most 3
  assign few_columns = columns | minus: 1 | at_least: 2
  assign tablet_columns = columns | at_most: 3
  assign few_tablet_columns = tablet_columns | minus: 1 | at_least: 2
  assign tablet_size = 100 | divided_by: tablet_columns | append: 'vw'
  assign card_sizes = '(min-width: 990px) calc((100vw - 10rem) / ' | append: columns | append: '), (min-width: 750px) ' | append: tablet_size | append: ', 50vw'
  if has_filters and layout == 'sidebar'
    assign card_sizes = '(min-width: 1200px) calc((100vw - 36rem) / ' | append: columns | append: '), (min-width: 990px) calc((100vw - 36rem) / ' | append: tablet_columns | append: '), (min-width: 750px) ' | append: tablet_size | append: ', 50vw'
  endif
  assign promo = nil
  if terms == blank
    assign promo = section.blocks | where: 'type', 'promo' | first
  endif
-%}
<div class="page-width">
  <div class="facets__toolbar">
    {%- if has_filters -%}
      <button type="button" class="btn btn--outline btn--sm facets__toggle" popovertarget="{{ panel_id }}">
        {%- render 'icon', name: 'sliders' -%}
        {{- 'facets.filters' | t -}}
        <span class="facets__toggle-count" data-facets-active-count{% if active_filters == 0 %} hidden{% endif %}>{{ active_filters }}</span>
      </button>
    {%- endif -%}
    <p class="facets__count" data-facets-count role="status">{{ count_label }}</p>
    <div class="facets__tools">
      {%- if section.settings.show_sort -%}
        <label class="facets__sort">
          <span class="facets__sort-label">{{ 'facets.sort_by' | t }}</span>
          <select name="sort_by" class="facets__sort-select" form="{{ form_id }}" data-facets-sort>
            {%- for option in sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
          {%- render 'icon', name: 'chevron-down' -%}
        </label>
      {%- endif -%}
      {%- if section.settings.show_density -%}
        <div class="facets__density" role="group" aria-label="{{ 'facets.density' | t }}">
          <button type="button" class="facets__density-button facets__density-button--few" data-density="few" aria-label="{{ 'facets.density_few' | t }}" aria-pressed="false">
            <span class="facets__density-icon" aria-hidden="true">{% for i in (1..few_columns) %}<span{% if i > few_tablet_columns %} data-wide{% endif %}></span>{% endfor %}</span>
          </button>
          <button type="button" class="facets__density-button facets__density-button--many" data-density="many" aria-label="{{ 'facets.density_many' | t }}" aria-pressed="true">
            <span class="facets__density-icon" aria-hidden="true">{% for i in (1..columns) %}<span{% if i > tablet_columns %} data-wide{% endif %}></span>{% endfor %}</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="facets__active" data-facets-active>
    {%- if has_filters -%}
      {%- render 'facets-active', filters: filters, clear_url: clear_url -%}
    {%- endif -%}
  </div>

  <div class="facets__layout">
    {%- if has_filters -%}
      <div id="{{ panel_id }}" class="facets__panel drawer drawer--start" popover="manual" aria-labelledby="{{ panel_id }}-title">
        <div class="drawer__inner facets__panel-inner">
          <div class="drawer__header facets__panel-header">
            <p id="{{ panel_id }}-title" class="facets__panel-title">
              {%- render 'icon', name: 'sliders' -%}
              {{- 'facets.filters' | t -}}
            </p>
            {%- comment -%} "Clear all" beside the title (sidebar); re-rendered with the results {%- endcomment -%}
            <span class="facets__panel-clear" data-facets-clear>
              {%- if active_filters > 0 -%}
                <a href="{{ clear_url }}" class="btn btn--link" data-facets-link>{{ 'facets.clear_all' | t }}</a>
              {%- endif -%}
            </span>
            <button type="button" class="btn btn--icon facets__panel-close" popovertarget="{{ panel_id }}" popovertargetaction="hide" aria-label="{{ 'accessibility.close' | t }}">
              {%- render 'icon', name: 'close' -%}
            </button>
          </div>
          <div class="drawer__body facets__panel-body" data-facets-body>
            {%- comment -%} The toolbar select joins the form (form="…"); without it the current sort rides along hidden {%- endcomment -%}
            {%- liquid
              assign hidden_sort = nil
              unless section.settings.show_sort
                assign hidden_sort = sort_by
              endunless
            -%}
            {%- render 'facets', filters: filters, form_id: form_id, layout: layout, sort_by: hidden_sort, terms: terms -%}
          </div>
          <div class="drawer__footer facets__panel-footer">
            <a href="{{ clear_url }}" class="btn btn--outline" data-facets-link>{{ 'facets.clear_all' | t }}</a>
            <button type="button" class="btn" popovertarget="{{ panel_id }}" popovertargetaction="hide" data-facets-show>
              {{- 'facets.show_results' | t: count: count -}}
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}

    <div class="facets__results" data-facets-results>
      {%- if items.size > 0 -%}
        {%- comment -%} Heading order h1 (page header) → h2 → h3 (cards) {%- endcomment -%}
        <h2 class="visually-hidden">{{ 'facets.products_heading' | t }}</h2>
        {%- comment -%} <load-more> (@ui/load-more): "Load more" appends the next page, the same as on the blog {%- endcomment -%}
        <load-more data-section="{{ section.id }}">
        <ul
          id="ProductGrid-{{ section.id }}"
          class="grid facets__grid"
          role="list"
          style="--cols: {{ columns }}; --cols-few: {{ few_columns }}; --cols-tablet: {{ tablet_columns }}; --cols-few-tablet: {{ few_tablet_columns }}; --cols-mobile: {{ section.settings.columns_mobile }};"
          data-facets-grid
          data-load-more-grid
        >
          {%- for item in items -%}
            {%- if promo and paginate.current_page == 1 and forloop.index == promo.settings.position -%}
              <li class="facets__promo grid-promo" {{ promo.shopify_attributes }}>
                {%- render 'promo-card',
                  url: promo.settings.link,
                  image: promo.settings.image,
                  eyebrow: promo.settings.eyebrow,
                  heading: promo.settings.heading,
                  text: promo.settings.text,
                  link_label: promo.settings.link_label,
                  layout: 'overlay',
                  ratio: '4 / 5',
                  sizes: card_sizes
                -%}
              </li>
            {%- endif -%}
            {%- liquid
              assign eager = false
              if paginate.current_page == 1 and forloop.index <= columns
                assign eager = true
              endif
              assign object_type = item.object_type | default: 'product'
            -%}
            <li data-load-more-item>
              {%- if object_type == 'product' -%}
                {%- render 'product-card',
                  product: item,
                  eager: eager,
                  sizes: card_sizes,
                  quick_add: section.settings.quick_add,
                  show_vendor: section.settings.show_vendor
                -%}
              {%- else -%}
                <a href="{{ item.url }}" class="text-card">
                  <span class="text-card__type">
                    {%- if object_type == 'article' -%}{{ 'search.article' | t }}{%- else -%}{{ 'search.page' | t }}{%- endif -%}
                  </span>
                  <span class="text-card__title">{{ item.title | escape }}</span>
                  <span class="text-card__excerpt">{{ item.content | strip_html | truncatewords: 22 }}</span>
                  <span class="text-card__more">{{ 'blog.read_more' | t }}{%- render 'icon', name: 'arrow-right' -%}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
          {%- comment -%}
            "Load more" is the grid's last cell: it fills whatever is left of an incomplete last row
            (no lonely card with empty space beside it), or takes a row of its own
          {%- endcomment -%}
          {%- if section.settings.pagination == 'load_more' -%}
            {%- assign shown = paginate.current_offset | plus: items.size -%}
            {%- render 'load-more-cell', paginate: paginate, shown: shown -%}
          {%- endif -%}
        </ul>
        </load-more>

        {%- if paginate.pages > 1 and section.settings.pagination == 'pages' -%}
          {%- render 'pagination', paginate: paginate, anchor: '' -%}
        {%- endif -%}
      {%- else -%}
        <div class="empty-state">
          {%- render 'icon', name: 'search' -%}
          {%- if active_filters > 0 -%}
            <p class="h5">{{ 'facets.no_results' | t }}</p>
            <p>{{ 'facets.no_results_text' | t }}</p>
            <a href="{{ clear_url }}" class="btn" data-facets-link>{{ 'facets.clear_all' | t }}</a>
          {%- elsif terms != blank -%}
            <p class="h5">{{ 'search.no_results_html' | t: terms: terms }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'search.browse_all' | t }}</a>
          {%- else -%}
            <p class="h5">{{ 'collections.empty' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue_shopping' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
