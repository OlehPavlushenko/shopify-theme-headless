{% comment %}
  Collection list: collection tiles (image, title, number of products) in a slider that turns into
  a full row on wide screens. Without picked collections: the store's first collections.
  Styles: packages/ui/css/sections.css.
{% endcomment %}
{%- liquid
  if section.settings.collections.count > 0
    assign list = section.settings.collections
  else
    assign list = collections
  endif
-%}
<div class="collection-list color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width">
    <ui-slider class="slider" style="--slider-columns: {{ section.settings.columns }}; --slider-columns-mobile: 1.6;">
      {%- render 'section-head', heading: section.settings.heading, link_label: section.settings.link_label, link: routes.collections_url, nav: true -%}
      <ul class="slider__track" data-slider-track role="list">
        {%- for collection in list limit: 12 -%}
          {%- liquid
            assign cover = collection.image | default: collection.products.first.featured_image
          -%}
          <li>
            <a href="{{ collection.url }}" class="collection-card">
              <span class="frame collection-card__media" style="--frame-ratio: {{ section.settings.ratio }};">
                {%- if cover -%}
                  {{ cover | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 60vw', widths: '400, 600, 800', alt: '' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag }}
                {%- endif -%}
              </span>
              <span class="collection-card__title">
                {{- collection.title | escape -}}
                {%- render 'icon', name: 'arrow-right' -%}
              </span>
              <span class="collection-card__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </ui-slider>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "collection-list-section",
  "disabled_on": { "groups": ["*"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Shop by category" },
    { "type": "collection_list", "id": "collections", "label": "t:sections.collection_list.collections", "limit": 12 },
    { "type": "range", "id": "columns", "label": "t:sections.product_list.columns", "min": 3, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:sections.collection_list.ratio",
      "options": [
        { "value": "1", "label": "t:sections.collection_list.ratio_square" },
        { "value": "4 / 5", "label": "t:sections.collection_list.ratio_portrait" }
      ],
      "default": "4 / 5"
    },
    { "type": "text", "id": "link_label", "label": "t:sections.product_list.link_label", "default": "All collections" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:sections.collection_list.name" }]
}
{% endschema %}
