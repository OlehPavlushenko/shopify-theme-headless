            { "value": "description", "label": "t:sections.main_product.source_description" },
            { "value": "metafield", "label": "t:sections.main_product.source_metafield" },
            { "value": "page", "label": "t:sections.main_product.source_page" },
            { "value": "custom", "label": "t:sections.main_product.source_custom" }
          ],
          "default": "description"
        },
        { "type": "text", "id": "metafield", "label": "t:sections.main_product.metafield_key", "info": "t:sections.main_product.metafield_key_info", "placeholder": "custom.ingredients" },
        { "type": "page", "id": "page", "label": "t:sections.main_product.source_page" },
        { "type": "richtext", "id": "content", "label": "t:labels.text" },
        { "type": "checkbox", "id": "open", "label": "t:sections.faq.open_first", "default": false }
