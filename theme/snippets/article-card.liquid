{% doc %}
  Article card: cover image, date and reading time, title, an optional excerpt and topic tags. The
  title's link covers the whole card (::after), so the tags can be links of their own above it
  (no link inside a link). Used by the Blog posts section and the blog page.
  Styles: packages/ui/css/sections.css.

  @param {object} article - Article
  @param {boolean} [show_date] - Show the publish date and reading time (default true)
  @param {boolean} [show_excerpt] - Show the excerpt (default true)
  @param {boolean} [show_tags] - Show up to three tags; each adds its topic to the blog filter (a
    chosen one is marked and removes itself) — snippets/blog-topic-url (default false)
  @param {string} [layout] - 'featured': image beside the text, bigger title (the blog's newest article)
  @param {string} [heading_tag] - Title element (default h3; h2 on the blog page)
  @param {string} [sizes] - Image sizes attribute
{% enddoc %}
{%- liquid
  assign image_alt = article.image.alt | default: ''
  assign tag = heading_tag | default: 'h3'
  # Reading time at ~200 words a minute
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
  # The blog's URL from the article's (keeps a locale prefix): article.handle is "news/<article>",
  # so the URL without it is "/blogs/", plus the blog's handle → /blogs/news
  assign blog_handle = article.handle | split: '/' | first
  assign blog_root = article.url | remove_last: article.handle | append: blog_handle
-%}
<article class="article-card{% if layout == 'featured' %} article-card--featured{% endif %}">
  <div class="frame article-card__media" style="--frame-ratio: 3 / 2;">
    {%- if article.image -%}
      {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: sizes, widths: '450, 600, 900, 1200', alt: image_alt }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="article-card__body">
    {%- unless show_date == false -%}
      <span class="article-card__date">
        {{- article.published_at | time_tag: format: 'date' }} · {{ 'blog.reading_time' | t: count: minutes -}}
      </span>
    {%- endunless -%}
    <{{ tag }} class="{% if layout == 'featured' %}h3{% else %}h5{% endif %} article-card__title">
      <a href="{{ article.url }}" class="article-card__link">{{ article.title | escape }}</a>
    </{{ tag }}>
    {%- unless show_excerpt == false -%}
      <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
    {%- endunless -%}
    {%- if show_tags and article.tags.size > 0 -%}
      <ul class="article-card__tags" role="list">

        {%- for article_tag in article.tags limit: 3 -%}
          {%- capture topic_url -%}{% render 'blog-topic-url', blog_url: blog_root, tag: article_tag %}{%- endcapture -%}
          <li>
            <a
              href="{{ topic_url | strip }}"
              class="tag"
              data-section-link
              {% if current_tags contains article_tag %}
                aria-current="true"
              {% endif %}
            >
              {{- article_tag | escape -}}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <span class="article-card__more" aria-hidden="true">
      {{- 'blog.read_more' | t -}}
      {%- render 'icon', name: 'arrow-right' -%}
    </span>
  </div>
</article>
