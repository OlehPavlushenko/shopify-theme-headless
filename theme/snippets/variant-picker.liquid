{% doc %}
  Variant picker: one group of chips per option (color options as swatches), linked to each other —
  <variant-picker> (@ui/variant-picker) marks the values that don't exist with the other picks
  ([data-missing]) or are sold out ([data-sold-out]), and on a pick of a missing combination
  switches the other options to the closest variant. Used by quick view and the product page.
  Styles: .variant-picker in packages/ui/css/components.css.

  @param {object} product - Product
  @param {string} id - Unique prefix for the radio groups (e.g. section.id)
  @param {number} [low_stock] - "Only N left" at or under this stock (default 5)
{% enddoc %}
{%- assign low = low_stock | default: 5 -%}
<variant-picker class="variant-picker">
  {%- for option in product.options_with_values -%}
    {%- liquid
      capture is_color
        render 'option-is-color', option: option
      endcapture
      assign swatches = false
      if is_color contains 'true'
        assign swatches = true
      endif
    -%}
    <fieldset class="variant-picker__option">
      <legend class="variant-picker__legend">
        {{- option.name | escape }}: <span class="variant-picker__selected" data-selected-value>{{ option.selected_value | escape }}</span>
      </legend>
      <div class="variant-picker__values">
        {%- for value in option.values -%}
          <label class="{% if swatches %}variant-picker__swatch{% else %}chip variant-picker__chip{% endif %}">
            <input
              type="radio"
              class="visually-hidden"
              name="{{ id }}-option-{{ option.position }}"
              value="{{ value | escape }}"
              {% if value.selected %}
                checked
              {% endif %}
            >
            {%- if swatches -%}
              {%- render 'swatch', value: value -%}
            {%- else -%}
              {{- value | escape -}}
            {%- endif -%}
          </label>
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}
  {%- comment -%} Only what @ui/variant-picker reads (the full variant objects are several KB each) {%- endcomment -%}
  <script type="application/json" data-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
          "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }} }{% else %}null{% endif %},
          {%- comment -%} "Only N left": the count only when tracked and at or under the threshold {%- endcomment -%}
          "stock": {% if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= low %}{{ variant.inventory_quantity }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</variant-picker>
