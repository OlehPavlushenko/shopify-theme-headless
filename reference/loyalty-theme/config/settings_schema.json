  {
    "name": "t:sections.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "After adding to cart",
        "options": [
          {
            "value": "drawer",
            "label": "Open cart drawer"
          },
          {
            "value": "notification",
            "label": "Show notification"
          },
          {
            "value": "page",
            "label": "Go to cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "header",
        "content": "Free shipping bar"
      },
      {
        "type": "checkbox",
        "id": "show_shipping_total",
