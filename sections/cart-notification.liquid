<div
    class="modal js-cart-notification"
    tabindex="-1"
    role="dialog"
>
    <svg
        aria-hidden="true"
        focusable="false"
        role="presentation"
        class="spinner"
        viewBox="0 0 66 66"
        xmlns="http://www.w3.org/2000/svg"
    >
        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
    </svg>
    <div class="modal__dialog">
        <div class="modal__content">
            <div class="modal__body">
                <div class="modal__indent">
                    <div class="modal__box">
                        <div class="modal__media-wrapper">
                            <div class="modal__media media">
                                <img
                                    class="modal__image media__image js-cart-notification-image"
                                    src=""
                                    alt="Cart"
                                    width="100"
                                    height="100"
                                    loading="lazy"
                                >
                            </div>
                        </div>
                        <div class="modal__text">
                            <h5 class="modal__title js-cart-notification-title">Title</h5>
                            <span class="modal__variant-title js-cart-notification-variant-title">Variant</span>
                            <p class="modal__msg modal__msg--successfully">
                                {% render 'icons-svg', icons: 'check' -%}
                                <span class="js-cart-msg">Added to cart successfully!</span>
                            </p>
                        </div>
                    </div>
                    
                    <div class="modal__button">
                        <a href="{{ routes.all_products_collection_url }}" class="button button--link js-modal-close">
                            {{- 'products.product.continue_shopping' | t -}}
                        </a>
                        <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="button">{{ 'sections.cart.checkout' | t }}</button></form>
                    </div>
                </div>
                <div class="modal__close">
                    <button
                        type="button"
                        class="modal__close-btn js-modal-close"
                        data-dismiss="modal"
                        aria-hidden="true"
                    >
                        {% render 'icons-svg', icons: 'close' %}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
