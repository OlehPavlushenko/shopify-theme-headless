<div class="card-product__wrapper js-card-product-wrapper">
    <div class="card-product__media-wrapper">
        <a class="card-product__link" href="#"><span class="hidden">Product title</span></a>
        <picture
            class="card-product__media media__size--{{ img_size }} media js-card-product-media"
            data-size="{{ img_size }}"
        >
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </picture>
    </div>
    <div class="card-product__content card-product__content--{{ fill }}">
        <div class="card-product__row">
            <span class="card-product__vendor">Vendor</span>
            <div class="card-product__stock">
                <span
                    class="card-product__icon card-product__stock--lowstock"
                ></span>
                <span class="stock-level">{{ 'products.product.stock_level' | t }}</span>
            </div>
        </div>
        <h5 class="card-product__title">
            <a href="#"> Product title </a>
        </h5>
        <div class="card-product__desc" itemprop="name">These are things that are built to be bought once.</div>
        <div
            class="        price card-product__price js-card-product-price price--on-sale"
        >
            <div class="price__box">
                <span> <s class="price__item price__item--regular"> $65.00 </s> </span
                ><span class="price__item price__item--sale"> $56.00 </span>
                <span class="badge sale js-percentage-badge">-14% </span>
            </div>
        </div>

        <div class="card-product__btns">
            <a
                class="button button--secondary card-product__button-cart"
                href="#"
            >
                {{- 'products.product.details' | t -}}
            </a>
        </div>
    </div>
</div>
