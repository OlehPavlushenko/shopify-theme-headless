{% comment %}
  Predictive search results, fetched by @ui/predictive-search through the Section Rendering API:
  {{ routes.predictive_search_url }}?q=<terms>&section_id=predictive-search&resources[...]
  Not added through the theme editor (no presets). The client reads [data-predictive-results].
{% endcomment %}
{%- liquid
  assign resources = predictive_search.resources
  assign total = resources.products.size | plus: resources.collections.size | plus: resources.pages.size | plus: resources.articles.size | plus: resources.queries.size
  assign terms = predictive_search.terms | escape
-%}
<div data-predictive-results data-count="{{ total }}">
  {%- if predictive_search.performed -%}
    {%- if total == 0 -%}
      <p class="search-results__empty">{{ 'search.no_results_html' | t: terms: terms }}</p>
    {%- else -%}
      <div class="search-results__layout">
        <div class="search-results__aside">
          {%- if resources.queries.size > 0 -%}
            <section class="search-results__group" aria-labelledby="PredictiveQueries">
              <h2 id="PredictiveQueries" class="search-results__heading">{{ 'search.suggestions' | t }}</h2>
              <ul class="search-results__links" role="list">
                {%- for query in resources.queries -%}
                  <li>
                    <a href="{{ query.url }}" class="search-results__link search-results__query">{{ query.styled_text }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if resources.collections.size > 0 -%}
            <section class="search-results__group" aria-labelledby="PredictiveCollections">
              <h2 id="PredictiveCollections" class="search-results__heading">{{ 'search.collections' | t }}</h2>
              <ul class="search-results__links" role="list">
                {%- for collection in resources.collections -%}
                  <li><a href="{{ collection.url }}" class="search-results__link">{{ collection.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if resources.pages.size > 0 or resources.articles.size > 0 -%}
            <section class="search-results__group" aria-labelledby="PredictivePages">
              <h2 id="PredictivePages" class="search-results__heading">{{ 'search.pages' | t }}</h2>
              <ul class="search-results__links" role="list">
                {%- for page in resources.pages -%}
                  <li><a href="{{ page.url }}" class="search-results__link">{{ page.title | escape }}</a></li>
                {%- endfor -%}
                {%- for article in resources.articles -%}
                  <li><a href="{{ article.url }}" class="search-results__link">{{ article.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}
        </div>
        {%- if resources.products.size > 0 -%}
          <section class="search-results__group search-results__group--products" aria-labelledby="PredictiveProducts">
            <h2 id="PredictiveProducts" class="search-results__heading">{{ 'search.products' | t }}</h2>
            <ul class="search-results__products" role="list">
              {%- for product in resources.products limit: 6 -%}
                <li>
                  {%- render 'product-card',
                    product: product,
                    show_secondary_image: false,
                    sizes: '(min-width: 990px) 180px, 45vw',
                    heading_tag: 'p'
                  -%}
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

      </div>
    {%- endif -%}

    <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last" class="btn btn--outline search-results__all">
      {{- 'search.view_all_html' | t: terms: terms -}}
      {%- render 'icon', name: 'arrow-right' -%}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.search",
  "class": "predictive-search-section"
}
{% endschema %}
