{% comment %}
  Password page (layout/password): the "coming soon" screen of a store behind a password — logo,
  eyebrow, heading and text (the password message from Online Store > Preferences when the text is
  empty), a countdown to the launch (<ui-countdown>), a "notify me" sign-up (snippets/newsletter-form)
  and social links; an image beside it (or behind it). The password form opens in a popup
  (@ui/dialog), and opens by itself after a wrong password.
  Styles: packages/ui/css/sections.css (.password).
{% endcomment %}
{%- liquid
  assign text = section.settings.text
  if text == blank and shop.password_message != blank
    assign text = shop.password_message | escape | prepend: '<p>' | append: '</p>'
  endif
  assign launch = section.settings.launch | strip
  assign launch_time = launch | date: '%s' | plus: 0
  assign now_time = 'now' | date: '%s' | plus: 0
-%}
<div class="password password--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}">
  <div class="password__content">
    <header class="password__top">
      <span class="password__logo">
        {%- if settings.logo -%}
          {%- liquid
            assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round
            assign logo_sizes = settings.logo_width | append: 'px'
          -%}
          {{ settings.logo | image_url: width: 480 | image_tag: width: settings.logo_width, height: logo_height, sizes: logo_sizes, alt: shop.name, loading: 'eager' }}
        {%- else -%}
          <span class="h4">{{ shop.name | escape }}</span>
        {%- endif -%}
      </span>
      <button type="button" class="btn btn--outline btn--sm" data-dialog-open="PasswordDialog">
        {%- render 'icon', name: 'account' -%}
        {{- 'password.enter_with' | t -}}
      </button>
    </header>

    <div class="password__main">
      {%- if section.settings.eyebrow != blank -%}
        <p class="password__eyebrow">
          <span class="password__pulse" aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}
      <h1 class="password__heading">{{ section.settings.heading }}</h1>
      {%- if text != blank -%}
        <div class="rte password__text">{{ text }}</div>
      {%- endif -%}

      {%- if launch_time > now_time -%}
        <div class="password__countdown" data-countdown-section>
          {%- render 'countdown', end: launch, label: false -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="password__signup">
          {%- if section.settings.newsletter_heading != blank -%}
            <p class="password__signup-heading">{{ section.settings.newsletter_heading | escape }}</p>
          {%- endif -%}
          {%- render 'newsletter-form',
            id: 'password',
            button_label: section.settings.newsletter_button,
            success_text: section.settings.newsletter_success,
            note: section.settings.newsletter_note
          -%}
        </div>
      {%- endif -%}
    </div>

    <footer class="password__bottom">
      {%- if section.settings.show_social -%}
        {%- render 'social-links' -%}
      {%- endif -%}
      <p class="password__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · {{ powered_by_link }}
      </p>
    </footer>
  </div>

  {%- if section.settings.image != blank -%}
    <div class="password__media">
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', preload: true, sizes: '(min-width: 990px) 50vw, 100vw', widths: '750, 1100, 1500, 2000', alt: '' }}
    </div>
  {%- endif -%}
</div>

<dialog id="PasswordDialog" class="popup password-dialog" aria-labelledby="PasswordDialog-title">
  <div class="password-dialog__inner">
    <button type="button" class="btn btn--icon password-dialog__close" data-dialog-close aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'icon', name: 'close' -%}
    </button>
    <h2 id="PasswordDialog-title" class="h4">{{ 'password.dialog_title' | t }}</h2>
    {%- form 'storefront_password', class: 'password-dialog__form' -%}
      <label class="password-dialog__field">
        <span class="visually-hidden">{{ 'password.password' | t }}</span>
        <input
          class="input"
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="{{ 'password.password' | t | escape }}"
          required
          {% if form.errors %}
            aria-invalid="true" aria-describedby="PasswordDialog-error"
          {% endif %}
        >
      </label>
      {%- if form.errors -%}
        {%- assign password_error = true -%}
        <p id="PasswordDialog-error" class="password-dialog__error" role="alert">{{ 'password.wrong' | t }}</p>
      {%- endif -%}
      <button type="submit" class="btn btn--full">{{ 'password.enter' | t }}</button>
    {%- endform -%}
    <p class="password-dialog__owner">{{ 'password.owner_html' | t: link: '/admin' }}</p>
  </div>
</dialog>
{%- comment -%} A wrong password reloads the page with the error: the popup opens by itself {%- endcomment -%}
<script type="module">
  import { openDialog } from '@ui/dialog';
  {%- if password_error %}
    openDialog(document.getElementById('PasswordDialog'));
  {%- endif %}
</script>

{% schema %}
{
  "name": "t:general.password",
  "class": "page-section page-section--password",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.password.layout",
      "options": [
        { "value": "split", "label": "t:sections.password.layout_split" },
        { "value": "cover", "label": "t:sections.password.layout_cover" }
      ],
      "default": "split"
    },
    { "type": "image_picker", "id": "image", "label": "t:sections.hero.image" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.promo_popup.eyebrow", "default": "Coming soon" },
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Something natural is on its way" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "info": "t:sections.password.text_info" },
    { "type": "text", "id": "launch", "label": "t:sections.password.launch", "info": "t:sections.password.launch_info", "placeholder": "2026-12-01 10:00" },
    { "type": "header", "content": "t:sections.password.signup_header" },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:sections.password.show_newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "t:labels.heading", "default": "Be the first to know" },
    { "type": "text", "id": "newsletter_button", "label": "t:labels.button_label", "default": "Notify me" },
    { "type": "text", "id": "newsletter_note", "label": "t:sections.password.newsletter_note", "default": "One email on launch day — and 10% off your first order." },
    { "type": "richtext", "id": "newsletter_success", "label": "t:sections.password.newsletter_success", "default": "<p>You are on the list — see you on launch day!</p>" },
    { "type": "checkbox", "id": "show_social", "label": "t:sections.footer.show_social", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
