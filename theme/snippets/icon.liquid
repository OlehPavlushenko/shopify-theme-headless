{% doc %}
    Inline SVG icon, 24×24 grid, stroke uses currentColor. Size via the --icon-size custom property.

    @param {string} name - close | plus | minus | cart | bag | check | arrow-right | arrow-left | chevron-down | chevron-right | chevron-left | search | account | menu | trash | sliders | heart | compare | globe | truck | tag | phone | mail | map-pin | clock | instagram | facebook | tiktok | youtube | telegram | pinterest | leaf | return | shield | gift | chat
    @param {string} [class] - Extra classes
{% enddoc %}
<svg
    class="svg-icon svg-icon--{{ name }} {{ class }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
>
    {%- case name -%}
        {%- when 'close' -%}
            <path d="M6 6l12 12M18 6L6 18"/>
        {%- when 'plus' -%}
            <path d="M12 5v14M5 12h14"/>
        {%- when 'minus' -%}
            <path d="M5 12h14"/>
        {%- when 'cart' -%}
            <path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H6.2"/><circle cx="9" cy="20" r="1"/><circle cx="17" cy="20" r="1"/>
        {%- when 'bag' -%}
            <path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
        {%- when 'check' -%}
            <path d="M5 12.5l4.5 4.5L19 7.5"/>
        {%- when 'arrow-right' -%}
            <path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'arrow-left' -%}
            <path d="M19 12H5M11 6l-6 6 6 6"/>
        {%- when 'chevron-down' -%}
            <path d="M6 9l6 6 6-6"/>
        {%- when 'chevron-right' -%}
            <path d="M9 6l6 6-6 6"/>
        {%- when 'chevron-left' -%}
            <path d="M15 6l-6 6 6 6"/>
        {%- when 'search' -%}
            <circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>
        {%- when 'account' -%}
            <circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0"/>
        {%- when 'menu' -%}
            <path d="M4 7h16M4 12h16M4 17h16"/>
        {%- when 'trash' -%}
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>
        {%- when 'sliders' -%}
            <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>
        {%- when 'heart' -%}
            <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
        {%- when 'compare' -%}
            <path d="M7 4v16M17 4v16M3 8l4-4 4 4M13 16l4 4 4-4"/>
        {%- when 'globe' -%}
            <circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.6 2.5 14.4 0 17M12 3.5c-2.5 2.6-2.5 14.4 0 17"/>
        {%- when 'truck' -%}
            <path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>
        {%- when 'phone' -%}
            <path d="M5 4h3l1.5 4-2 1.3a11 11 0 0 0 7.2 7.2L16 14.5l4 1.5v3a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4z"/>
        {%- when 'mail' -%}
            <rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4 7l8 6 8-6"/>
        {%- when 'map-pin' -%}
            <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>
        {%- when 'clock' -%}
            <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
        {%- when 'instagram' -%}
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>
        {%- when 'facebook' -%}
            <path d="M14.5 8.5H17V5h-2.5a4 4 0 0 0-4 4v2.5H8V15h2.5v6H14v-6h2.6l.5-3.5H14V9a.5.5 0 0 1 .5-.5z"/>
        {%- when 'tiktok' -%}
            <path d="M14 3.5v11.2a3.3 3.3 0 1 1-3.3-3.3M14 3.5c.4 2.6 2.2 4.4 5 4.6"/>
        {%- when 'youtube' -%}
            <rect x="2.5" y="5.5" width="19" height="13" rx="3.5"/><path d="M10 9.2v5.6l4.8-2.8z"/>
        {%- when 'telegram' -%}
            <path d="M20.5 4.5L3.5 11l5.5 2 2 6 3-4 4.5 3.5z"/><path d="M9 13l9-6.5"/>
        {%- when 'pinterest' -%}
            <circle cx="12" cy="12" r="8.5"/><path d="M10.3 20.2l1.9-7.7M10.5 14.8c2.9 1.2 6-.4 6-3.8a4.5 4.5 0 0 0-9-.3c0 1 .3 1.9.9 2.5"/>
        {%- when 'leaf' -%}
            <path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-4 6-7 10-9"/>
        {%- when 'return' -%}
            <path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5L4 9l4 4"/>
        {%- when 'shield' -%}
            <path d="M12 3.5l7 2.5v5.5c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>
        {%- when 'gift' -%}
            <rect x="3.5" y="8.5" width="17" height="4" rx="1"/><path d="M5 12.5v7h14v-7M12 8.5v11M12 8.5C10 4 6.5 5 7.5 7.5c.4 1 2.5 1 4.5 1zM12 8.5c2-4.5 5.5-3.5 4.5-1-.4 1-2.5 1-4.5 1z"/>
        {%- when 'chat' -%}
            <path d="M4 6.5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-4 3.5v-3.5H6a2 2 0 0 1-2-2z"/>
        {%- when 'tag' -%}
            <path d="M3.5 12.3V4.5a1 1 0 0 1 1-1h7.8l8.2 8.2a1 1 0 0 1 0 1.4l-6.6 6.6a1 1 0 0 1-1.4 0z"/><circle cx="8" cy="8" r="1.3"/>
    {%- endcase -%}
</svg>
