{% doc %}
  Content of the utility panel: account, wishlist and compare links (with counters), an optional
  utility menu, the currency / language switchers. Shared by the desktop utility panel
  (snippets/utility-panel) and the bottom of the mobile menu (snippets/mobile-menu).
  Renders nothing when there is nothing to show. Styles: .utility-panel__* in header.css.

  @param {string} id - Prefix for the switcher form ids (unique per place)
  @param {object} [menu] - link_list with extra links (shipping, contacts, help…)
  @param {boolean} show_account - Show the account link
  @param {boolean} show_wishlist - Show the wishlist link
  @param {boolean} show_compare - Show the compare link
  @param {boolean} show_currency - Show the currency switcher
  @param {boolean} show_language - Show the language switcher
{% enddoc %}
{%- capture links -%}
  {%- if show_account and shop.customer_accounts_enabled -%}
    <li>
      <a href="{{ routes.account_url }}" class="utility-panel__link">
        {%- render 'icon', name: 'account' -%}
        {%- if customer -%}
          {{ 'customers.account.title' | t }}
        {%- else -%}
          {{ 'customers.login.title' | t }}
        {%- endif -%}
      </a>
    </li>
  {%- endif -%}
  {%- if show_wishlist and settings.wishlist_enabled -%}
    <li>
      <a href="{{ pages['wishlist'].url | default: routes.root_url }}" class="utility-panel__link">
        {%- render 'icon', name: 'heart' -%}
        {{ 'wishlist.title' | t }}
        <span class="count-badge saved-count" data-saved-count="wishlist" data-empty></span>
      </a>
    </li>
  {%- endif -%}
  {%- if show_compare and settings.compare_enabled -%}
    <li>
      <a href="{{ pages['compare'].url | default: routes.root_url }}" class="utility-panel__link">
        {%- render 'icon', name: 'compare' -%}
        {{ 'compare.title' | t }}
        <span class="count-badge saved-count" data-saved-count="compare" data-empty></span>
      </a>
    </li>
  {%- endif -%}
  {%- for link in menu.links -%}
    <li>
      <a href="{{ link.url }}" class="utility-panel__link">
        {%- render 'icon', name: 'arrow-right' -%}
        {{ link.title | escape }}
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture switchers -%}
  {%- if show_currency -%}
    {%- render 'localization-form', type: 'currency', id: id -%}
  {%- endif -%}
  {%- if show_language -%}
    {%- render 'localization-form', type: 'language', id: id -%}
  {%- endif -%}
{%- endcapture -%}

{%- if links != blank -%}
  <ul class="utility-panel__links" role="list">{{ links }}</ul>
{%- endif -%}
{{ switchers }}
