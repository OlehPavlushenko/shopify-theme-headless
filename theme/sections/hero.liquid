{% comment %}
  Hero: one or more slides (blocks). One slide is a static banner; two or more make a slider
  (<ui-slider>: swipe, arrows, dots, optional autoplay).
  Each slide: image or background video (each with an optional phone version), eyebrow, heading,
  text, two buttons, text position, its own color scheme and a caption style:
  - card: the text in a panel in the scheme colors over the untouched image (default)
  - split: image on one side, text on the scheme background on the other
  - overlay: text right on the image
  On phones every slide with text is laid out the same: media on top, text under it.
  Image tint: own color and strength, independent of the scheme — an even tint for card / split,
  a gradient from the text side for overlay. Background video: optional start / end second (that
  part loops).
  First slide of the first section: image loads eagerly with high priority (LCP); the rest lazily.
  Headings are h2 styled as h1 — on the home page the logo is the page's h1 (ARCHITECTURE.md, SEO).
  Styles: packages/ui/css/sections.css. Behavior: @ui/slider, @ui/background-video.
{% endcomment %}
{%- liquid
  assign several = false
  if section.blocks.size > 1
    assign several = true
  endif
  assign has_video = false
  for block in section.blocks
    if block.settings.video != blank
      assign has_video = true
    endif
  endfor
-%}
<ui-slider
  class="hero hero--{{ section.settings.height }}"
  {% if several and section.settings.autoplay > 0 %}
    data-autoplay="{{ section.settings.autoplay }}"
  {% endif %}
  {% if several and section.settings.loop %}
    data-loop
  {% endif %}
  aria-roledescription="carousel"
  aria-label="{{ 'sections.hero.label' | t }}"
>
  <ul class="hero__track" data-slider-track role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign image = block.settings.image
        assign image_mobile = block.settings.image_mobile | default: image
        # Filters inside image_tag arguments would apply to the whole tag: resolve the alt first
        assign image_alt = image.alt | default: ''
        assign eager = false
        # No eyebrow, heading, text or buttons: no caption at all, the media fills the slide
        assign caption = block.settings.caption
        if block.settings.eyebrow == blank and block.settings.heading == blank and block.settings.text == blank and block.settings.button_label == blank and block.settings.button_label_2 == blank
          assign caption = 'none'
        endif
        if section.index == 1 and forloop.first
          assign eager = true
        endif
      -%}
      <li
        class="hero__slide hero__slide--{{ block.settings.position }} hero__slide--{{ caption }}{% if image or block.settings.video %} hero__slide--media{% endif %} color-{{ block.settings.color_scheme }}"
        style="--hero-overlay: {{ block.settings.overlay }}%; --hero-tint: {{ block.settings.tint_color | default: '#000000' }};"
        {% if several %}
          aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {%- if image -%}
            <picture>
              <source
                media="(min-width: 750px)"
                srcset="{{ image | image_url: width: 1500 }} 1500w, {{ image | image_url: width: 2200 }} 2200w, {{ image | image_url: width: 3000 }} 3000w"
                sizes="100vw"
              >
              {%- if eager and block.settings.video == blank -%}
                {{ image_mobile | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '600, 900, 1200', alt: image_alt }}
              {%- else -%}
                {{ image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600, 900, 1200', alt: image_alt }}
              {%- endif -%}
            </picture>
          {%- elsif block.settings.video == blank -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}

          {%- if block.settings.video != blank -%}
            <background-video
              class="hero__video"
              {% if block.settings.video_start > 0 %}data-start="{{ block.settings.video_start }}"{% endif %}
              {% if block.settings.video_end > block.settings.video_start %}data-end="{{ block.settings.video_end }}"{% endif %}
            >
              {%- comment -%} Desktop: up to 1080p. Phones: the phone video or the same video, up to 720p {%- endcomment -%}
              {%- render 'background-video-file', video: block.settings.video, max_height: 1080, class: 'hero__video-file' -%}
              {%- assign phone_video = block.settings.video_mobile | default: block.settings.video -%}
              {%- render 'background-video-file', video: phone_video, max_height: 720, poster_width: 800, class: 'hero__video-file hero__video-file--mobile' -%}
            </background-video>
          {%- endif -%}
        </div>

        {%- if caption != 'none' -%}
          <div class="hero__inner page-width">
            <div class="hero__content">
              {%- if block.settings.eyebrow != blank -%}
                <p class="eyebrow hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="h1 hero__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="text-lead hero__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                <div class="hero__buttons">
                  {%- if block.settings.button_label != blank -%}
                    <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--lg">
                      {{- block.settings.button_label | escape -}}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a href="{{ block.settings.button_link_2 | default: routes.collections_url }}" class="btn btn--outline btn--lg">
                      {{- block.settings.button_label_2 | escape -}}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  {%- if several -%}
    {%- comment -%} Controls take the first slide's colors; the scheme background is switched off inline {%- endcomment -%}
    <div class="hero__controls page-width color-{{ section.blocks.first.settings.color_scheme }}" style="background: none;">
      <div class="slider__dots hero__dots" data-slider-dots data-label="{{ 'sections.hero.slide' | t }}"></div>
      {%- assign hero_label = 'sections.hero.label' | t -%}
      {%- render 'slider-nav', label: hero_label -%}
    </div>
  {%- endif -%}
</ui-slider>
{%- if has_video -%}
  <script type="module">import '@ui/background-video';</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.hero.name",
  "class": "hero-section",
  "disabled_on": { "groups": ["*"] },
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.height",
      "options": [
        { "value": "medium", "label": "t:sections.hero.height_medium" },
        { "value": "large", "label": "t:sections.hero.height_large" },
        { "value": "full", "label": "t:sections.hero.height_full" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "t:sections.hero.autoplay",
      "info": "t:sections.hero.autoplay_info",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 0
    },
    { "type": "checkbox", "id": "loop", "label": "t:sections.hero.loop", "info": "t:sections.hero.loop_info", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.hero.slide_name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.hero.image" },
        { "type": "image_picker", "id": "image_mobile", "label": "t:sections.hero.image_mobile", "info": "t:sections.hero.image_mobile_info" },
        { "type": "video", "id": "video", "label": "t:sections.hero.video", "info": "t:sections.hero.video_info" },
        { "type": "video", "id": "video_mobile", "label": "t:sections.hero.video_mobile", "info": "t:sections.hero.video_mobile_info" },
        { "type": "range", "id": "video_start", "label": "t:sections.hero.video_start", "min": 0, "max": 60, "step": 1, "unit": "s", "default": 0 },
        { "type": "range", "id": "video_end", "label": "t:sections.hero.video_end", "info": "t:sections.hero.video_end_info", "min": 0, "max": 60, "step": 1, "unit": "s", "default": 0 },
        {
          "type": "select",
          "id": "position",
          "label": "t:sections.hero.position",
          "options": [
            { "value": "left", "label": "t:sections.hero.position_left" },
            { "value": "center", "label": "t:sections.hero.position_center" },
            { "value": "bottom", "label": "t:sections.hero.position_bottom" }
          ],
          "default": "left"
        },
        { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "info": "t:sections.hero.color_scheme_info", "default": "scheme-3" },
        {
          "type": "select",
          "id": "caption",
          "label": "t:sections.hero.caption",
          "info": "t:sections.hero.caption_info",
          "options": [
            { "value": "card", "label": "t:sections.hero.caption_card" },
            { "value": "split", "label": "t:sections.hero.caption_split" },
            { "value": "overlay", "label": "t:sections.hero.caption_overlay" }
          ],
          "default": "card"
        },
        { "type": "color", "id": "tint_color", "label": "t:sections.hero.tint_color", "default": "#000000" },
        { "type": "range", "id": "overlay", "label": "t:sections.hero.overlay", "info": "t:sections.hero.overlay_info", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
        { "type": "header", "content": "t:labels.text" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.promo_popup.eyebrow" },
        { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading", "default": "Everything you need, in one place" },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Carefully chosen products, fair prices and fast delivery.</p>" },
        { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
        { "type": "text", "id": "button_label_2", "label": "t:sections.hero.button_label_2" },
        { "type": "url", "id": "button_link_2", "label": "t:sections.hero.button_link_2" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [{ "type": "slide" }]
    },
    {
      "name": "t:sections.hero.preset_banner",
      "settings": { "height": "medium" },
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "position": "center",
            "caption": "overlay",
            "color_scheme": "scheme-3",
            "tint_color": "#000000",
            "overlay": 50,
            "eyebrow": "Welcome to our store",
            "heading": "Made for everyday life",
            "text": "<p>Products we check ourselves and a team that answers within a day. Learn how we choose what we sell.</p>",
            "button_label": "Read more",
            "button_label_2": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
