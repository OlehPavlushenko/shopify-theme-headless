{% doc %}
  Tabs of the customer account (account, order, addresses pages): Orders, Addresses, Wishlist (when
  on), Log out. The current tab gets aria-current. Styles: .account-nav in packages/ui/css/account.css.
{% enddoc %}
{%- liquid
  assign on_orders = false
  if template.name == 'account' or template.name == 'order'
    assign on_orders = true
  endif
-%}
<nav class="account-nav" aria-label="{{ 'customers.account.nav' | t | escape }}">
  <ul class="account-nav__list" role="list">
    <li>
      <a href="{{ routes.account_url }}" class="account-nav__link"{% if on_orders %} aria-current="page"{% endif %}>
        {%- render 'icon', name: 'bag' -%}
        {{- 'customers.account.orders' | t -}}
      </a>
    </li>
    <li>
      <a href="{{ routes.account_addresses_url }}" class="account-nav__link"{% if template.name == 'addresses' %} aria-current="page"{% endif %}>
        {%- render 'icon', name: 'map-pin' -%}
        {{- 'customers.addresses.title' | t -}}
      </a>
    </li>
    {%- if settings.wishlist_enabled and pages['wishlist'] -%}
      <li>
        <a href="{{ pages['wishlist'].url }}" class="account-nav__link">
          {%- render 'icon', name: 'heart' -%}
          {{- 'wishlist.title' | t -}}
        </a>
      </li>
    {%- endif -%}
    <li class="account-nav__logout">
      <a href="{{ routes.account_logout_url }}" class="account-nav__link">
        {%- render 'icon', name: 'arrow-right' -%}
        {{- 'customers.account.logout' | t -}}
      </a>
    </li>
  </ul>
</nav>
