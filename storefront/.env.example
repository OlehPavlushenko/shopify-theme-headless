# Copy to .env.local and fill in. .env.local is git-ignored.

# Admin > Sales channels > Headless > the storefront > Storefront API: public access token
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-10

# The site's public address: canonical URLs, structured data, sitemap.xml
SITE_URL=http://localhost:3000

# Menus shown in the header and the footer (Admin > Content > Menus)
SHOPIFY_HEADER_MENU=main-menu
SHOPIFY_FOOTER_MENU=footer
