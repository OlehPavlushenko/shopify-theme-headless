{% comment %}
  Reset password (templates/customers/reset_password.json, from the recovery email): the new
  password twice. Styles: packages/ui/css/account.css.
{% endcomment %}
<div class="account-auth account-auth--single color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width account-auth__inner">
    <div class="account-card">
      <h1 class="h2">{{ 'customers.reset.title' | t }}</h1>
      <p class="account-card__lead">{{ 'customers.reset.lead' | t }}</p>
      {%- form 'reset_customer_password', class: 'account-form' -%}
        {%- render 'form-errors', errors: form.errors -%}
        <label class="account-form__field">
          <span class="account-form__label">{{ 'customers.fields.password' | t }}</span>
          <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
        </label>
        <label class="account-form__field">
          <span class="account-form__label">{{ 'customers.fields.password_confirm' | t }}</span>
          <input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </label>
        <button type="submit" class="btn btn--full">{{ 'customers.reset.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.account.reset",
  "class": "main-reset-section",
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }]
}
{% endschema %}
