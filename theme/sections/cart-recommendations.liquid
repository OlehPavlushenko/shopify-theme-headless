{% comment %}
  Markup source for the recommendations panel next to the cart drawer. Never placed on a page:
  <cart-recommendations> (assets/cart.js) requests it through the Product Recommendations API,
  /recommendations/products?product_id=…&intent=related&section_id=cart-recommendations,
  and takes the [data-product-id] rows (compact item: image, title, price, add).
{% endcomment %}
{%- if recommendations.performed? and recommendations.products_count > 0 -%}
  <ul role="list">
    {%- for product in recommendations.products -%}
      {%- if product.available -%}
        {%- render 'product-row', product: product -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.cart_recommendations.name",
  "class": "cart-recommendations-section",
  "settings": []
}
{% endschema %}
