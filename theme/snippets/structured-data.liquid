{% doc %}
  JSON-LD structured data, one place for the whole theme:
  - every page: Organization
  - home page: WebSite with SearchAction (sitelinks search box)
  - product / article: Shopify's structured_data filter (kept up to date by Shopify)
  BreadcrumbList is output by snippets/breadcrumbs.liquid where breadcrumbs are shown.
{% enddoc %}
{%- liquid
  assign shop_url = request.origin | append: routes.root_url
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop_url | json }}
    {%- if settings.logo != blank -%}
      ,"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif %}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{%- endif -%}
