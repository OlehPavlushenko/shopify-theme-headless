{% doc %}
  Loading placeholders of the wishlist / compare page, shown while <saved-products> has
  data-state="loading"; @ui/saved-pages shows as many as there are saved products.
  Styles: .skeleton (components.css), .saved-skeleton (saved.css).

  @param {string} layout - grid (product cards) or columns (compare table)
  @param {number} [count] - Placeholders rendered (the most a list can show at once), default 4
  @param {string} [style] - Inline style of the wrapper (grid columns)
{% enddoc %}
<div class="saved-skeleton saved-skeleton--{{ layout }}{% if layout == 'grid' %} grid{% endif %}" style="{{ style }}" data-saved-skeleton aria-hidden="true">
  {%- for i in (1..count) -%}
    <div class="saved-skeleton__item">
      <span class="skeleton skeleton--media"></span>
      <span class="skeleton skeleton--line"></span>
      <span class="skeleton skeleton--line skeleton--short"></span>
    </div>
  {%- endfor -%}
</div>
