<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="">
        <link rel="canonical" href="{{ canonical_url }}">
        <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

        {%- if settings.favicon != blank -%}
            <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
        {%- endif -%}

        {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
            <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
        {%- endunless -%}

        <title>
            {{ page_title }}
            {%- if current_tags -%}&ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
            {%- if current_page != 1 -%}&ndash; Page {{ current_page }}{%- endif -%}
            {%- unless page_title contains shop.name -%}
                &ndash;
                {{- shop.name -}}
            {%- endunless -%}
        </title>

        {%- if page_description -%}
            <meta name="description" content="{{ page_description | escape }}">
        {%- endif -%}

        {%- render 'meta-tags' -%}
        {%- render 'seo-schema' -%}

        {%- comment -%}
            Cascade layer order must be declared before anything else that uses layers, including the
            stylesheet bundle Shopify injects through content_for_header. See assets/theme.css.
        {%- endcomment -%}
        <style>
            @layer legacy, reset, base, layout, components, utilities;
        </style>

        {{ content_for_header }}

        {%- render 'theme-tokens' -%}
        {%- render 'color-schemes' -%}

        {%- comment -%} Legacy CSS, imported into the lowest layer until the sections that need it are rebuilt. {%- endcomment -%}
        {%- assign legacy_css = 'base.css,vendor.css,main-index.css' | split: ',' -%}
        {%- for file in legacy_css -%}
            <link rel="preload" href="{{ file | asset_url }}" as="style">
        {%- endfor -%}
        <style>
            {%- for file in legacy_css %}
                @import url('{{ file | asset_url }}') layer(legacy);
            {%- endfor %}
        </style>

        {{ 'theme.css' | asset_url | stylesheet_tag }}

        {%- unless settings.type_body_font.system? -%}
            {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
        {%- endunless -%}
        {%- unless settings.type_header_font.system? -%}
            {{ settings.type_header_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
        {%- endunless -%}

        {%- if settings.view_transitions -%}
            <style>
                @view-transition {
                    navigation: auto;
                }
            </style>
        {%- endif -%}

        {%- if settings.prefetch_links -%}
            <script type="speculationrules">
                {
                    "prefetch": [
                        {
                            "source": "document",
                            "where": {
                                "and": [
                                    { "href_matches": "/*" },
                                    { "not": { "href_matches": ["/cart*", "/checkout*", "/account*", "/*/cart*", "/*/account*"] } },
                                    { "not": { "selector_matches": "[rel~=nofollow], [data-no-prefetch]" } }
                                ]
                            },
                            "eagerness": "moderate"
                        }
                    ]
                }
            </script>
        {%- endif -%}

        {%- liquid
            if settings.currency_code_enabled
                assign money_format = shop.money_with_currency_format
            else
                assign money_format = shop.money_format
            endif
        -%}
        <script>
            document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
            window.theme = {
                routes: {
                    root: {{ routes.root_url | json }},
                    cart: {{ routes.cart_url | json }},
                },
                cart: {
                    type: {{ settings.cart_type | default: 'drawer' | json }},
                    cartUrl: {{ routes.cart_url | json }},
                    moneyFormat: {{ money_format | json }},
                },
            };
        </script>

        <script type="importmap">
            {
                "imports": {
                    "dialog": "{{ 'dialog.js' | asset_url }}",
                    "cart": "{{ 'cart.js' | asset_url }}",
                    "liquid-ajax-cart": "{{ 'liquid-ajax-cart-v2.2.0.js' | asset_url }}"
                }
            }
        </script>
        <link rel="modulepreload" href="{{ 'dialog.js' | asset_url }}">
        <link rel="modulepreload" href="{{ 'cart.js' | asset_url }}">
        <link rel="modulepreload" href="{{ 'liquid-ajax-cart-v2.2.0.js' | asset_url }}">
        <script type="module">
            import 'dialog';
            import 'cart';
        </script>

        {%- comment -%} Legacy scripts, removed together with the sections that use them. {%- endcomment -%}
        <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'helper-functions.js' | asset_url }}" defer="defer"></script>
    </head>

    <body class="template-{{ template.name }} template-{{ template | replace: '.', ' ' | handle }}">
        <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

        {% sections 'header-group' %}

        <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
            {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}

        {%- liquid
            unless template.name == 'cart'
                section 'cart-drawer'
            endunless
            section 'newsletter-popup'
            section 'cookie-notice'
        -%}

        <ul hidden>
            <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
        </ul>

        <script>
            Shopify.money_format = {{ money_format | json }};
        </script>
        <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'main-index.js' | asset_url }}" defer="defer"></script>
    </body>
</html>
