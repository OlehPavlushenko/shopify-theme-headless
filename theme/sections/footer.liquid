{% comment %}
  Site footer. Columns are blocks, in the editor's order: brand (logo, text, social), menu, contacts,
  products, articles. Bottom row: copyright, policy links, payment icons.
  Phones: the brand column stays open, the others are accordions (<details>, opened from 750px by
  @ui/footer). Contacts and social profiles come from Theme settings > Store details.
  Styles: packages/ui/css/footer.css.
{% endcomment %}
<footer class="site-footer color-{{ section.settings.color_scheme }}">
  {%- if section.blocks.size > 0 -%}
    {%- liquid
      # Columns that have something to show (a menu without links, a product list without products or a
      # blog without posts renders nothing)
      assign has_brand = false
      assign column_count = 0
      for block in section.blocks
        case block.type
          when 'brand'
            assign has_brand = true
          when 'menu'
            if block.settings.menu.links.size > 0
              assign column_count = column_count | plus: 1
            endif
          when 'products'
            if block.settings.products.count > 0 or block.settings.collection.products_count > 0
              assign column_count = column_count | plus: 1
            endif
          when 'articles'
            if block.settings.blog.articles_count > 0
              assign column_count = column_count | plus: 1
            endif
          else
            assign column_count = column_count | plus: 1
        endcase
      endfor
    -%}
    <site-footer
      class="site-footer__columns page-width{% if has_brand %} site-footer__columns--brand{% endif %}"
      style="--footer-columns: {{ column_count | at_least: 1 }};"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="site-footer__brand" {{ block.shopify_attributes }}>
              <a href="{{ routes.root_url }}" class="site-footer__logo">
                {%- if settings.logo -%}
                  {%- liquid
                    assign footer_logo_height = block.settings.logo_width | divided_by: settings.logo.aspect_ratio | round
                    assign footer_logo_sizes = block.settings.logo_width | append: 'px'
                  -%}
                  {{
                    settings.logo
                    | image_url: width: 480
                    | image_tag:
                      loading: 'lazy',
                      width: block.settings.logo_width,
                      height: footer_logo_height,
                      alt: shop.name,
                      sizes: footer_logo_sizes
                  }}
                {%- else -%}
                  <span class="h4">{{ shop.name | escape }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <div class="site-footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'social-links' -%}
              {%- endif -%}
            </div>

          {%- when 'menu' -%}
            {%- assign menu = block.settings.menu -%}
            {%- if menu.links.size > 0 -%}
              <details class="site-footer__column" data-footer-column open {{ block.shopify_attributes }}>
                <summary class="site-footer__heading eyebrow">
                  {{- block.settings.heading | default: menu.title | escape -}}
                  {%- render 'icon', name: 'chevron-down' -%}
                </summary>
                <nav aria-label="{{ block.settings.heading | default: menu.title | escape }}">
                  <ul class="link-list" role="list">
                    {%- for link in menu.links -%}
                      <li><a href="{{ link.url }}" class="link-list__link">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </nav>
              </details>
            {%- endif -%}

          {%- when 'contacts' -%}
            <details class="site-footer__column" data-footer-column open {{ block.shopify_attributes }}>
              <summary class="site-footer__heading eyebrow">
                {{- block.settings.heading | escape -}}
                {%- render 'icon', name: 'chevron-down' -%}
              </summary>
              {%- render 'store-contacts' -%}
            </details>

          {%- when 'products' -%}
            {%- liquid
              if block.settings.products.count > 0
                assign footer_products = block.settings.products
              else
                assign footer_products = block.settings.collection.products
              endif
            -%}
            {%- if block.settings.products.count > 0 or block.settings.collection.products_count > 0 -%}
              <details class="site-footer__column" data-footer-column open {{ block.shopify_attributes }}>
                <summary class="site-footer__heading eyebrow">
                  {{- block.settings.heading | escape -}}
                  {%- render 'icon', name: 'chevron-down' -%}
                </summary>
                <ul class="product-rows" role="list">
                  {%- for product in footer_products limit: block.settings.limit -%}
                    {%- render 'product-row', product: product, add: false -%}
                  {%- endfor -%}
                </ul>
              </details>
            {%- endif -%}

          {%- when 'articles' -%}
            {%- assign blog = block.settings.blog -%}
            {%- if blog.articles_count > 0 -%}
              <details class="site-footer__column" data-footer-column open {{ block.shopify_attributes }}>
                <summary class="site-footer__heading eyebrow">
                  {{- block.settings.heading | default: blog.title | escape -}}
                  {%- render 'icon', name: 'chevron-down' -%}
                </summary>
                <ul class="site-footer__articles" role="list">
                  {%- for article in blog.articles limit: block.settings.limit -%}
                    <li class="site-footer__article">
                      <a href="{{ article.url }}" class="frame site-footer__article-media" style="--frame-ratio: 1;" tabindex="-1" aria-hidden="true">
                        {%- if article.image -%}
                          {{ article.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 120, height: 120, sizes: '60px', alt: '' }}
                        {%- else -%}
                          {{ 'image' | placeholder_svg_tag }}
                        {%- endif -%}
                      </a>
                      <div class="site-footer__article-info">
                        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
                        <a href="{{ article.url }}" class="site-footer__article-title line-clamp">{{ article.title | escape }}</a>
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </site-footer>
    <script type="module">import '@ui/footer';</script>
  {%- endif -%}

  <div class="site-footer__bottom page-width">
    <p class="site-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | link_to: routes.root_url }}
      {%- if section.settings.show_powered_by %} · {{ powered_by_link }}{% endif %}
    </p>

    {%- if section.settings.show_policies and shop.policies.size > 0 -%}
      <ul class="site-footer__policies" role="list">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
        {%- endfor -%}
        {%- comment -%} Shown and wired by the cookie banner (sections/cookie-banner) when it is on {%- endcomment -%}
        <li><button type="button" class="site-footer__link-button" data-cookie-settings hidden>{{ 'cookies.settings' | t }}</button></li>
      </ul>
    {%- endif -%}

    {%- comment -%}
      Payment icons: Shopify's for the enabled payment types; without any (a dev store) the methods listed
      in the "Payment icons" setting, drawn by snippets/payment-icon
    {%- endcomment -%}
    {%- if section.settings.show_payment_icons -%}
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="site-footer__payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- elsif section.settings.payment_icons != blank -%}
        {%- assign listed = section.settings.payment_icons | remove: ' ' | split: ',' -%}
        <ul class="site-footer__payment" role="list">
          {%- for type in listed -%}
            <li>{%- render 'payment-icon', name: type, class: 'site-footer__payment-icon' -%}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.show_back_to_top -%}
      <a href="#" class="site-footer__top" data-back-to-top>
        {{- 'general.back_to_top' | t -}}
        {%- render 'icon', name: 'arrow-right' -%}
      </a>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "class": "site-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    { "type": "checkbox", "id": "show_policies", "label": "t:sections.footer.show_policies", "info": "t:sections.footer.show_policies_info", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true },
    { "type": "text", "id": "payment_icons", "label": "t:sections.footer.payment_icons", "info": "t:sections.footer.payment_icons_info", "default": "visa, master, american_express, paypal, apple_pay, google_pay", "visible_if": "{{ section.settings.show_payment_icons }}" },
    { "type": "checkbox", "id": "show_powered_by", "label": "t:sections.footer.show_powered_by", "default": false },
    { "type": "checkbox", "id": "show_back_to_top", "label": "t:sections.footer.show_back_to_top", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.brand",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "t:sections.footer.brand_info" },
        { "type": "range", "id": "logo_width", "label": "t:sections.footer.logo_width", "min": 80, "max": 240, "step": 10, "unit": "px", "default": 140 },
        { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Quality products for everyday life — chosen with care, delivered fast.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "t:sections.footer.show_social", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "t:labels.menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "info": "t:sections.footer.menu_heading_info" },
        { "type": "link_list", "id": "menu", "label": "t:labels.menu", "default": "footer" }
      ]
    },
    {
      "type": "contacts",
      "name": "t:sections.footer.contacts",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "t:sections.footer.contacts_info" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Contacts" }
      ]
    },
    {
      "type": "products",
      "name": "t:labels.products",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Popular" },
        { "type": "collection", "id": "collection", "label": "t:labels.collection" },
        { "type": "product_list", "id": "products", "label": "t:labels.products_list", "info": "t:labels.products_list_info", "limit": 4 },
        { "type": "range", "id": "limit", "label": "t:labels.limit", "min": 1, "max": 4, "step": 1, "default": 2 }
      ]
    },
    {
      "type": "articles",
      "name": "t:sections.footer.articles",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:labels.heading", "info": "t:sections.footer.articles_heading_info" },
        { "type": "blog", "id": "blog", "label": "t:labels.blog" },
        { "type": "range", "id": "limit", "label": "t:labels.limit", "min": 1, "max": 4, "step": 1, "default": 2 }
      ]
    }
  ]
}
{% endschema %}
