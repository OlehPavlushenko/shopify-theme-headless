{% comment %}
  Activate account (templates/customers/activate_account.json, from the invitation email): set a
  password (twice) or decline the invitation. Styles: packages/ui/css/account.css.
{% endcomment %}
<div class="account-auth account-auth--single color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width account-auth__inner">
    <div class="account-card">
      <h1 class="h2">{{ 'customers.activate.title' | t }}</h1>
      <p class="account-card__lead">{{ 'customers.activate.lead' | t }}</p>
      {%- form 'activate_customer_password', class: 'account-form' -%}
        {%- render 'form-errors', errors: form.errors -%}
        <label class="account-form__field">
          <span class="account-form__label">{{ 'customers.fields.password' | t }}</span>
          <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
        </label>
        <label class="account-form__field">
          <span class="account-form__label">{{ 'customers.fields.password_confirm' | t }}</span>
          <input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </label>
        <button type="submit" class="btn btn--full">{{ 'customers.activate.submit' | t }}</button>
        <button type="submit" name="decline" value="{{ 'customers.activate.decline' | t | escape }}" class="btn btn--link">{{ 'customers.activate.decline' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.account.activate",
  "class": "main-activate-section",
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }]
}
{% endschema %}
