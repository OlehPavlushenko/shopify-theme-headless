{% doc %}
  JSON-LD structured data, one place for the whole theme:
  - every page: Organization (@id shop#organization) — logo, contacts, social profiles, and when
    Theme settings > Search engines has a country: the return policy (hasMerchantReturnPolicy) and
    the shipping policy (hasShippingService: rate, free-shipping threshold, handling and transit
    days), which Google shows next to products (Merchant Center settings take precedence)
  - home page: WebSite (publisher → the Organization) with SearchAction
  - collection: CollectionPage with an ItemList of its first products
  - product / article: Shopify's structured_data filter (kept up to date by Shopify)
  BreadcrumbList is output by snippets/breadcrumbs.liquid where breadcrumbs are shown; the FAQ
  section outputs FAQPage where it is switched on.
{% enddoc %}
{%- liquid
  assign shop_url = request.origin | append: routes.root_url
  assign org_id = shop_url | append: '#organization'
  assign currency = shop.currency
  assign networks = 'instagram,facebook,tiktok,youtube,telegram,pinterest' | split: ','
  capture profiles_list
    for name in networks
      assign key = 'social_' | append: name
      if settings[key] != blank
        echo settings[key] | append: '|'
      endif
    endfor
  endcapture
  assign profiles = profiles_list | split: '|'
  assign country = settings.seo_country | strip | upcase
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ org_id | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop_url | json }}
    {%- if settings.logo != blank -%}
      ,"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
    {%- endif -%}
    {%- if shop.description != blank -%}
      ,"description": {{ shop.description | strip_html | json }}
    {%- endif -%}
    {%- if settings.store_phone != blank -%}
      ,"telephone": {{ settings.store_phone | json }}
    {%- endif -%}
    {%- if settings.store_email != blank -%}
      ,"email": {{ settings.store_email | json }}
    {%- endif -%}
    {%- if settings.store_phone != blank or settings.store_email != blank -%}
      ,"contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service"
        {%- if settings.store_phone != blank %},"telephone": {{ settings.store_phone | json }}{% endif -%}
        {%- if settings.store_email != blank %},"email": {{ settings.store_email | json }}{% endif %}
      }
    {%- endif -%}
    {%- if settings.store_address != blank -%}
      ,"address": {{ settings.store_address | newline_to_br | split: '<br />' | join: ', ' | strip_newlines | json }}
    {%- endif -%}
    {%- if profiles.size > 0 -%}
      ,"sameAs": {{ profiles | json }}
    {%- endif -%}
    {%- if country.size == 2 -%}
      {%- liquid
        case settings.seo_return_policy
          when 'none'
            assign return_category = 'MerchantReturnNotPermitted'
          when 'unlimited'
            assign return_category = 'MerchantReturnUnlimitedWindow'
          else
            assign return_category = 'MerchantReturnFiniteReturnWindow'
        endcase
        assign rate = settings.seo_shipping_rate | default: 0 | times: 1.0
        assign free_from = settings.seo_free_shipping_from | default: 0 | times: 1.0
      -%}
      ,"hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": {{ country | json }},
        "returnPolicyCategory": "https://schema.org/{{ return_category }}"
        {%- if return_category == 'MerchantReturnFiniteReturnWindow' -%}
          ,"merchantReturnDays": {{ settings.seo_return_days | default: 14 }}
        {%- endif -%}
        {%- unless return_category == 'MerchantReturnNotPermitted' -%}
          ,"returnMethod": "https://schema.org/ReturnByMail"
          ,"returnFees": "https://schema.org/{% if settings.seo_free_returns %}FreeReturn{% else %}ReturnFeesCustomerResponsibility{% endif %}"
          ,"refundType": "https://schema.org/FullRefund"
        {%- endunless -%}
        {%- if pages['shipping-returns'] != empty -%}
          ,"merchantReturnLink": {{ request.origin | append: pages['shipping-returns'].url | json }}
        {%- endif %}
      }
      ,"hasShippingService": {
        "@type": "ShippingService",
        "fulfillmentType": "https://schema.org/FulfillmentTypeDelivery",
        "handlingTime": {
          "@type": "ServicePeriod",
          "duration": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": {{ settings.seo_handling_days | default: 2 }}, "unitCode": "DAY" }
        },
        "shippingConditions": [
          {
            "@type": "ShippingConditions",
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": {{ country | json }} },
            {%- if free_from > 0 -%}
              "orderValue": { "@type": "MonetaryAmount", "minValue": 0, "maxValue": {{ free_from | minus: 0.01 }}, "currency": {{ currency | json }} },
            {%- endif -%}
            "shippingRate": { "@type": "MonetaryAmount", "value": {{ rate }}, "currency": {{ currency | json }} },
            "transitTime": {
              "@type": "ServicePeriod",
              "duration": { "@type": "QuantitativeValue", "minValue": {{ settings.seo_transit_min | default: 2 }}, "maxValue": {{ settings.seo_transit_max | default: 5 }}, "unitCode": "DAY" }
            }
          }
          {%- if free_from > 0 -%}
            ,{
              "@type": "ShippingConditions",
              "shippingDestination": { "@type": "DefinedRegion", "addressCountry": {{ country | json }} },
              "orderValue": { "@type": "MonetaryAmount", "minValue": {{ free_from }}, "currency": {{ currency | json }} },
              "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": {{ currency | json }} },
              "transitTime": {
                "@type": "ServicePeriod",
                "duration": { "@type": "QuantitativeValue", "minValue": {{ settings.seo_transit_min | default: 2 }}, "maxValue": {{ settings.seo_transit_max | default: 5 }}, "unitCode": "DAY" }
              }
            }
          {%- endif %}
        ]
      }
    {%- endif %}
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- capture search_query -%}{% render 'search-options', format: 'query' %}{%- endcapture -%}
  {%- assign search_query = search_query | strip -%}
  {%- assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' | append: search_query -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ shop_url | append: '#website' | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop_url | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{ article | structured_data }}
  </script>
{%- elsif request.page_type == 'collection' and collection.products_count > 0 -%}
  {%- comment -%} The collection and its first products: what the page lists, for search and AI answers {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#collection' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ collection.title | json }}
      {%- if collection.description != blank -%}
        ,"description": {{ collection.description | strip_html | truncatewords: 50 | json }}
      {%- endif %},
      "isPartOf": { "@id": {{ shop_url | append: '#website' | json }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for product in collection.products limit: 12 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ request.origin | append: product.url | json }},
              "name": {{ product.title | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}
