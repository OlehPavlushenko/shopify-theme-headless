<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'meta-tags' -%}
    {%- render 'structured-data' -%}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- comment -%}
      CSS: tokens (defaults, declares the layer order) -> base -> components.
      All of it is generated from packages/ui by scripts/sync-ui.mjs. Theme settings override
      the token defaults in theme-tokens + color-schemes (unlayered, so they win).
    {%- endcomment -%}
    {{ 'ui-tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-components.css' | asset_url | stylesheet_tag }}
    {{ 'ui-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'ui-slider.css' | asset_url | stylesheet_tag }}
    {{ 'ui-announcements.css' | asset_url | stylesheet_tag }}
    {{ 'ui-header.css' | asset_url | stylesheet_tag }}
    {{ 'ui-search.css' | asset_url | stylesheet_tag }}
    {{ 'ui-blocks.css' | asset_url | stylesheet_tag }}
    {{ 'ui-pages.css' | asset_url | stylesheet_tag }}
    {{ 'ui-cart.css' | asset_url | stylesheet_tag }}
    {{ 'ui-promo.css' | asset_url | stylesheet_tag }}
    {{ 'ui-sections.css' | asset_url | stylesheet_tag }}
    {{ 'ui-footer.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-tokens' -%}
    {%- render 'color-schemes' -%}

    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {%- if settings.view_transitions -%}
      <style>
        @view-transition {
          navigation: auto;
        }
      </style>
    {%- endif -%}

    {%- if settings.prefetch_links -%}
      <script type="speculationrules">
        {
          "prefetch": [
            {
              "source": "document",
              "where": {
                "and": [
                  { "href_matches": "/*" },
                  { "not": { "href_matches": ["/cart*", "/checkout*", "/account*", "/*/cart*", "/*/account*"] } },
                  { "not": { "selector_matches": "[rel~=nofollow], [data-no-prefetch]" } }
                ]
              },
              "eagerness": "moderate"
            }
          ]
        }
      </script>
    {%- endif -%}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.theme = {
        cart: {
          type: {{ settings.cart_type | json }},
          cartUrl: {{ routes.cart_url | json }},
          moneyFormat: {{ shop.money_format | json }},
          recommendationsUrl: {{ routes.product_recommendations_url | json }},
        },
      };
    </script>

    {%- comment -%}
      JS: ES modules, no bundler. @ui/* are shared packages (packages/ui/js), the rest is theme-only.
      A headless storefront maps the same @ui/* specifiers to packages/ui/js.
    {%- endcomment -%}
    <script type="importmap">
      {
        "imports": {
          "@ui/dialog": "{{ 'ui-dialog.js' | asset_url }}",
          "@ui/money": "{{ 'ui-money.js' | asset_url }}",
          "@ui/header": "{{ 'ui-header.js' | asset_url }}",
          "@ui/nav-menu": "{{ 'ui-nav-menu.js' | asset_url }}",
          "@ui/drill-menu": "{{ 'ui-drill-menu.js' | asset_url }}",
          "@ui/predictive-search": "{{ 'ui-predictive-search.js' | asset_url }}",
          "@ui/slider": "{{ 'ui-slider.js' | asset_url }}",
          "@ui/countdown": "{{ 'ui-countdown.js' | asset_url }}",
          "@ui/newsletter": "{{ 'ui-newsletter.js' | asset_url }}",
          "@ui/promo-popup": "{{ 'ui-promo-popup.js' | asset_url }}",
          "@ui/footer": "{{ 'ui-footer.js' | asset_url }}",
          "@ui/background-video": "{{ 'ui-background-video.js' | asset_url }}",
          "@ui/show-more": "{{ 'ui-show-more.js' | asset_url }}",
          "@ui/variant-picker": "{{ 'ui-variant-picker.js' | asset_url }}",
          "liquid-ajax-cart": "{{ 'liquid-ajax-cart-v2.2.0.js' | asset_url }}",
          "cart": "{{ 'cart.js' | asset_url }}",
          "quick-view": "{{ 'quick-view.js' | asset_url }}"
        }
      }
    </script>
    <link rel="modulepreload" href="{{ 'ui-dialog.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'cart.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'liquid-ajax-cart-v2.2.0.js' | asset_url }}">
    <script type="module">
      import '@ui/dialog';
      import '@ui/header';
      import '@ui/nav-menu';
      import '@ui/drill-menu';
      import '@ui/predictive-search';
      import '@ui/slider';
      import 'cart';
      import 'quick-view';
    </script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- unless template.name == 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endunless -%}

    {%- comment -%} Popups and other overlays (theme editor: "Overlays") {%- endcomment -%}
    {% sections 'overlay-group' %}
    {% render 'quick-view-dialog' %}
  </body>
</html>
