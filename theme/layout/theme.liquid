<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'meta-tags' -%}
    {%- render 'structured-data' -%}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- comment -%}
      CSS: tokens (defaults, declares the layer order) -> base -> components.
      All of it is generated from packages/ui by scripts/sync-ui.mjs. Theme settings override
      the token defaults in theme-tokens + color-schemes (unlayered, so they win).
    {%- endcomment -%}
    {{ 'ui-tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ui-components.css' | asset_url | stylesheet_tag }}
    {{ 'ui-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'ui-slider.css' | asset_url | stylesheet_tag }}
    {{ 'ui-announcements.css' | asset_url | stylesheet_tag }}
    {{ 'ui-header.css' | asset_url | stylesheet_tag }}
    {{ 'ui-blocks.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'product' -%}
      {{ 'ui-product.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {{ 'ui-sections.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'collection' or template.name == 'search' -%}
      {{ 'ui-facets.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- liquid
      # Wishlist / compare pages: their styles block; elsewhere only the recently viewed list
      # (below the fold) uses them, so they join the deferred files
      assign saved_page = false
      if template.suffix == 'wishlist' or template.suffix == 'compare'
        assign saved_page = true
      endif
    -%}
    {%- if saved_page -%}
      {{ 'ui-saved.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- comment -%}
      Styles of what is off screen at first paint — the search panel, the cart drawer, popups and
      promo banners further down, the footer — load without blocking the first render (layer order
      comes from tokens.css, so the load order doesn't matter). On their own templates (search, cart)
      they block as usual.
    {%- endcomment -%}
    {%- liquid
      assign deferred = 'ui-search.css,ui-cart.css,ui-promo.css,ui-footer.css'
      unless saved_page
        assign deferred = deferred | append: ',ui-saved.css'
      endunless
      assign deferred = deferred | split: ','
    -%}
    {%- for file in deferred -%}
      {%- liquid
        assign blocking = false
        if template.name == 'search' and file == 'ui-search.css'
          assign blocking = true
        endif
        if template.name == 'cart' and file == 'ui-cart.css'
          assign blocking = true
        endif
      -%}
      {%- if blocking -%}
        {{ file | asset_url | stylesheet_tag }}
      {%- else -%}
        <link rel="stylesheet" href="{{ file | asset_url }}" media="print" onload="this.media='all'">
        <noscript>{{ file | asset_url | stylesheet_tag }}</noscript>
      {%- endif -%}
    {%- endfor %}
    {%- render 'theme-tokens' -%}
    {%- render 'color-schemes' -%}

    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {%- if settings.view_transitions -%}
      <style>
        @view-transition {
          navigation: auto;
        }
      </style>
    {%- endif -%}

    {%- if settings.prefetch_links -%}
      <script type="speculationrules">
        {
          "prefetch": [
            {
              "source": "document",
              "where": {
                "and": [
                  { "href_matches": "/*" },
                  { "not": { "href_matches": ["/cart*", "/checkout*", "/account*", "/*/cart*", "/*/account*"] } },
                  { "not": { "selector_matches": "[rel~=nofollow], [data-no-prefetch]" } }
                ]
              },
              "eagerness": "moderate"
            }
          ]
        }
      </script>
    {%- endif -%}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.theme = {
        cart: {
          type: {{ settings.cart_type | json }},
          cartUrl: {{ routes.cart_url | json }},
          moneyFormat: {{ shop.money_format | json }},
          recommendationsUrl: {{ routes.product_recommendations_url | json }},
        },
      };
    </script>

    {%- comment -%}
      JS: ES modules, no bundler. @ui/* are shared packages (packages/ui/js), the rest is theme-only.
      A headless storefront maps the same @ui/* specifiers to packages/ui/js.
    {%- endcomment -%}
    <script type="importmap">
      {
        "imports": {
          "@ui/dialog": "{{ 'ui-dialog.js' | asset_url }}",
          "@ui/money": "{{ 'ui-money.js' | asset_url }}",
          "@ui/header": "{{ 'ui-header.js' | asset_url }}",
          "@ui/nav-menu": "{{ 'ui-nav-menu.js' | asset_url }}",
          "@ui/drill-menu": "{{ 'ui-drill-menu.js' | asset_url }}",
          "@ui/predictive-search": "{{ 'ui-predictive-search.js' | asset_url }}",
          "@ui/slider": "{{ 'ui-slider.js' | asset_url }}",
          "@ui/countdown": "{{ 'ui-countdown.js' | asset_url }}",
          "@ui/newsletter": "{{ 'ui-newsletter.js' | asset_url }}",
          "@ui/promo-popup": "{{ 'ui-promo-popup.js' | asset_url }}",
          "@ui/footer": "{{ 'ui-footer.js' | asset_url }}",
          "@ui/background-video": "{{ 'ui-background-video.js' | asset_url }}",
          "@ui/show-more": "{{ 'ui-show-more.js' | asset_url }}",
          "@ui/variant-picker": "{{ 'ui-variant-picker.js' | asset_url }}",
          "@ui/saved-list": "{{ 'ui-saved-list.js' | asset_url }}",
          "@ui/toast": "{{ 'ui-toast.js' | asset_url }}",
          "@ui/read-more": "{{ 'ui-read-more.js' | asset_url }}",
          "@ui/faq-search": "{{ 'ui-faq-search.js' | asset_url }}",
          "@ui/delivery": "{{ 'ui-delivery.js' | asset_url }}",
          "@ui/delivery-steps": "{{ 'ui-delivery-steps.js' | asset_url }}",
          "saved-pages": "{{ 'saved-pages.js' | asset_url }}",
          "facets": "{{ 'facets.js' | asset_url }}",
          "product": "{{ 'product.js' | asset_url }}",
          "liquid-ajax-cart": "{{ 'liquid-ajax-cart-v2.2.0.js' | asset_url }}",
          "cart": "{{ 'cart.js' | asset_url }}",
          "quick-view": "{{ 'quick-view.js' | asset_url }}"
        }
      }
    </script>
    <link rel="modulepreload" href="{{ 'ui-dialog.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'cart.js' | asset_url }}">
    <link rel="modulepreload" href="{{ 'liquid-ajax-cart-v2.2.0.js' | asset_url }}">
    <script type="module">
      import '@ui/dialog';
      import '@ui/header';
      import '@ui/nav-menu';
      import '@ui/drill-menu';
      import '@ui/predictive-search';
      import '@ui/slider';
      import 'cart';
      import 'quick-view';
    </script>
    {%- if settings.wishlist_enabled or settings.compare_enabled -%}
      <script type="module">import '@ui/saved-list';</script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- unless template.name == 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endunless -%}

    {%- comment -%} Popups and other overlays (theme editor: "Overlays") {%- endcomment -%}
    {% sections 'overlay-group' %}
    {% render 'quick-view-dialog' %}
    {%- if settings.compare_enabled -%}
      {%- comment -%} Texts of the compare toasts (@ui/saved-list): added, removed, "up to 4" {%- endcomment -%}
      <template
        data-saved-toast="compare"
        data-added="{{ 'compare.added' | t | escape }}"
        data-removed="{{ 'compare.removed' | t | escape }}"
        data-full="{{ 'compare.full' | t: max: '%n' | escape }}"
        data-view="{{ 'compare.title' | t | escape }}"
        data-undo="{{ 'wishlist.undo' | t | escape }}"
        data-href="{{ pages['compare'].url | default: routes.root_url }}"
      ></template>
    {%- endif -%}
    {%- if settings.wishlist_enabled -%}
      {%- comment -%} Texts of the wishlist toasts (@ui/saved-list) {%- endcomment -%}
      <template
        data-saved-toast="wishlist"
        data-added="{{ 'wishlist.added' | t | escape }}"
        data-removed="{{ 'wishlist.removed' | t | escape }}"
        data-view="{{ 'wishlist.view' | t | escape }}"
        data-undo="{{ 'wishlist.undo' | t | escape }}"
        data-href="{{ pages['wishlist'].url | default: routes.root_url }}"
      ></template>
    {%- endif -%}
  </body>
</html>
