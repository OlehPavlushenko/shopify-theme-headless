{% comment %}
  Promo grid: 1–3 promo cards side by side, a swipeable row on phones (snippets/promo-card, the same
  card as in the mega menu).
  Styles: packages/ui/css/sections.css.
{% endcomment %}
<div class="promo-grid color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width">
    <ui-slider
      class="slider promo-grid__slider"
      style="--slider-columns: {{ section.blocks.size | at_least: 1 | at_most: 3 }}; --slider-columns-mobile: 1.2;"
    >
      {%- render 'section-head', heading: section.settings.heading -%}
      <ul class="slider__track" data-slider-track role="list">
        {%- for block in section.blocks -%}
          <li>
            {%- render 'promo-card',
              url: block.settings.link,
              image: block.settings.image,
              eyebrow: block.settings.eyebrow,
              heading: block.settings.heading,
              text: block.settings.text,
              link_label: block.settings.link_label,
              layout: section.settings.card_layout,
              ratio: section.settings.ratio,
              sizes: '(min-width: 750px) 33vw, 100vw',
              attributes: block.shopify_attributes
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </ui-slider>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.promo_grid.name",
  "class": "promo-grid-section",
  "disabled_on": { "groups": ["*"] },
  "max_blocks": 3,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "t:labels.heading" },
    {
      "type": "select",
      "id": "card_layout",
      "label": "t:blocks.menu_promo.layout",
      "options": [
        { "value": "overlay", "label": "t:blocks.menu_promo.layout_overlay" },
        { "value": "stacked", "label": "t:blocks.menu_promo.layout_stacked" }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:labels.ratio",
      "options": [
        { "value": "4 / 5", "label": "t:labels.ratio_portrait" },
        { "value": "1", "label": "t:labels.ratio_square" },
        { "value": "4 / 3", "label": "t:labels.ratio_landscape" }
      ],
      "default": "4 / 5"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "t:sections.promo_grid.promo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
        { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "New arrivals" },
        { "type": "text", "id": "text", "label": "t:labels.text" },
        { "type": "text", "id": "link_label", "label": "t:labels.link_label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "t:labels.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_grid.name",
      "blocks": [{ "type": "promo" }, { "type": "promo" }, { "type": "promo" }]
    }
  ]
}
{% endschema %}
