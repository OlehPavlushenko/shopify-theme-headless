{% doc %}
  Cart totals for the cart drawer and the cart page: order-level discounts, total, savings,
  taxes note.

  @param {boolean} [hide_total] - Skip the total row (the drawer shows the total in its checkout button)
{% enddoc %}
<div class="cart-summary">
  {%- for discount in cart.cart_level_discount_applications -%}
    <div class="cart-summary__row cart-summary__discount">
      <span>{{ discount.title | escape }}</span>
      <span>−{{ discount.total_allocated_amount | money }}</span>
    </div>
  {%- endfor -%}
  {%- unless hide_total -%}
    <div class="cart-summary__row cart-summary__total">
      <span>{{ 'cart.total' | t }}</span>
      <span>{{ cart.total_price | money }}</span>
    </div>
  {%- endunless -%}
  {%- liquid
    # Savings: discount codes and automatic discounts, plus compare-at (sale) prices
    assign savings = cart.total_discount
    for item in cart.items
      if item.variant.compare_at_price > item.original_price
        assign sale_saving = item.variant.compare_at_price | minus: item.original_price | times: item.quantity
        assign savings = savings | plus: sale_saving
      endif
    endfor
  -%}
  {%- if savings > 0 -%}
    <p class="cart-summary__savings">{{ 'cart.savings' | t }} {{ savings | money }}</p>
  {%- endif -%}
  <p class="cart-summary__note">{{ 'cart.taxes_note' | t }}</p>
</div>
