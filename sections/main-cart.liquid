{% comment %}
    Cart page. Same building blocks as the cart drawer (cart-line-item, cart-free-shipping,
    cart-attribute, cart-upsell-item); Liquid Ajax Cart re-renders [data-ajax-cart-section] after
    every change. Without JS the quantity links and the update button still work.
{% endcomment %}
{%- liquid
    assign upsell_products = settings.recommend_list
    assign cart_product_ids = cart.items | map: 'product_id'
-%}
<div
    class="main-cart color-{{ section.settings.color_scheme }} section-spacing"
    style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
    <div class="page-width" data-ajax-cart-section>
        <h1 class="main-cart__title h2">{{ 'templates.cart.cart' | t }}</h1>

        {%- if cart.item_count == 0 -%}
            <div class="cart-empty stack">
                <p class="h4">{{ 'sections.cart.empty' | t }}</p>
                <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'sections.cart.continue_shopping' | t }}</a>
                {%- if shop.customer_accounts_enabled and customer == null -%}
                    <p class="small">{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}</p>
                {%- endif -%}
            </div>
        {%- else -%}
            <form action="{{ routes.cart_url }}" method="post" id="CartPage-form" class="main-cart__layout">
                <div class="main-cart__lines">
                    <ul class="cart-lines" role="list">
                        {%- for item in cart.items -%}
                            {%- liquid
                                assign eager = false
                                if forloop.index <= 3
                                    assign eager = true
                                endif
                            -%}
                            {%- render 'cart-line-item', item: item, line: forloop.index, eager: eager -%}
                        {%- endfor -%}
                    </ul>
                    <noscript>
                        <button type="submit" name="update" class="btn btn--outline">{{ 'sections.cart.update' | t }}</button>
                    </noscript>
                </div>

                <aside class="main-cart__summary stack" aria-label="{{ 'sections.cart.summary' | t }}">
                    {%- render 'cart-free-shipping' -%}

                    {%- if settings.show_cart_note -%}
                        <label class="field">
                            <span class="field__label">{{ 'sections.cart.note' | t }}</span>
                            <textarea class="input" name="note" data-ajax-cart-property-input>{{ cart.note }}</textarea>
                        </label>
                    {%- endif -%}
                    {%- for block in section.blocks -%}
                        {%- render 'cart-attribute', block: block -%}
                    {%- endfor -%}

                    <div class="cart-summary">
                        {%- for discount in cart.cart_level_discount_applications -%}
                            <div class="cart-summary__row small">
                                <span>{{ discount.title }}</span>
                                <span>−{{ discount.total_allocated_amount | money }}</span>
                            </div>
                        {%- endfor -%}
                        <div class="cart-summary__row h5">
                            <span>{{ 'sections.cart.total' | t }}</span>
                            <span>
                                {%- if settings.currency_code_enabled -%}
                                    {{ cart.total_price | money_with_currency }}
                                {%- else -%}
                                    {{ cart.total_price | money }}
                                {%- endif -%}
                            </span>
                        </div>
                        <p class="small muted">{{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}</p>
                    </div>

                    <button type="submit" name="checkout" class="btn btn--full">{{ 'sections.cart.checkout' | t }}</button>
                    {%- if additional_checkout_buttons and section.settings.show_dynamic_checkout -%}
                        <div class="main-cart__dynamic-checkout" data-ajax-cart-static-element>{{ content_for_additional_checkout_buttons }}</div>
                    {%- endif -%}
                </aside>
            </form>
        {%- endif -%}

        {%- if settings.show_recommend_prod and upsell_products.count > 0 -%}
            {%- capture upsell_items -%}
                {%- for product in upsell_products -%}
                    {%- if cart_product_ids contains product.id or product.available == false -%}
                        {%- continue -%}
                    {%- endif -%}
                    {%- render 'cart-upsell-item', product: product -%}
                {%- endfor -%}
            {%- endcapture -%}
            {%- if upsell_items != blank -%}
                <div class="cart-upsell main-cart__upsell stack">
                    <h2 class="h5">{{ 'sections.cart.recommend' | t }}</h2>
                    <ul class="cart-upsell__list" role="list">{{ upsell_items }}</ul>
                </div>
            {%- endif -%}
        {%- endif -%}
    </div>
</div>

<script type="application/json" data-ajax-cart-initial-state>
    {{ cart | json }}
</script>

{% stylesheet %}
    @layer components {
        .main-cart__title {
            margin-bottom: var(--space-xl);
        }

        .main-cart__layout {
            display: grid;
            gap: var(--space-2xl);
        }

        @media (min-width: 990px) {
            .main-cart__layout {
                grid-template-columns: minmax(0, 1fr) 38rem;
                align-items: start;
            }

            .main-cart__summary {
                position: sticky;
                top: var(--space-l);
            }
        }

        .main-cart__summary {
            padding: var(--space-l);
            border-radius: var(--radius-card);
            background: var(--neutral-light);
        }

        .main-cart__upsell {
            margin-top: var(--space-2xl);
        }

        @media (min-width: 750px) {
            .main-cart__upsell .cart-upsell__list {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "Cart",
    "class": "main-cart-section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "checkbox",
            "id": "show_dynamic_checkout",
            "label": "Show dynamic checkout buttons",
            "info": "Shop Pay, Apple Pay, PayPal and other accelerated checkouts enabled in your store.",
            "default": true
        },
        {
            "type": "paragraph",
            "content": "Upsell products, cart note and the free-shipping bar are set in Theme settings > Cart."
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Top padding",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Bottom padding",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "default": 40
        }
    ],
    "blocks": [
        {
            "type": "text",
            "name": "Text field",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Gift message" },
                { "type": "checkbox", "id": "required", "label": "Required", "default": false }
            ]
        },
        {
            "type": "select",
            "name": "Dropdown",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Delivery day" },
                { "type": "text", "id": "options", "label": "Options", "info": "Separate options with |", "default": "Monday|Wednesday|Friday" }
            ]
        },
        {
            "type": "radio",
            "name": "Radio buttons",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Delivery time" },
                { "type": "text", "id": "options", "label": "Options", "info": "Separate options with |", "default": "Morning|Afternoon|Evening" }
            ]
        },
        {
            "type": "checkbox",
            "name": "Checkbox",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Leave at the door" }
            ]
        }
    ]
}
{% endschema %}
