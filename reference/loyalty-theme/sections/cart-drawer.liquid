{% comment %}
    Cart drawer: a native <dialog> (assets/dialog.js) whose content Liquid Ajax Cart re-renders after
    every cart request ([data-ajax-cart-section]). The dialog element itself is never re-rendered,
    so it stays open while the cart updates.
    Also holds #CartNotification, used when Theme settings > Cart > "After adding to cart" is "Notification".
    Rendered from layout/theme.liquid on every page except /cart.
{% endcomment %}
{%- liquid
    assign upsell_products = settings.recommend_list
    assign cart_product_ids = cart.items | map: 'product_id'
-%}

<dialog
    id="CartDrawer"
    class="drawer color-{{ section.settings.color_scheme }}"
    aria-labelledby="CartDrawer-title"
>
    <div class="drawer__inner" data-ajax-cart-section>
        <div class="drawer__header">
            <h2 id="CartDrawer-title" class="h5">
                {{ 'sections.cart.cart' | t }}
                {%- if cart.item_count > 0 %} <span class="muted">({{ cart.item_count }})</span>{% endif -%}
            </h2>
            <button type="button" class="btn btn--icon" data-dialog-close aria-label="{{ 'sections.cart.close' | t }}">
                {%- render 'icon', name: 'close' -%}
            </button>
        </div>

        <div class="drawer__body cart-drawer__body" data-ajax-cart-section-scroll>
            {%- render 'cart-free-shipping' -%}

            {%- if cart.item_count == 0 -%}
                <div class="cart-empty stack">
                    <p class="h4">{{ 'sections.cart.empty' | t }}</p>
                    <a href="{{ routes.all_products_collection_url }}" class="btn">
                        {{- 'sections.cart.continue_shopping' | t -}}
                    </a>
                    {%- if shop.customer_accounts_enabled and customer == null -%}
                        <p class="small">{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}</p>
                    {%- endif -%}
                </div>
            {%- else -%}
                <ul class="cart-lines" role="list">
                    {%- for item in cart.items -%}
                        {%- render 'cart-line-item', item: item, line: forloop.index -%}
                    {%- endfor -%}
                </ul>
            {%- endif -%}

            {%- if settings.show_recommend_prod and upsell_products.count > 0 -%}
                {%- capture upsell_items -%}
                    {%- for product in upsell_products -%}
                        {%- if cart_product_ids contains product.id or product.available == false -%}
                            {%- continue -%}
                        {%- endif -%}
                        {%- render 'cart-upsell-item', product: product -%}
                    {%- endfor -%}
                {%- endcapture -%}
                {%- if upsell_items != blank -%}
                    <div class="cart-upsell stack">
                        <h3 class="h6">{{ 'sections.cart.recommend' | t }}</h3>
                        <ul class="cart-upsell__list" role="list">{{ upsell_items }}</ul>
                    </div>
                {%- endif -%}
            {%- endif -%}
        </div>

        {%- if cart.item_count > 0 -%}
            <form action="{{ routes.cart_url }}" method="post" class="drawer__footer stack" id="CartDrawer-form">
                {%- if settings.show_cart_note or section.blocks.size > 0 -%}
                    <details class="cart-extras">
                        <summary class="cart-extras__summary small">
                            {{- 'sections.cart.comments' | t -}}
                            {%- render 'icon', name: 'chevron-down' -%}
                        </summary>
                        <div class="cart-extras__content stack">
                            {%- if settings.show_cart_note -%}
                                <label class="field">
                                    <span class="field__label">{{ 'sections.cart.note' | t }}</span>
                                    <textarea class="input" name="note" data-ajax-cart-property-input>
                                        {{- cart.note -}}
                                    </textarea>
                                </label>
                            {%- endif -%}
                            {%- for block in section.blocks -%}
                                {%- render 'cart-attribute', block: block -%}
                            {%- endfor -%}
                        </div>
                    </details>
                {%- endif -%}

                <div class="cart-summary">
                    <div class="cart-summary__row">
                        <span>{{ 'sections.cart.total' | t }}</span>
                        <strong>
                            {%- if settings.currency_code_enabled -%}
                                {{ cart.total_price | money_with_currency }}
                            {%- else -%}
                                {{ cart.total_price | money }}
                            {%- endif -%}
                        </strong>
                    </div>
                    {%- for discount in cart.cart_level_discount_applications -%}
                        <div class="cart-summary__row small">
                            <span>{{ discount.title }}</span>
                            <span>−{{ discount.total_allocated_amount | money }}</span>
                        </div>
                    {%- endfor -%}
                    <p class="small muted">{{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}</p>
                </div>

                <button type="submit" name="checkout" class="btn btn--full">
                    {{- 'sections.cart.checkout' | t -}}
                </button>
                <a href="{{ routes.cart_url }}" class="btn btn--outline btn--full">{{ 'templates.cart.cart' | t }}</a>
            </form>
        {%- endif -%}
    </div>
</dialog>

<dialog
    id="CartNotification"
    class="popup cart-added color-{{ section.settings.color_scheme }}"
    aria-labelledby="CartNotification-title"
>
    <div class="cart-added__inner stack">
        <div class="cart-added__head">
            <p id="CartNotification-title" class="cluster">
                {%- render 'icon', name: 'check' -%}
                {{ 'sections.cart.added' | t }}
            </p>
            <button type="button" class="btn btn--icon" data-dialog-close aria-label="{{ 'sections.cart.close' | t }}">
                {%- render 'icon', name: 'close' -%}
            </button>
        </div>
        <div class="cart-added__item">
            <img data-notification="image" class="cart-added__image" width="80" height="80" alt="" hidden>
            <div class="stack" style="--stack-gap: var(--space-2xs);">
                <p class="cart-line__title" data-notification="title"></p>
                <p class="small muted" data-notification="variant"></p>
                <p class="price-tag" data-notification="price"></p>
                <p class="small muted" data-notification="quantity"></p>
            </div>
        </div>
        <div class="cluster cart-added__actions">
            <a href="{{ routes.cart_url }}" class="btn btn--outline">
                {{- 'templates.cart.cart' | t }}
                (<span data-ajax-cart-bind="item_count">{{ cart.item_count }}</span>)
            </a>
            <form action="{{ routes.cart_url }}" method="post">
                <button type="submit" name="checkout" class="btn">{{ 'sections.cart.checkout' | t }}</button>
            </form>
        </div>
        <button type="button" class="btn btn--link small" data-dialog-close>
            {{- 'sections.cart.continue_shopping' | t -}}
        </button>
    </div>
</dialog>

<script type="application/json" data-ajax-cart-initial-state>
    {{ cart | json }}
</script>

{% stylesheet %}
    @layer components {
        .cart-drawer__body {
            display: flex;
            flex-direction: column;
            gap: var(--space-l);
        }

        .cart-extras__summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            list-style: none;
        }

        .cart-extras__summary::-webkit-details-marker {
            display: none;
        }

        .cart-extras[open] .svg-icon--chevron-down {
            rotate: 180deg;
        }

        .cart-extras__content {
            padding-top: var(--space-s);
        }

        .cart-added__inner {
            padding: var(--space-l);
        }

        .cart-added__head {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .cart-added__item {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: var(--space-m);
            align-items: center;
        }

        .cart-added__image {
            width: 8rem;
            height: 8rem;
            object-fit: cover;
            border-radius: var(--radius-media);
        }

        .cart-added__actions > * {
            flex: 1;
        }

        .cart-added__actions .btn {
            width: 100%;
        }
    }
{% endstylesheet %}

{% schema %}
{
    "name": "Cart drawer",
    "class": "cart-drawer-section",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color scheme",
            "default": "scheme-1"
        },
        {
            "type": "paragraph",
            "content": "Upsell products, cart note and the free-shipping bar are set in Theme settings > Cart. Add blocks below to collect order details (cart attributes)."
        }
    ],
    "blocks": [
        {
            "type": "text",
            "name": "Text field",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Gift message" },
                { "type": "checkbox", "id": "required", "label": "Required", "default": false }
            ]
        },
        {
            "type": "select",
            "name": "Dropdown",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Delivery day" },
                {
                    "type": "text",
                    "id": "options",
                    "label": "Options",
                    "info": "Separate options with |",
                    "default": "Monday|Wednesday|Friday"
                }
            ]
        },
        {
            "type": "radio",
            "name": "Radio buttons",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Delivery time" },
                {
                    "type": "text",
                    "id": "options",
                    "label": "Options",
                    "info": "Separate options with |",
                    "default": "Morning|Afternoon|Evening"
                }
            ]
        },
        {
            "type": "checkbox",
            "name": "Checkbox",
            "settings": [
                { "type": "text", "id": "label", "label": "Label", "default": "Leave at the door" }
            ]
        }
    ]
}
{% endschema %}
