            { "value": "truck", "label": "t:sections.main_product.icon_truck" },
            { "value": "return", "label": "t:sections.main_product.icon_return" },
            { "value": "tag", "label": "t:sections.main_product.icon_tag" },
            { "value": "shield", "label": "t:sections.main_product.icon_shield" },
            { "value": "gift", "label": "t:sections.main_product.icon_gift" },
            { "value": "leaf", "label": "t:sections.main_product.icon_leaf" },
            { "value": "chat", "label": "t:sections.main_product.icon_chat" }
          ], "default": "truck" },
        { "type": "page", "id": "page_1", "label": "t:sections.main_product.info_page" },
        { "type": "header", "content": "t:sections.main_product.info_link_2" },
        { "type": "text", "id": "label_2", "label": "t:labels.label", "default": "Returns" },
        { "type": "select", "id": "icon_2", "label": "t:sections.main_product.icon", "options": [
            { "value": "truck", "label": "t:sections.main_product.icon_truck" },
            { "value": "return", "label": "t:sections.main_product.icon_return" },
            { "value": "tag", "label": "t:sections.main_product.icon_tag" },
            { "value": "shield", "label": "t:sections.main_product.icon_shield" },
            { "value": "gift", "label": "t:sections.main_product.icon_gift" },
            { "value": "leaf", "label": "t:sections.main_product.icon_leaf" },
            { "value": "chat", "label": "t:sections.main_product.icon_chat" }
          ], "default": "return" },
        { "type": "page", "id": "page_2", "label": "t:sections.main_product.info_page" },
        { "type": "header", "content": "t:sections.main_product.info_link_3" },
        { "type": "text", "id": "label_3", "label": "t:labels.label" },
        { "type": "select", "id": "icon_3", "label": "t:sections.main_product.icon", "options": [
            { "value": "truck", "label": "t:sections.main_product.icon_truck" },
            { "value": "return", "label": "t:sections.main_product.icon_return" },
            { "value": "tag", "label": "t:sections.main_product.icon_tag" },
            { "value": "shield", "label": "t:sections.main_product.icon_shield" },
            { "value": "gift", "label": "t:sections.main_product.icon_gift" },
            { "value": "leaf", "label": "t:sections.main_product.icon_leaf" },
            { "value": "chat", "label": "t:sections.main_product.icon_chat" }
          ], "default": "tag" },
        { "type": "page", "id": "page_3", "label": "t:sections.main_product.info_page" },
        { "type": "header", "content": "t:sections.main_product.ask_header" },
        { "type": "checkbox", "id": "show_ask", "label": "t:sections.main_product.show_ask", "info": "t:sections.main_product.show_ask_info", "default": true }
      ]
    },
    { "type": "pickup", "name": "t:sections.main_product.block_pickup", "limit": 1 },
    { "type": "meta", "name": "t:sections.main_product.block_meta", "limit": 1 },
    { "type": "share", "name": "t:sections.main_product.block_share", "limit": 1 }
  ]
}
{% endschema %}
