  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "t:settings.typography.heading_font",
        "default": "bricolage_grotesque_n7"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "t:settings.typography.heading_scale",
        "min": 80,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings.typography.body_font",
        "default": "dm_sans_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "t:settings.typography.body_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "t:settings.layout.page_width",
        "min": 1000,
        "max": 1920,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "header",
        "content": "t:settings.layout.radius"
      },
      {
        "type": "range",
        "id": "radius_button",
        "label": "t:settings.layout.radius_button",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "radius_input",
        "label": "t:settings.layout.radius_input",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "radius_card",
        "label": "t:settings.layout.radius_card",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "radius_media",
        "label": "t:settings.layout.radius_media",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "radius_badge",
        "label": "t:settings.layout.radius_badge",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      }
    ]
  },
  {
    "name": "t:settings.cards.name",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "t:settings.cards.image_ratio",
        "options": [
          { "value": "1", "label": "t:settings.cards.ratio_square" },
          { "value": "0.8", "label": "t:settings.cards.ratio_portrait" },
          { "value": "1.333", "label": "t:settings.cards.ratio_landscape" },
          { "value": "natural", "label": "t:settings.cards.ratio_natural" }
        ],
        "default": "1"
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "t:settings.cards.image_fit",
        "options": [
          { "value": "cover", "label": "t:settings.cards.fit_cover" },
          { "value": "contain", "label": "t:settings.cards.fit_contain" }
        ],
        "default": "cover"
      },
      { "type": "checkbox", "id": "card_secondary_image", "label": "t:settings.cards.secondary_image", "default": true },
      { "type": "header", "content": "t:settings.cards.info_header" },
      { "type": "checkbox", "id": "card_show_label", "label": "t:settings.cards.show_label", "info": "t:settings.cards.show_label_info", "default": true },
      { "type": "checkbox", "id": "card_show_vendor", "label": "t:settings.cards.show_vendor", "default": false },
      { "type": "checkbox", "id": "card_show_rating", "label": "t:settings.cards.show_rating", "info": "t:settings.cards.show_rating_info", "default": true },
      { "type": "checkbox", "id": "card_show_options", "label": "t:settings.cards.show_options", "info": "t:settings.cards.show_options_info", "default": true },
      { "type": "checkbox", "id": "card_show_timer", "label": "t:settings.cards.show_timer", "info": "t:settings.cards.show_timer_info", "default": true }
    ]
  },
  {
    "name": "t:settings.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart.cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:settings.cart.cart_type_drawer"
          },
          {
            "value": "notification",
            "label": "t:settings.cart.cart_type_notification"
          },
          {
            "value": "page",
            "label": "t:settings.cart.cart_type_page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "header",
        "content": "t:settings.cart.free_shipping"
      },
      {
        "type": "checkbox",
        "id": "show_free_shipping",
        "label": "t:settings.cart.show_free_shipping",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:settings.cart.free_shipping_threshold",
        "info": "t:settings.cart.free_shipping_threshold_info",
        "default": 100
      },
      {
        "type": "header",
        "content": "t:settings.cart.upsell"
      },
      {
        "type": "checkbox",
        "id": "show_upsell",
        "label": "t:settings.cart.show_upsell",
        "default": true
      },
      {
        "type": "product_list",
        "id": "upsell_products",
        "label": "t:settings.cart.upsell_products",
        "info": "t:settings.cart.upsell_products_info",
        "limit": 6
      },
      {
        "type": "header",
        "content": "t:settings.cart.recommendations"
      },
      {
        "type": "checkbox",
        "id": "show_cart_recommendations",
        "label": "t:settings.cart.show_cart_recommendations",
        "info": "t:settings.cart.show_cart_recommendations_info",
        "default": true
      },
      {
        "type": "header",
        "content": "t:settings.cart.order_details"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "t:settings.cart.show_cart_note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart_discount",
        "label": "t:settings.cart.show_cart_discount",
        "info": "t:settings.cart.show_cart_discount_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart_sku",
        "label": "t:settings.cart.show_cart_sku",
        "default": false
      }
    ]
  },
