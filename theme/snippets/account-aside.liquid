{% doc %}
  The side panel of the login and register pages: why to have an account — a heading and up to three
  benefits with icons, over an optional image. Styles: .account-aside in packages/ui/css/account.css.

  @param {object} aside - The section's settings (aside_heading, benefit_1–3, aside_image)
{% enddoc %}
{%- liquid
  assign icons = 'bag,heart,gift' | split: ','
-%}
<aside class="account-aside">
  {%- if aside.aside_image -%}
    {{ aside.aside_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'account-aside__image', sizes: '(min-width: 990px) 40vw, 100vw', widths: '600, 900, 1200', alt: '' }}
  {%- endif -%}
  <div class="account-aside__body">
    {%- if aside.aside_heading != blank -%}
      <h2 class="h4">{{ aside.aside_heading | escape }}</h2>
    {%- endif -%}
    <ul class="account-aside__list" role="list">
      {%- for n in (1..3) -%}
        {%- assign key = 'benefit_' | append: n -%}
        {%- if aside[key] != blank -%}
          <li class="account-aside__item">
            <span class="account-aside__icon" aria-hidden="true">{%- render 'icon', name: icons[forloop.index0] -%}</span>
            <span>{{ aside[key] | escape }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</aside>
